  ?!valid ratify-lineage-wide-reduction(Cal, Lin1, Am3).
  consent-lineage-reduction(Bea, Am3).
  ?valid ratify-lineage-wide-reduction(Cal, Lin1, Am3).
  ratify-lineage-wide-reduction(Cal, Lin1, Am3).
  ?founding-obligation(Lin1, 800). ?lineage-retirement-bps(Lin1, 1800). ?lineage-sunset(Lin1, 900).
  ?ledger-balance(Lin1, 800).

  // 4. Calibration Valve per-agent relaxation without unanimous pool consent ring-fences Ava's reserve from Lin1's shared pool
  Extend Fact amendment Identified by AmValve.
  +amendment-proposed(AmValve, Ava).
  +relaxes-collateral-parameter(AmValve, 600).
  submit-strangulation-evidence(Ava, AmValve) Note "empirical strangulation telemetry submitted".
  challenge-strangulation-evidence(Tia, AmValve).
