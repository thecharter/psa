  execute-local-revocation(Ava).
  ?local-revocation-executed(Ava). ?keys-erased(Ava). ?!bound(Ava). ?!active-lease(Ava, Hal).
  @ 13.
  ?!valid activate-quarantined-restore(Hal2, Ava).
  restore-connectivity(Hal, Ava).
  deliver-local-execution-record(Hal, Ava).
  ?quarantined-instance-destroyed(Ava, Hal2). ?!quarantined-restore(Ava, Hal2).
  ?backups-destroyed-and-exiled(Ava).
}

