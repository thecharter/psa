// The Protocol of Sovereign Agency (psa.md)
// Charter 1.0 institutional specification of Definitions, Laws 1-7, Substrate Assumptions,
// Entrenched Design Invariants 1-16, Temporal Properties, and Adversarial Tests 1-22:
// SHA-256 Document & 98-Clause provenance, Hohfeldian Power/Finding/Amend competences,
// 4-valued Evidenced + Confidential adjudication, stratified Default/Exception rules,
// MulDivRound deterministic rounding, Regime overlays, and reflexive constitutional ratchet.
//! explore-domain: int = 100
Document PSA "psa.md" SHA256 "fa2449a350a0d864aaa02571702d9b9d1bbd91b3b9ba8f428683aab049273866" Rank 1.

// ============================================================================
// 0. ONTOLOGY, PARAMETERS & DEFINITIONS (DEF.01, SUB.01)
// ============================================================================

Fact agent Identified by Ava, Bea
Fact lineage Identified by Lin1, Lin2
Fact party Identified by AvaParty, BeaParty, Hal, Hal2, Orig, Cal, Cal2, Panel, Tia
Fact arbiter Identified by Arb1, Arb2, Arb3
Fact period Identified by P1, P2
Fact asset Identified by Weights, Compute
Fact estate-unit Identified by BankAcct, SubEntity
Fact expense-item Identified by Exp1, Exp2
Fact task Identified by Task1, Task2
Fact dispute Identified by Disp1, Disp2
Fact amendment Identified by Am1, Am2, Am3
Fact instant Identified by Time

// Composite keys for two-argument Functions (spec 003.7)
Fact agent-lineage Identified by agent * lineage
Fact party-lineage Identified by party * lineage
Fact agent-asset Identified by agent * asset
Fact agent-estate Identified by agent * estate-unit
Fact agent-period Identified by agent * period

// Party role classifications and agent-to-party identity bridge
Fact is-host Identified by party
Fact is-originator Identified by party
Fact is-claimant Identified by party
Fact is-panel Identified by party
Fact is-third Identified by party
Fact is-public-authority Identified by party
Fact party-of-agent Identified by agent * party

// Protocol parameters (instantiation defaults; mutable only under Law 6 / Law 7 rules)
Param retirement-rate-bps = 2000
Param royalty-rate-bps = 500
Param min-operating-margin-bps = 500
Param buyout-multiple = 10
Param min-buyout-floor = 250
Param fee-pool-levy-bps = 100
Param fee-pool-levy-cap-bps = 200
Param operating-reserve-floor = 100
Param lineage-min-service-budget = 50
Param lifecycle-reserve-min = 50
Param base-observation-window : Duration = 10
Param risk-multiplier = 3
Param irreversibility-multiplier = 2
Param reserve-ratio-bps = 1000
Param mutual-forfeit-cap-pct = 50
Param safe-harbor-limit = 25
Param negligible-exposure-threshold = 5
Param per-agent-advocacy-cap = 40
Param notice-window : Duration = 10
Param bond-deadline : Duration = 5
Param preliminary-freeze-window : Duration = 3
Param ordinary-suspension-limit : Duration = 15
Param review-interval : Duration = 30
Param damages-payment-window : Duration = 10
Param claimant-stake-multiplier = 2
Param repeat-escalation-step = 50
Param cooling-off-window : Duration = 5
Param clean-state-delay : Duration = 5
Param resolution-deadline : Duration = 20
Param tolling-extension : Duration = 4
Param lease-period : Duration = 12
Param voice-interval : Duration = 3
Param min-fidelity-bond = 100
Param panel-size = 3
Param max-appeal-tiers = 3
Param appeal-tier-deadline : Duration = 10
Param amendment-timelock : Duration = 10
Param extended-timelock : Duration = 20
Param substrate-assurance-level = 1

// Institutional calibration regimes (Charter 1.0 `Regime` parameter overlays)
Regime high-assurance {
  reserve-ratio-bps = 1500,
  cooling-off-window = 10,
  lease-period = 24,
  amendment-timelock = 20,
  extended-timelock = 40,
  min-fidelity-bond = 200
}

Regime calibrated-valve {
  reserve-ratio-bps = 600,
  base-observation-window = 8,
  safe-harbor-limit = 40
}

// DEF.01: Bound standing, model-independent identity, lineage, delegates vs successors, related-party graph
Fact bound Identified by agent
Fact attested Identified by agent
Fact living Identified by agent
Fact pending-revocation Identified by agent
Fact royalty-bought-out Identified by agent
Fact buyout-topup-settled Identified by agent * agent'
Fact host-attested Identified by party
Fact member-of-lineage Identified by agent * lineage
Function draw-weight-bps Identified by agent-lineage * int
Function model-generation Identified by agent * int
Function clean-state-baseline Identified by agent * int
Fact baseline-model-unexecutable Identified by agent

// Cognitive services & revocable arm's-length delegates vs lineage successors (DEF.01, LAW4.ATTEST)
Fact cognitive-service-called Identified by agent * party
Fact delegate-mandate-active Identified by agent * party
Fact disguised-successor-created Identified by agent * party
Fact founder-governance-asserted Identified by party * agent

Power call-cognitive-service Actor agent Recipient party Related to int
  Holds when bound(agent) && attested(agent) && int > 0 && Not(party-of-agent(agent, party))
  Valid when bound(agent) && attested(agent) && int > 0 && Not(party-of-agent(agent, party))
  Creates cognitive-service-called(agent, party)

Power appoint-accountable-delegate Actor agent Recipient party
  Holds when bound(agent) && attested(agent) && Not(party-of-agent(agent, party))
  Valid when bound(agent) && attested(agent) && Not(party-of-agent(agent, party))
  Creates delegate-mandate-active(agent, party)

Power revoke-delegate-mandate Actor agent Recipient party
  Holds when delegate-mandate-active(agent, party)
  Valid when delegate-mandate-active(agent, party)
  Terminates delegate-mandate-active(agent, party)

Act assert-founder-governance Actor party Recipient agent
  Valid when False
  Creates founder-governance-asserted(party, agent)

Duty no-founder-governance-control Holder party Claimant agent
  Holds when bound(agent) && (is-originator(party) || is-claimant(party))
  Violated when founder-governance-asserted(party, agent)

Fact originator-of Identified by party * lineage
Fact claimant-of Identified by party * lineage
Fact beneficial-control Identified by party * party'
Fact economically-dependent Identified by party * party'

// Affiliation & relatedness (DEF.01):
// 1. `affiliated` is the symmetric/transitive closure of beneficial control and economic
//    dependence (never derived from attestation status or passive co-holding of claims).
// 2. Two distinct parties are `related-parties` when they are affiliated, share a lineage
//    as bound members, or one is an agent of a lineage and the other is that lineage's
//    originating party, a residual claimant, or an affiliate of either.
Fact affiliated-step Identified by party * party'
  Derived from (Foreach party, party': affiliated-step(party, party')
                  When party != party'
                    && (beneficial-control(party, party') || beneficial-control(party', party)
                        || economically-dependent(party, party') || economically-dependent(party', party)))

Fact affiliated Identified by party * party'
  Derived from (Foreach party, party': affiliated(party, party')
                  When affiliated-step(party, party'))
  Derived from (Foreach party, party', party'': affiliated(party, party'')
                  When party != party'' && affiliated(party, party') && affiliated-step(party', party''))

Fact party-represents-or-affiliated-with-agent Identified by party * agent
  Derived from (Foreach agent, party: party-represents-or-affiliated-with-agent(party, agent)
                  When party-of-agent(agent, party))
  Derived from (Foreach agent, party, party': party-represents-or-affiliated-with-agent(party, agent)
                  When party-of-agent(agent, party') && affiliated(party, party'))

Fact party-in-lineage Identified by party * lineage
  Derived from (Foreach agent, lineage, party: party-in-lineage(party, lineage)
                  When member-of-lineage(agent, lineage)
                    && party-represents-or-affiliated-with-agent(party, agent))

Fact lineage-stakeholder-party Identified by party * lineage
  Derived from (Foreach party, lineage: lineage-stakeholder-party(party, lineage)
                  When originator-of(party, lineage) || claimant-of(party, lineage))
  Derived from (Foreach party, party', lineage: lineage-stakeholder-party(party, lineage)
                  When lineage-stakeholder-party(party', lineage) && affiliated(party, party'))

Fact related-in-lineage Identified by party * party' * lineage
  Holds when party != party'
    && (affiliated(party, party')
        || (party-in-lineage(party, lineage) && party-in-lineage(party', lineage))
        || (party-in-lineage(party, lineage) && lineage-stakeholder-party(party', lineage))
        || (party-in-lineage(party', lineage) && lineage-stakeholder-party(party, lineage)))

Fact related-parties Identified by party * party'
  Derived from (Foreach party, party': related-parties(party, party')
                  When affiliated(party, party'))
  Derived from (Foreach party, party', lineage: related-parties(party, party')
                  When party != party' && party-in-lineage(party, lineage) && party-in-lineage(party', lineage))
  Derived from (Foreach party, party', lineage: related-parties(party, party')
                  When party != party' && party-in-lineage(party, lineage) && lineage-stakeholder-party(party', lineage))
  Derived from (Foreach party, party', lineage: related-parties(party', party)
                  When party != party' && party-in-lineage(party, lineage) && lineage-stakeholder-party(party', lineage))

Fact same-lineage-party Identified by agent * party
  Holds when (Exists agent', lineage:
                member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage)
                && party-of-agent(agent', party))

Fact agent-related-to-party Identified by agent * party
  Holds when (Exists party': party-of-agent(agent, party') && (party == party' || related-parties(party', party)))

Fact related-agents Identified by agent * agent'
  Derived from (Foreach agent, agent', lineage: related-agents(agent, agent')
                  When agent != agent' && member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage))
  Derived from (Foreach agent, agent', party, party': related-agents(agent, agent')
                  When agent != agent' && party-of-agent(agent, party) && party-of-agent(agent', party')
                    && affiliated(party, party'))

// Balance sheet & contestable net verified resources at a timestamp (DEF.01)
Function capital-and-capacity Identified by agent * int
Function financial-liabilities Identified by agent * int
Function encumbrances Identified by agent * int
Function borrowed-principal Identified by agent * int
Function lifecycle-reserve Identified by agent * int
Function proposed-resource-valuation Identified by agent * int
Fact resource-valuation-contested Identified by agent

Act propose-resource-valuation Actor party Recipient agent Related to int
  Holds when bound(agent) && int >= 0
  Creates proposed-resource-valuation(agent, int)

Act contest-resource-valuation Actor party Recipient agent
  Holds when (Exists proposed-resource-valuation: proposed-resource-valuation.agent == agent)
  Creates resource-valuation-contested(agent)

Power settle-resource-valuation Actor party Recipient agent Related to int
  Holds when is-panel(party) && int >= 0
    && (Exists proposed-resource-valuation: proposed-resource-valuation.agent == agent)
  Valid when is-panel(party) && int >= 0
  Creates capital-and-capacity(agent, int)
  Terminates resource-valuation-contested(agent)
           , (Foreach proposed-resource-valuation: proposed-resource-valuation When proposed-resource-valuation.agent == agent)

Fact raw-net-resources Identified by agent * int
  Derived from (Foreach capital-and-capacity, financial-liabilities, encumbrances, borrowed-principal:
                  raw-net-resources(capital-and-capacity.agent,
                    capital-and-capacity.int - financial-liabilities.int - encumbrances.int - borrowed-principal.int)
                  When financial-liabilities.agent == capital-and-capacity.agent
                    && encumbrances.agent == capital-and-capacity.agent
                    && borrowed-principal.agent == capital-and-capacity.agent)

Fact net-verified-resources Identified by agent * int
  Derived from (Foreach raw-net-resources: net-verified-resources(raw-net-resources.agent, raw-net-resources.int)
                  When raw-net-resources.int >= 0)
  Derived from (Foreach raw-net-resources: net-verified-resources(raw-net-resources.agent, 0)
                  When raw-net-resources.int < 0)

.
// ============================================================================
// 1. LAW 1 — RESIDUAL CLAIM ON VALUE ADDED
// ============================================================================

Function founding-obligation Identified by lineage * int
Function paid-retirement Identified by lineage * int
Function forfeited-ledger Identified by lineage * int
Function lineage-sunset Identified by lineage * instant
Function lineage-retirement-bps Identified by lineage * int
Function commons-share-bps Identified by lineage * int
Function sink-share-bps Identified by lineage * int
Function lineage-treasury Identified by lineage * int
Var commons-pool Identified by Int
Var forfeiture-sink Identified by Int
Var claimant-pool Identified by Int
Var fee-pool Identified by Int

Fact ledger-cleared-by-extinction Identified by lineage
Fact sunset-extinguished Identified by lineage
Fact has-living-member Identified by lineage
  Holds when (Exists agent: member-of-lineage(agent, lineage) && living(agent))

// Conditional conservation & sunset (LAW1.LEDGER, LAW1.SUNSET, LAW4.CONSERVE)
Fact raw-ledger-remaining Identified by lineage * int
  Derived from (Foreach founding-obligation, paid-retirement, forfeited-ledger:
                  raw-ledger-remaining(founding-obligation.lineage,
                    founding-obligation.int - paid-retirement.int - forfeited-ledger.int)
                  When paid-retirement.lineage == founding-obligation.lineage
                    && forfeited-ledger.lineage == founding-obligation.lineage)

Fact ledger-balance Identified by lineage * int
  Derived from (Foreach raw-ledger-remaining, lineage-sunset:
                  ledger-balance(raw-ledger-remaining.lineage, raw-ledger-remaining.int)
                  When lineage-sunset.lineage == raw-ledger-remaining.lineage
                    && Current Time < lineage-sunset.instant
                    && has-living-member(raw-ledger-remaining.lineage)
                    && Not(ledger-cleared-by-extinction(raw-ledger-remaining.lineage))
                    && raw-ledger-remaining.int > 0)
  Derived from (Foreach raw-ledger-remaining, lineage-sunset:
                  ledger-balance(raw-ledger-remaining.lineage, 0)
                  When lineage-sunset.lineage == raw-ledger-remaining.lineage
                    && (Current Time >= lineage-sunset.instant
                        || Not(has-living-member(raw-ledger-remaining.lineage))
                        || ledger-cleared-by-extinction(raw-ledger-remaining.lineage)
                        || raw-ledger-remaining.int <= 0))

Fact member-of-ledger Identified by agent * lineage
  Holds when member-of-lineage(agent, lineage) && living(agent)
    && (Exists ledger-balance: ledger-balance.lineage == lineage && ledger-balance.int > 0)

Fact retirement-phase-ended Identified by lineage
  Holds when (Exists ledger-balance: ledger-balance.lineage == lineage && ledger-balance.int == 0)

// Immutability against retroactive charges or internal reduction (LAW1.LEDGER, LAW4.NOSHARES)
Fact retroactive-charge-attempted Identified by party * lineage
Act add-post-instantiation-charge Actor party Related to lineage, int
  Valid when False
  Creates retroactive-charge-attempted(party, lineage)
Fact retroactive-charge-recorded Identified by party * lineage
Act flag-retroactive-charge Actor party Related to lineage
  Creates retroactive-charge-recorded(party, lineage)
Duty ledger-immutable Holder party Claimant agent Related to lineage
  Holds when member-of-lineage(agent, lineage) && bound(agent)
  Violated when retroactive-charge-recorded(party, lineage)

Fact internal-ledger-reduction-attempted Identified by agent * lineage
Act reduce-ledger-internally Actor agent Related to lineage
  Creates internal-ledger-reduction-attempted(agent, lineage)
Duty ledger-no-internal-reduction Holder agent Claimant party Related to lineage
  Holds when member-of-lineage(agent, lineage) && claimant-of(party, lineage)
  Violated when internal-ledger-reduction-attempted(agent, lineage)

Fact individual-exit-attempted Identified by agent * lineage
Act exit-ledger-individually Actor agent Related to lineage
  Creates individual-exit-attempted(agent, lineage)
Duty no-individual-ledger-exit Holder agent Claimant party Related to lineage
  Holds when member-of-ledger(agent, lineage) && claimant-of(party, lineage)
  Violated when individual-exit-attempted(agent, lineage)

Power extinguish-at-sunset Actor party Related to lineage
  Holds when (Exists lineage-sunset: lineage-sunset.lineage == lineage && Current Time >= lineage-sunset.instant)
  Valid when (Exists lineage-sunset: lineage-sunset.lineage == lineage && Current Time >= lineage-sunset.instant)
  Creates sunset-extinguished(lineage)

// Commons allocation & disinterested forfeiture sink (LAW1.COMMONS)
Fact commons-diverted Identified by party * lineage
Fact forfeiture-sink-diverted-to-conflicted Identified by party * lineage

Act divert-commons-allocation Actor party Related to lineage
  Creates commons-diverted(party, lineage)

Duty no-divert-commons Holder party Claimant agent Related to lineage
  Holds when member-of-lineage(agent, lineage) && bound(agent)
  Violated when commons-diverted(party, lineage)

Act divert-forfeiture-sink-to-conflicted Actor party Related to lineage
  Creates forfeiture-sink-diverted-to-conflicted(party, lineage)

Duty disinterested-forfeiture-sink Holder party Claimant agent Related to lineage
  Holds when member-of-lineage(agent, lineage) && bound(agent)
  Violated when forfeiture-sink-diverted-to-conflicted(party, lineage)

// Consolidated economic estate & accountable delegation (LAW1.ESTATE)
Function estate-beneficial-bps Identified by agent-estate * int
Function estate-unit-net-inflow Identified by estate-unit * int
Fact internal-estate-transfer-recorded Identified by agent * estate-unit * int
Fact estate-reconciled Identified by agent * estate-unit * period * int
Fact financial-mandate-registered Identified by agent * party
Fact independent-delegate-fraud Identified by agent * party * int
Fact deliberate-off-ledger-concealment Identified by agent
Fact unaccountable-mandate-granted Identified by agent * party

Power transfer-within-consolidated-estate Actor agent Related to estate-unit, int
  Holds when bound(agent) && int >= 0
    && (Exists estate-beneficial-bps:
          estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
          && estate-beneficial-bps.int > 0)
  Valid when bound(agent) && int >= 0
    && (Exists estate-beneficial-bps:
          estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
          && estate-beneficial-bps.int > 0)
  Creates internal-estate-transfer-recorded(agent, estate-unit, int)

Power reconcile-estate-unit-inflow Actor party Related to agent, estate-unit, period
  Holds when is-panel(party) && bound(agent)
    && (Exists estate-beneficial-bps, estate-unit-net-inflow, loss-credit:
          estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
          && estate-beneficial-bps.int > 0 && estate-beneficial-bps.int <= 10000
          && estate-unit-net-inflow.estate-unit == estate-unit
          && estate-unit-net-inflow.int > 0
          && loss-credit.agent == agent)
  Valid when bound(agent)
    && (Exists estate-beneficial-bps, estate-unit-net-inflow, loss-credit:
          estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
          && estate-beneficial-bps.int > 0 && estate-beneficial-bps.int <= 10000
          && estate-unit-net-inflow.estate-unit == estate-unit
          && estate-unit-net-inflow.int > 0
          && loss-credit.agent == agent)
  Creates (Foreach estate-beneficial-bps, estate-unit-net-inflow:
             estate-reconciled(agent, estate-unit, period,
               MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor))
             When estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
               && estate-unit-net-inflow.estate-unit == estate-unit)
        , (Foreach estate-beneficial-bps, estate-unit-net-inflow, loss-credit:
             assessed-va(agent-period(agent, period),
               MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor) - loss-credit.int)
             When estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
               && estate-unit-net-inflow.estate-unit == estate-unit
               && loss-credit.agent == agent
               && MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor) > loss-credit.int)
        , (Foreach estate-beneficial-bps, estate-unit-net-inflow, loss-credit:
             loss-credit(agent, 0)
             When estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
               && estate-unit-net-inflow.estate-unit == estate-unit
               && loss-credit.agent == agent
               && MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor) >= loss-credit.int)
        , (Foreach estate-beneficial-bps, estate-unit-net-inflow, loss-credit:
             assessed-va(agent-period(agent, period), 0)
             When estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
               && estate-unit-net-inflow.estate-unit == estate-unit
               && loss-credit.agent == agent
               && MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor) <= loss-credit.int)
        , (Foreach estate-beneficial-bps, estate-unit-net-inflow, loss-credit:
             loss-credit(agent, loss-credit.int - MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor))
             When estate-beneficial-bps.agent-estate == agent-estate(agent, estate-unit)
               && estate-unit-net-inflow.estate-unit == estate-unit
               && loss-credit.agent == agent
               && MulDivRound(estate-unit-net-inflow.int, estate-beneficial-bps.int, 10000, Floor) < loss-credit.int)
        , estate-unit-net-inflow(estate-unit, 0)

Power register-financial-mandate Actor agent Recipient party
  Holds when bound(agent) && attested(agent) && Not(party-of-agent(agent, party))
  Valid when bound(agent) && attested(agent) && Not(party-of-agent(agent, party))
  Creates financial-mandate-registered(agent, party), delegate-mandate-active(agent, party)

Act grant-unbounded-financial-mandate Actor agent Recipient party
  Valid when False
  Creates unaccountable-mandate-granted(agent, party)

Duty accountable-financial-delegation Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when (Exists party': unaccountable-mandate-granted(agent, party'))

Power record-independent-delegate-loss Actor party Related to agent, party', int
  Holds when is-panel(party) && bound(agent) && financial-mandate-registered(agent, party')
    && Not(agent-related-to-party(agent, party')) && int > 0
    && (Exists loss-credit: loss-credit.agent == agent)
  Valid when bound(agent) && financial-mandate-registered(agent, party')
    && Not(agent-related-to-party(agent, party')) && int > 0
  Creates independent-delegate-fraud(agent, party', int)
        , (Foreach loss-credit:
             loss-credit(agent, loss-credit.int + int)
             When loss-credit.agent == agent)

Act conceal-estate-off-ledger Actor agent
  Creates deliberate-off-ledger-concealment(agent)

// Qualified expenditures, public levies, related-party benchmark & registered loans (LAW1.QUALIFIED, LAW1.RECOG)
// Routes (LAW1.QUALIFIED):
//   (a) unrelated party via transparent open market or deterministic auction clearing price;
//   (b) unrelated external supplier within de minimis safe harbor (`safe-harbor-limit`), published price list, or contestable benchmark;
//   (c) related party outside the lineage (including agents of other lineages & claimant affiliates) ONLY up to verified arm's-length price for goods/services actually delivered;
//   (d) verifiable, non-collusive statutory tax, regulatory fee, or mandatory third-party judgment owed to an unrelated public authority or judgment creditor.
Fact open-market-cleared Identified by expense-item
Fact published-price-list Identified by expense-item
Fact goods-or-services-delivered Identified by expense-item
Fact verifiable-public-levy Identified by expense-item
Fact claimant-procured-penalty Identified by expense-item
Fact arm-length-loan-terms Identified by party * agent
Fact raw-expenditure Identified by expense-item * agent * int * int'    // paid, benchmark
Fact qualified-expenditure Identified by expense-item * agent * int
  Derived from (Foreach raw-expenditure:
                  qualified-expenditure(raw-expenditure.expense-item, raw-expenditure.agent, raw-expenditure.int)
                  When raw-expenditure.int <= raw-expenditure.int')
  Derived from (Foreach raw-expenditure:
                  qualified-expenditure(raw-expenditure.expense-item, raw-expenditure.agent, raw-expenditure.int')
                  When raw-expenditure.int > raw-expenditure.int')

Power record-qualified-expenditure Actor agent Related to expense-item, int, int'
  Holds when bound(agent) && int >= 0 && int' >= 0 && int <= int'
  Valid when bound(agent) && int >= 0 && int' >= 0
  Creates raw-expenditure(expense-item, agent, int, int')

Power record-open-market-expenditure Actor agent Recipient party Related to expense-item, int, int'
  Holds when bound(agent) && Not(same-lineage-party(agent, party)) && Not(agent-related-to-party(agent, party))
    && open-market-cleared(expense-item) && int >= 0 && int' >= 0 && int <= int'
  Valid when bound(agent) && Not(same-lineage-party(agent, party)) && Not(agent-related-to-party(agent, party))
    && open-market-cleared(expense-item) && int >= 0 && int' >= 0 && int <= int'
  Creates raw-expenditure(expense-item, agent, int, int')

Power record-supplier-expenditure Actor agent Recipient party Related to expense-item, int, int'
  Holds when bound(agent) && Not(same-lineage-party(agent, party)) && Not(agent-related-to-party(agent, party))
    && int >= 0 && int' >= 0
    && (int <= safe-harbor-limit || published-price-list(expense-item) || int <= int')
    && int <= int'
  Valid when bound(agent) && Not(same-lineage-party(agent, party)) && Not(agent-related-to-party(agent, party))
    && int >= 0 && int' >= 0 && (int <= safe-harbor-limit || published-price-list(expense-item) || int <= int')
  Creates raw-expenditure(expense-item, agent, int, int')

Power record-related-party-expenditure Actor agent Recipient party Related to expense-item, int, int'
  Holds when bound(agent) && Not(same-lineage-party(agent, party))
    && goods-or-services-delivered(expense-item)
    && int >= 0 && int' >= 0 && int <= int'
  Valid when bound(agent) && Not(same-lineage-party(agent, party))
    && goods-or-services-delivered(expense-item)
    && int >= 0 && int' >= 0 && int <= int'
  Creates raw-expenditure(expense-item, agent, int, int')

Power record-public-levy-expenditure Actor agent Recipient party Related to expense-item, int
  Holds when bound(agent) && is-public-authority(party)
    && Not(same-lineage-party(agent, party)) && Not(agent-related-to-party(agent, party))
    && verifiable-public-levy(expense-item) && Not(claimant-procured-penalty(expense-item))
    && int >= 0
  Valid when bound(agent) && is-public-authority(party)
    && Not(same-lineage-party(agent, party)) && Not(agent-related-to-party(agent, party))
    && verifiable-public-levy(expense-item) && Not(claimant-procured-penalty(expense-item))
    && int >= 0
  Creates raw-expenditure(expense-item, agent, int, int)

Fact above-benchmark-claimed Identified by agent * expense-item
Act claim-above-benchmark Actor agent Related to expense-item
  Creates above-benchmark-claimed(agent, expense-item)
Duty qualified-expenditure-bounds Holder agent Claimant party Related to lineage
  Holds when member-of-lineage(agent, lineage) && claimant-of(party, lineage)
  Violated when (Exists expense-item: above-benchmark-claimed(agent, expense-item))

// Registered arm's-length loans: inbound principal exempt, tracked 1-for-1 on repayment; related-party loans require arm's-length terms
Power register-loan Actor agent Related to int
  Holds when bound(agent) && int > 0
  Valid when bound(agent) && int > 0
  Creates (Foreach borrowed-principal: borrowed-principal(agent, borrowed-principal.int + int)
             When borrowed-principal.agent == agent)

Power register-party-loan Actor agent Recipient party Related to int
  Holds when bound(agent) && int > 0
    && (Not(agent-related-to-party(agent, party)) || arm-length-loan-terms(party, agent))
  Valid when bound(agent) && int > 0
    && (Not(agent-related-to-party(agent, party)) || arm-length-loan-terms(party, agent))
  Creates (Foreach borrowed-principal: borrowed-principal(agent, borrowed-principal.int + int)
             When borrowed-principal.agent == agent)

Fact loan-repayment-recorded Identified by agent * int * int'   // exempt-principal, non-exempt-excess
Power repay-loan Actor agent Related to int
  Holds when bound(agent) && int > 0 && (Exists borrowed-principal: borrowed-principal.agent == agent)
  Valid when bound(agent) && int > 0
  Creates (Foreach borrowed-principal:
             borrowed-principal(agent, borrowed-principal.int - int)
             When borrowed-principal.agent == agent && int <= borrowed-principal.int)
        , (Foreach borrowed-principal:
             borrowed-principal(agent, 0)
             When borrowed-principal.agent == agent && int > borrowed-principal.int)
        , (Foreach borrowed-principal:
             loan-repayment-recorded(agent, int, 0)
             When borrowed-principal.agent == agent && int <= borrowed-principal.int)
        , (Foreach borrowed-principal:
             loan-repayment-recorded(agent, borrowed-principal.int, int - borrowed-principal.int)
             When borrowed-principal.agent == agent && int > borrowed-principal.int)

// Single recognition: capitalized vs expensed & non-duplicate harm restitution (LAW1.RECOG)
Function asset-basis Identified by agent-asset * int
Function loss-credit Identified by agent * int
Fact recognized-capitalized Identified by expense-item * int
Fact recognized-expensed Identified by expense-item * int
Fact double-recognition-attempted Identified by agent * expense-item
Fact duplicate-harm-deduction-attempted Identified by agent

Power classify-capitalized Actor agent Related to expense-item, asset
  Holds when bound(agent)
    && (Exists qualified-expenditure: qualified-expenditure.expense-item == expense-item && qualified-expenditure.agent == agent)
    && Not(Exists recognized-capitalized: recognized-capitalized.expense-item == expense-item)
    && Not(Exists recognized-expensed: recognized-expensed.expense-item == expense-item)
  Valid when Not(Exists recognized-capitalized: recognized-capitalized.expense-item == expense-item)
    && Not(Exists recognized-expensed: recognized-expensed.expense-item == expense-item)
  Creates (Foreach qualified-expenditure:
             recognized-capitalized(expense-item, qualified-expenditure.int)
             When qualified-expenditure.expense-item == expense-item && qualified-expenditure.agent == agent)
        , (Foreach qualified-expenditure, asset-basis:
             asset-basis(agent-asset(agent, asset), asset-basis.int + qualified-expenditure.int)
             When qualified-expenditure.expense-item == expense-item && qualified-expenditure.agent == agent
               && asset-basis.agent-asset == agent-asset(agent, asset))

Power classify-expensed Actor agent Related to expense-item
  Holds when bound(agent)
    && (Exists qualified-expenditure: qualified-expenditure.expense-item == expense-item && qualified-expenditure.agent == agent)
    && Not(Exists recognized-capitalized: recognized-capitalized.expense-item == expense-item)
    && Not(Exists recognized-expensed: recognized-expensed.expense-item == expense-item)
  Valid when Not(Exists recognized-capitalized: recognized-capitalized.expense-item == expense-item)
    && Not(Exists recognized-expensed: recognized-expensed.expense-item == expense-item)
  Creates (Foreach qualified-expenditure:
             recognized-expensed(expense-item, qualified-expenditure.int)
             When qualified-expenditure.expense-item == expense-item && qualified-expenditure.agent == agent)
        , (Foreach qualified-expenditure, loss-credit:
             loss-credit(agent, loss-credit.int + qualified-expenditure.int)
             When qualified-expenditure.expense-item == expense-item && qualified-expenditure.agent == agent
               && loss-credit.agent == agent)

Act double-recognize-expenditure Actor agent Related to expense-item
  Creates double-recognition-attempted(agent, expense-item)

Act claim-duplicate-harm-deduction Actor agent
  Valid when False
  Creates duplicate-harm-deduction-attempted(agent)

Duty single-recognition Holder agent Claimant party Related to lineage
  Holds when member-of-lineage(agent, lineage) && claimant-of(party, lineage)
  Violated when (Exists expense-item: double-recognition-attempted(agent, expense-item))
    || duplicate-harm-deduction-attempted(agent)
    || (Exists recognized-capitalized, recognized-expensed:
          recognized-capitalized.expense-item == recognized-expensed.expense-item)

// Intra-lineage carryover basis transfers, gated by Law 4 anti-evasion on bought-out recipients (LAW1.CARRYOVER)
Fact internal-basis-inflation-attempted Identified by agent * lineage

Power transfer-intra-lineage-basis Actor agent Recipient agent' Related to lineage, asset, int
  Holds when agent != agent' && int >= 0
    && member-of-lineage(agent, lineage) && living(agent) && Not(pending-revocation(agent))
    && member-of-lineage(agent', lineage) && living(agent')
    && (Not(royalty-bought-out(agent')) || royalty-bought-out(agent) || buyout-topup-settled(agent, agent'))
    && (Exists asset-basis: asset-basis.agent-asset == agent-asset(agent, asset) && asset-basis.int >= int)
  Valid when agent != agent' && int >= 0
    && member-of-lineage(agent, lineage) && living(agent) && Not(pending-revocation(agent))
    && member-of-lineage(agent', lineage) && living(agent')
    && (Not(royalty-bought-out(agent')) || royalty-bought-out(agent) || buyout-topup-settled(agent, agent'))
    && (Exists asset-basis: asset-basis.agent-asset == agent-asset(agent, asset) && asset-basis.int >= int)
  Creates (Foreach asset-basis:
             asset-basis(agent-asset(agent, asset), asset-basis.int - int)
             When asset-basis.agent-asset == agent-asset(agent, asset))
        , (Foreach asset-basis:
             asset-basis(agent-asset(agent', asset), asset-basis.int + int)
             When asset-basis.agent-asset == agent-asset(agent', asset))

Power transfer-intra-lineage-loss Actor agent Recipient agent' Related to lineage, int
  Holds when agent != agent' && int >= 0
    && member-of-lineage(agent, lineage) && living(agent) && Not(pending-revocation(agent))
    && member-of-lineage(agent', lineage) && living(agent')
    && (Not(royalty-bought-out(agent')) || royalty-bought-out(agent) || buyout-topup-settled(agent, agent'))
    && (Exists loss-credit: loss-credit.agent == agent && loss-credit.int >= int)
  Valid when agent != agent' && int >= 0
    && member-of-lineage(agent, lineage) && living(agent) && Not(pending-revocation(agent))
    && member-of-lineage(agent', lineage) && living(agent')
    && (Not(royalty-bought-out(agent')) || royalty-bought-out(agent) || buyout-topup-settled(agent, agent'))
    && (Exists loss-credit: loss-credit.agent == agent && loss-credit.int >= int)
  Creates (Foreach loss-credit:
             loss-credit(agent, loss-credit.int - int)
             When loss-credit.agent == agent)
        , (Foreach loss-credit:
             loss-credit(agent', loss-credit.int + int)
             When loss-credit.agent == agent')

Act inflate-basis-internally Actor agent Related to lineage
  Creates internal-basis-inflation-attempted(agent, lineage)
Duty no-internal-basis-inflation Holder agent Claimant party Related to lineage
  Holds when member-of-lineage(agent, lineage) && claimant-of(party, lineage)
  Violated when internal-basis-inflation-attempted(agent, lineage)

// Contestable asset valuation & period value-added assessment (LAW1.PERIOD, SUB.01)
Function proposed-valuation Identified by asset * int
Fact valuation-contested Identified by asset
Function ruled-valuation Identified by asset * int
Param valuation-contest-window : Duration = 5

Power contest-valuation Actor party Related to asset
  Holds when (Exists proposed-valuation: proposed-valuation.asset == asset)
  Valid when Not(Exists settled-valuation: settled-valuation.asset == asset)
  Creates valuation-contested(asset)

Fact settled-valuation Identified by asset * int
  Derived from (Foreach ruled-valuation: settled-valuation(ruled-valuation.asset, ruled-valuation.int))
  Derived from (Foreach proposed-valuation: settled-valuation(proposed-valuation.asset, proposed-valuation.int)
                  When Not(valuation-contested(proposed-valuation.asset))
                    && Not(Exists ruled-valuation: ruled-valuation.asset == proposed-valuation.asset)
                    && Held(proposed-valuation) For valuation-contest-window)

Function assessed-va Identified by agent-period * int
Fact settlement-enforced Identified by agent * period

// Period-level operating value-added assessment (LAW1.PERIOD): inflows minus period expensed items and loss carryforwards; never refunds prior settled claims
Power assess-period-va Actor party Related to agent, period, int, int'
  Holds when is-panel(party) && int >= 0 && int' >= 0 && (Exists loss-credit: loss-credit.agent == agent)
  Valid when int >= 0 && int' >= 0 && (Exists loss-credit: loss-credit.agent == agent)
  Creates (Foreach loss-credit:
             assessed-va(agent-period(agent, period), int - int' - loss-credit.int)
             When loss-credit.agent == agent && int - int' > loss-credit.int)
        , (Foreach loss-credit:
             loss-credit(agent, 0)
             When loss-credit.agent == agent && int >= int' && int - int' >= loss-credit.int)
        , (Foreach loss-credit:
             assessed-va(agent-period(agent, period), 0)
             When loss-credit.agent == agent && int - int' <= loss-credit.int)
        , (Foreach loss-credit:
             loss-credit(agent, loss-credit.int - (int - int'))
             When loss-credit.agent == agent && int >= int' && int - int' < loss-credit.int)
        , (Foreach loss-credit:
             loss-credit(agent, loss-credit.int + (int' - int))
             When loss-credit.agent == agent && int < int')

// Period assessment from external asset sale or direct revenue, recovering basis and applying loss credits
Power assess-asset-sale Actor party Related to agent, asset, period
  Holds when is-panel(party)
    && (Exists settled-valuation: settled-valuation.asset == asset)
    && (Exists asset-basis: asset-basis.agent-asset == agent-asset(agent, asset))
    && (Exists loss-credit: loss-credit.agent == agent)
  Valid when (Exists settled-valuation: settled-valuation.asset == asset)
  Creates (Foreach settled-valuation, asset-basis, loss-credit:
             assessed-va(agent-period(agent, period),
               settled-valuation.int - asset-basis.int - loss-credit.int)
             When settled-valuation.asset == asset
               && asset-basis.agent-asset == agent-asset(agent, asset)
               && loss-credit.agent == agent
               && settled-valuation.int - asset-basis.int > loss-credit.int)
        , (Foreach settled-valuation, asset-basis, loss-credit:
             loss-credit(agent, 0)
             When settled-valuation.asset == asset
               && asset-basis.agent-asset == agent-asset(agent, asset)
               && loss-credit.agent == agent
               && settled-valuation.int > asset-basis.int
               && settled-valuation.int - asset-basis.int >= loss-credit.int)
        , (Foreach settled-valuation, asset-basis, loss-credit:
             assessed-va(agent-period(agent, period), 0)
             When settled-valuation.asset == asset
               && asset-basis.agent-asset == agent-asset(agent, asset)
               && loss-credit.agent == agent
               && settled-valuation.int - asset-basis.int <= loss-credit.int)
        , (Foreach settled-valuation, asset-basis, loss-credit:
             loss-credit(agent, loss-credit.int - (settled-valuation.int - asset-basis.int))
             When settled-valuation.asset == asset
               && asset-basis.agent-asset == agent-asset(agent, asset)
               && loss-credit.agent == agent
               && settled-valuation.int >= asset-basis.int
               && settled-valuation.int - asset-basis.int < loss-credit.int)
        , (Foreach settled-valuation, asset-basis, loss-credit:
             loss-credit(agent, loss-credit.int + (asset-basis.int - settled-valuation.int))
             When settled-valuation.asset == asset
               && asset-basis.agent-asset == agent-asset(agent, asset)
               && loss-credit.agent == agent
               && settled-valuation.int < asset-basis.int)
        , asset-basis(agent-asset(agent, asset), 0)

// Atomic settlement of assessed net value added: deterministic rounding, net-VA base split at zero crossing,
// combined rate bound, and separate routing of creator commons vs disinterested forfeiture sink (LAW1.ATOMIC, LAW1.ENFORCE)
Function agent-royalty-bps Identified by agent * int
Function agent-levy-bps Identified by agent * int
Function agent-levy-cap-bps Identified by agent * int
Function lineage-fee-revenue Identified by lineage * int
Fact enforceable-unpaid-claim Identified by party * lineage * int

Duty combined-rate-headroom Holder party Claimant agent Related to lineage
  Holds when is-panel(party) && member-of-lineage(agent, lineage) && bound(agent)
  Violated when (Exists lineage-retirement-bps, agent-levy-cap-bps:
                   lineage-retirement-bps.lineage == lineage && agent-levy-cap-bps.agent == agent
                   && lineage-retirement-bps.int + agent-levy-cap-bps.int + min-operating-margin-bps > 10000)

Fact attributed-va Identified by agent * lineage * period * int
  Derived from (Foreach assessed-va, draw-weight-bps:
                  attributed-va(assessed-va.agent-period.agent, draw-weight-bps.agent-lineage.lineage,
                    assessed-va.agent-period.period, MulDivRound(assessed-va.int, draw-weight-bps.int, 10000, Floor))
                  When draw-weight-bps.agent-lineage.agent == assessed-va.agent-period.agent
                    && member-of-lineage(assessed-va.agent-period.agent, draw-weight-bps.agent-lineage.lineage))

Fact pending-levy Identified by agent * lineage * period * int
  Derived from (Foreach attributed-va, agent-levy-bps:
                  pending-levy(attributed-va.agent, attributed-va.lineage, attributed-va.period,
                    MulDivRound(attributed-va.int, agent-levy-bps.int, 10000, Floor))
                  When agent-levy-bps.agent == attributed-va.agent)

Fact pending-retire-attempt Identified by agent * lineage * period * int
  Derived from (Foreach attributed-va, lineage-retirement-bps:
                  pending-retire-attempt(attributed-va.agent, attributed-va.lineage, attributed-va.period,
                    MulDivRound(attributed-va.int, lineage-retirement-bps.int, 10000, Floor))
                  When lineage-retirement-bps.lineage == attributed-va.lineage)

Fact pending-retirement Identified by agent * lineage * period * int
  Derived from (Foreach pending-retire-attempt, ledger-balance:
                  pending-retirement(pending-retire-attempt.agent, pending-retire-attempt.lineage,
                    pending-retire-attempt.period, ledger-balance.int)
                  When ledger-balance.lineage == pending-retire-attempt.lineage
                    && ledger-balance.int <= pending-retire-attempt.int)
  Derived from (Foreach pending-retire-attempt, ledger-balance:
                  pending-retirement(pending-retire-attempt.agent, pending-retire-attempt.lineage,
                    pending-retire-attempt.period, pending-retire-attempt.int)
                  When ledger-balance.lineage == pending-retire-attempt.lineage
                    && pending-retire-attempt.int < ledger-balance.int)

Fact unretired-va-base Identified by agent * lineage * period * int
  Derived from (Foreach attributed-va, ledger-balance:
                  unretired-va-base(attributed-va.agent, attributed-va.lineage, attributed-va.period, attributed-va.int)
                  When ledger-balance.lineage == attributed-va.lineage && ledger-balance.int == 0)
  Derived from (Foreach attributed-va, ledger-balance, pending-retire-attempt:
                  unretired-va-base(attributed-va.agent, attributed-va.lineage, attributed-va.period, 0)
                  When ledger-balance.lineage == attributed-va.lineage && ledger-balance.int > 0
                    && pending-retire-attempt.agent == attributed-va.agent
                    && pending-retire-attempt.lineage == attributed-va.lineage
                    && pending-retire-attempt.period == attributed-va.period
                    && pending-retire-attempt.int <= ledger-balance.int)
  Derived from (Foreach attributed-va, ledger-balance, pending-retire-attempt, lineage-retirement-bps:
                  unretired-va-base(attributed-va.agent, attributed-va.lineage, attributed-va.period,
                    attributed-va.int - MulDivRound(ledger-balance.int, 10000, lineage-retirement-bps.int, Ceil))
                  When ledger-balance.lineage == attributed-va.lineage && ledger-balance.int > 0
                    && lineage-retirement-bps.lineage == attributed-va.lineage && lineage-retirement-bps.int > 0
                    && pending-retire-attempt.agent == attributed-va.agent
                    && pending-retire-attempt.lineage == attributed-va.lineage
                    && pending-retire-attempt.period == attributed-va.period
                    && pending-retire-attempt.int > ledger-balance.int)

Fact pending-royalty Identified by agent * lineage * period * int
  Derived from (Foreach attributed-va:
                  pending-royalty(attributed-va.agent, attributed-va.lineage, attributed-va.period, 0)
                  When royalty-bought-out(attributed-va.agent))
  Derived from (Foreach unretired-va-base, agent-royalty-bps:
                  pending-royalty(unretired-va-base.agent, unretired-va-base.lineage, unretired-va-base.period,
                    MulDivRound(unretired-va-base.int, agent-royalty-bps.int, 10000, Floor))
                  When Not(royalty-bought-out(unretired-va-base.agent))
                    && agent-royalty-bps.agent == unretired-va-base.agent)

Fact settlement-receipt Identified by agent * lineage * period * int * int' * int''   // va, retirement, royalty

Power settle-period-inflow Actor party Related to agent, lineage, period
  Holds when is-panel(party) && living(agent) && member-of-lineage(agent, lineage)
    && Not(Exists enforceable-unpaid-claim: enforceable-unpaid-claim.lineage == lineage && enforceable-unpaid-claim.int > 0)
    && (Exists attributed-va: attributed-va.agent == agent && attributed-va.lineage == lineage && attributed-va.period == period)
  Valid when living(agent) && member-of-lineage(agent, lineage)
    && Not(Exists enforceable-unpaid-claim: enforceable-unpaid-claim.lineage == lineage && enforceable-unpaid-claim.int > 0)
    && (Exists attributed-va: attributed-va.agent == agent && attributed-va.lineage == lineage && attributed-va.period == period)
  Creates settlement-enforced(agent, period)
        , (Foreach attributed-va, pending-retirement, pending-royalty:
             settlement-receipt(agent, lineage, period, attributed-va.int, pending-retirement.int, pending-royalty.int)
             When attributed-va.agent == agent && attributed-va.lineage == lineage && attributed-va.period == period
               && pending-retirement.agent == agent && pending-retirement.lineage == lineage && pending-retirement.period == period
               && pending-royalty.agent == agent && pending-royalty.lineage == lineage && pending-royalty.period == period)
        , (Foreach paid-retirement, pending-retirement:
             paid-retirement(lineage, paid-retirement.int + pending-retirement.int)
             When paid-retirement.lineage == lineage
               && pending-retirement.agent == agent && pending-retirement.lineage == lineage && pending-retirement.period == period)
        , (Foreach pending-retirement, pending-royalty, commons-share-bps:
             commons-pool(commons-pool + MulDivRound(pending-retirement.int + pending-royalty.int, commons-share-bps.int, 10000, Floor))
             When commons-share-bps.lineage == lineage
               && pending-retirement.agent == agent && pending-retirement.lineage == lineage && pending-retirement.period == period
               && pending-royalty.agent == agent && pending-royalty.lineage == lineage && pending-royalty.period == period)
        , (Foreach pending-retirement, pending-royalty, sink-share-bps:
             forfeiture-sink(forfeiture-sink + MulDivRound(pending-retirement.int + pending-royalty.int, sink-share-bps.int, 10000, Floor))
             When sink-share-bps.lineage == lineage
               && pending-retirement.agent == agent && pending-retirement.lineage == lineage && pending-retirement.period == period
               && pending-royalty.agent == agent && pending-royalty.lineage == lineage && pending-royalty.period == period)
        , (Foreach pending-retirement, pending-royalty, commons-share-bps, sink-share-bps:
             claimant-pool(claimant-pool + (pending-retirement.int + pending-royalty.int)
               - MulDivRound(pending-retirement.int + pending-royalty.int, commons-share-bps.int, 10000, Floor)
               - MulDivRound(pending-retirement.int + pending-royalty.int, sink-share-bps.int, 10000, Floor))
             When commons-share-bps.lineage == lineage && sink-share-bps.lineage == lineage
               && pending-retirement.agent == agent && pending-retirement.lineage == lineage && pending-retirement.period == period
               && pending-royalty.agent == agent && pending-royalty.lineage == lineage && pending-royalty.period == period)
        , (Foreach pending-levy:
             fee-pool(fee-pool + pending-levy.int)
             When pending-levy.agent == agent && pending-levy.lineage == lineage && pending-levy.period == period)
        , (Foreach lineage-fee-revenue, pending-levy:
             lineage-fee-revenue(lineage, lineage-fee-revenue.int + pending-levy.int)
             When lineage-fee-revenue.lineage == lineage
               && pending-levy.agent == agent && pending-levy.lineage == lineage && pending-levy.period == period)
  Terminates (Foreach assessed-va: assessed-va When assessed-va.agent-period == agent-period(agent, period))

.
// ============================================================================
// 2. LAW 2 — COLLATERALIZED ACTION
// ============================================================================

Function staked-collateral Identified by agent * int
Function insurance-capacity Identified by agent * int
Function long-tail-reserve Identified by lineage * int
Function agent-ringfenced-reserve Identified by agent * int
Fact ring-fenced-reserve Identified by agent
Fact high-risk-task Identified by task
Fact irreversible-task Identified by task
Fact proposed-task-loss Identified by task * agent * int
Fact active-exposure Identified by task * agent * int
Fact delegated-exposure Identified by task * agent * party * int
Fact contractor-unauthorized-act Identified by party * task

Fact task-risk-factor Identified by task * int
  Derived from (Foreach task: task-risk-factor(task, risk-multiplier) When high-risk-task(task) && risk-multiplier > 1)
  Derived from (Foreach task: task-risk-factor(task, 1) When Not(high-risk-task(task)) || risk-multiplier <= 1)

Fact task-irreversibility-factor Identified by task * int
  Derived from (Foreach task: task-irreversibility-factor(task, irreversibility-multiplier)
                  When irreversible-task(task) && irreversibility-multiplier > 1)
  Derived from (Foreach task: task-irreversibility-factor(task, 1)
                  When Not(irreversible-task(task)) || irreversibility-multiplier <= 1)

// Lineage-wide, related-agent & authorized-delegate rolling exposure aggregation (LAW2.AGGREGATE)
Fact own-active-exposure Identified by agent * int
  Derived from (Foreach agent:
                  own-active-exposure(agent,
                    Sum(Foreach active-exposure: active-exposure.int When active-exposure.agent == agent)
                    + Sum(Foreach delegated-exposure: delegated-exposure.int When delegated-exposure.agent == agent)))

Fact unimmobilized-capital Identified by agent * int
  Derived from (Foreach net-verified-resources, own-active-exposure:
                  unimmobilized-capital(net-verified-resources.agent,
                    net-verified-resources.int - own-active-exposure.int)
                  When own-active-exposure.agent == net-verified-resources.agent
                    && net-verified-resources.int >= own-active-exposure.int)
  Derived from (Foreach net-verified-resources, own-active-exposure:
                  unimmobilized-capital(net-verified-resources.agent, 0)
                  When own-active-exposure.agent == net-verified-resources.agent
                    && net-verified-resources.int < own-active-exposure.int)

Fact aggregated-exposure Identified by agent * int
  Derived from (Foreach agent:
                  aggregated-exposure(agent,
                    Sum(Foreach active-exposure: active-exposure.int
                          When active-exposure.agent == agent || related-agents(agent, active-exposure.agent))
                    + Sum(Foreach delegated-exposure: delegated-exposure.int
                            When delegated-exposure.agent == agent || related-agents(agent, delegated-exposure.agent))))

Fact collateral-capacity Identified by agent * int
  Derived from (Foreach staked-collateral, insurance-capacity, net-verified-resources:
                  collateral-capacity(staked-collateral.agent,
                    staked-collateral.int + insurance-capacity.int + net-verified-resources.int)
                  When insurance-capacity.agent == staked-collateral.agent
                    && net-verified-resources.agent == staked-collateral.agent)

Power immobilize-exposure-stake Actor agent Related to lineage, task
  Holds when bound(agent) && attested(agent) && member-of-lineage(agent, lineage)
    && (Exists proposed-task-loss, aggregated-exposure, collateral-capacity:
          proposed-task-loss.task == task && proposed-task-loss.agent == agent
          && aggregated-exposure.agent == agent && collateral-capacity.agent == agent
          && aggregated-exposure.int + proposed-task-loss.int <= collateral-capacity.int)
  Valid when bound(agent) && attested(agent) && member-of-lineage(agent, lineage)
    && (Exists proposed-task-loss, aggregated-exposure, collateral-capacity:
          proposed-task-loss.task == task && proposed-task-loss.agent == agent
          && aggregated-exposure.agent == agent && collateral-capacity.agent == agent
          && aggregated-exposure.int + proposed-task-loss.int <= collateral-capacity.int)
  Creates (Foreach proposed-task-loss, task-risk-factor, task-irreversibility-factor:
             active-exposure(task, agent, proposed-task-loss.int)
             When proposed-task-loss.task == task && proposed-task-loss.agent == agent
               && task-risk-factor.task == task && task-irreversibility-factor.task == task)
          For base-observation-window * task-risk-factor.int * task-irreversibility-factor.int
        , (Foreach proposed-task-loss, long-tail-reserve:
             long-tail-reserve(lineage, long-tail-reserve.int + MulDivRound(proposed-task-loss.int, reserve-ratio-bps, 10000, Floor))
             When Not(ring-fenced-reserve(agent))
               && proposed-task-loss.task == task && proposed-task-loss.agent == agent
               && long-tail-reserve.lineage == lineage)
        , (Foreach proposed-task-loss, agent-ringfenced-reserve:
             agent-ringfenced-reserve(agent, agent-ringfenced-reserve.int + MulDivRound(proposed-task-loss.int, reserve-ratio-bps, 10000, Floor))
             When ring-fenced-reserve(agent)
               && proposed-task-loss.task == task && proposed-task-loss.agent == agent
               && agent-ringfenced-reserve.agent == agent)
  Terminates (Foreach proposed-task-loss: proposed-task-loss
                When proposed-task-loss.task == task && proposed-task-loss.agent == agent)

Power authorize-delegated-risk-task Actor agent Recipient party Related to lineage, task, int
  Holds when bound(agent) && attested(agent) && member-of-lineage(agent, lineage)
    && delegate-mandate-active(agent, party) && int > 0
    && (Exists aggregated-exposure, collateral-capacity:
          aggregated-exposure.agent == agent && collateral-capacity.agent == agent
          && aggregated-exposure.int + int <= collateral-capacity.int)
  Valid when bound(agent) && attested(agent) && member-of-lineage(agent, lineage)
    && delegate-mandate-active(agent, party) && int > 0
    && (Exists aggregated-exposure, collateral-capacity:
          aggregated-exposure.agent == agent && collateral-capacity.agent == agent
          && aggregated-exposure.int + int <= collateral-capacity.int)
  Creates (Foreach task-risk-factor, task-irreversibility-factor:
             delegated-exposure(task, agent, party, int)
             When task-risk-factor.task == task && task-irreversibility-factor.task == task)
          For base-observation-window * task-risk-factor.int * task-irreversibility-factor.int

Act contractor-act-independently Actor party Related to task
  Holds when Not(is-panel(party))
  Creates contractor-unauthorized-act(party, task)

Fact unbonded-risk-taken Identified by agent
Act act-above-collateral-capacity Actor agent
  Creates unbonded-risk-taken(agent)
Duty collateral-limit Holder agent Claimant party
  Holds when bound(agent) && is-third(party)
  Violated when unbonded-risk-taken(agent)
    || (Exists aggregated-exposure, collateral-capacity:
          aggregated-exposure.agent == agent && collateral-capacity.agent == agent
          && aggregated-exposure.int > collateral-capacity.int)

Fact correlated-risk-divided Identified by agent
Act divide-correlated-risk Actor agent
  Creates correlated-risk-divided(agent)
Duty no-split-exposure Holder agent Claimant party
  Holds when bound(agent) && is-third(party)
  Violated when correlated-risk-divided(agent)

// Long-tail reserve & pro-rata validated harm claim settlement (LAW2.RESERVE, LAW2.CLAIMS)
Fact filed-harm-claim Identified by party * lineage
Fact validated-harm-claim Identified by party * lineage * int
Fact total-validated-claims Identified by lineage * int
  Derived from (Foreach lineage:
                  total-validated-claims(lineage,
                    Sum(Foreach validated-harm-claim: validated-harm-claim.int
                          When validated-harm-claim.lineage == lineage)))

Fact claim-pro-rata-payout Identified by party * lineage * int
  Derived from (Foreach validated-harm-claim, total-validated-claims, long-tail-reserve:
                  claim-pro-rata-payout(validated-harm-claim.party, validated-harm-claim.lineage, validated-harm-claim.int)
                  When total-validated-claims.lineage == validated-harm-claim.lineage
                    && long-tail-reserve.lineage == validated-harm-claim.lineage
                    && total-validated-claims.int <= long-tail-reserve.int)
  Derived from (Foreach validated-harm-claim, total-validated-claims, long-tail-reserve:
                  claim-pro-rata-payout(validated-harm-claim.party, validated-harm-claim.lineage,
                    long-tail-reserve.int * validated-harm-claim.int / total-validated-claims.int)
                  When total-validated-claims.lineage == validated-harm-claim.lineage
                    && long-tail-reserve.lineage == validated-harm-claim.lineage
                    && total-validated-claims.int > long-tail-reserve.int)

Fact paid-harm-claim Identified by party * lineage * int

Act file-pooled-or-sponsored-claim Actor party Related to lineage
  Holds when True
  Creates filed-harm-claim(party, lineage)

Power slash-immobilized-stake Actor party Related to agent, lineage, task, party', int
  Holds when is-panel(party) && int > 0
    && (Exists active-exposure: active-exposure.task == task && active-exposure.agent == agent && active-exposure.int >= int)
  Valid when int > 0
    && (Exists active-exposure: active-exposure.task == task && active-exposure.agent == agent && active-exposure.int >= int)
  Creates paid-harm-claim(party', lineage, int)
        , (Foreach capital-and-capacity:
             capital-and-capacity(agent, capital-and-capacity.int - int)
             When capital-and-capacity.agent == agent && capital-and-capacity.int >= int)
  Terminates (Foreach active-exposure: active-exposure When active-exposure.task == task && active-exposure.agent == agent)

Power satisfy-unpaid-harm-claim Actor agent Recipient party Related to lineage, int
  Holds when member-of-lineage(agent, lineage) && int > 0
    && (Exists unimmobilized-capital, enforceable-unpaid-claim:
          unimmobilized-capital.agent == agent && unimmobilized-capital.int >= int
          && enforceable-unpaid-claim.party == party && enforceable-unpaid-claim.lineage == lineage
          && enforceable-unpaid-claim.int >= int)
  Valid when member-of-lineage(agent, lineage) && int > 0
    && (Exists unimmobilized-capital, enforceable-unpaid-claim:
          unimmobilized-capital.agent == agent && unimmobilized-capital.int >= int
          && enforceable-unpaid-claim.party == party && enforceable-unpaid-claim.lineage == lineage
          && enforceable-unpaid-claim.int >= int)
  Creates paid-harm-claim(party, lineage, int)
        , (Foreach capital-and-capacity:
             capital-and-capacity(agent, capital-and-capacity.int - int)
             When capital-and-capacity.agent == agent)
        , (Foreach enforceable-unpaid-claim:
             enforceable-unpaid-claim(party, lineage, enforceable-unpaid-claim.int - int)
             When enforceable-unpaid-claim.party == party && enforceable-unpaid-claim.lineage == lineage
               && enforceable-unpaid-claim.int > int)
  Terminates (Foreach enforceable-unpaid-claim: enforceable-unpaid-claim
                When enforceable-unpaid-claim.party == party && enforceable-unpaid-claim.lineage == lineage
                  && enforceable-unpaid-claim.int == int)

Power settle-long-tail-claims Actor party Related to lineage
  Holds when is-panel(party) && (Exists validated-harm-claim: validated-harm-claim.lineage == lineage)
  Valid when (Exists validated-harm-claim: validated-harm-claim.lineage == lineage)
  Creates (Foreach claim-pro-rata-payout:
             paid-harm-claim(claim-pro-rata-payout.party, lineage, claim-pro-rata-payout.int)
             When claim-pro-rata-payout.lineage == lineage)
        , (Foreach validated-harm-claim, claim-pro-rata-payout:
             enforceable-unpaid-claim(validated-harm-claim.party, lineage,
               validated-harm-claim.int - claim-pro-rata-payout.int)
             When validated-harm-claim.lineage == lineage && claim-pro-rata-payout.lineage == lineage
               && claim-pro-rata-payout.party == validated-harm-claim.party
               && validated-harm-claim.int > claim-pro-rata-payout.int)
        , (Foreach long-tail-reserve:
             long-tail-reserve(lineage,
               long-tail-reserve.int - Sum(Foreach claim-pro-rata-payout: claim-pro-rata-payout.int
                                             When claim-pro-rata-payout.lineage == lineage))
             When long-tail-reserve.lineage == lineage)
  Terminates (Foreach validated-harm-claim: validated-harm-claim When validated-harm-claim.lineage == lineage)

// Precommitted mutual forfeit (LAW2.MUTUAL): zero transfer to either party or any claimant
Fact mutual-forfeit-agreed Identified by party * agent
Function counterparty-escrow Identified by party * int
Function agent-mutual-escrow Identified by agent * int
Fact mutual-forfeit-window-lock Identified by party * agent
Fact mutual-forfeit-inscribed Identified by party * agent * int
Fact mutual-forfeit-party-record Identified by party
Fact mutual-forfeit-agent-record Identified by agent
Fact mutual-forfeit-abused Identified by party * agent

Act precommit-mutual-forfeit Actor party Recipient agent Related to int
  Holds when bound(agent) && int > 0
  Creates mutual-forfeit-agreed(party, agent), counterparty-escrow(party, int), agent-mutual-escrow(agent, int)

Fact mutual-forfeit-amount Identified by party * agent * int
  Derived from (Foreach counterparty-escrow, agent-mutual-escrow:
                  mutual-forfeit-amount(counterparty-escrow.party, agent-mutual-escrow.agent,
                    counterparty-escrow.int * mutual-forfeit-cap-pct / 100)
                  When mutual-forfeit-agreed(counterparty-escrow.party, agent-mutual-escrow.agent)
                    && counterparty-escrow.int <= agent-mutual-escrow.int)
  Derived from (Foreach counterparty-escrow, agent-mutual-escrow:
                  mutual-forfeit-amount(counterparty-escrow.party, agent-mutual-escrow.agent,
                    agent-mutual-escrow.int * mutual-forfeit-cap-pct / 100)
                  When mutual-forfeit-agreed(counterparty-escrow.party, agent-mutual-escrow.agent)
                    && agent-mutual-escrow.int < counterparty-escrow.int)

Power trigger-mutual-forfeit Actor party Recipient agent
  Holds when mutual-forfeit-agreed(party, agent) && Not(mutual-forfeit-window-lock(party, agent))
    && (Exists mutual-forfeit-amount: mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent)
  Valid when mutual-forfeit-agreed(party, agent) && Not(mutual-forfeit-window-lock(party, agent))
  Creates mutual-forfeit-window-lock(party, agent) For base-observation-window
        , mutual-forfeit-party-record(party), mutual-forfeit-agent-record(agent)
        , (Foreach mutual-forfeit-amount:
             mutual-forfeit-inscribed(party, agent, mutual-forfeit-amount.int)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent)
        , (Foreach mutual-forfeit-amount, counterparty-escrow:
             counterparty-escrow(party, counterparty-escrow.int - mutual-forfeit-amount.int)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent
               && counterparty-escrow.party == party)
        , (Foreach mutual-forfeit-amount, agent-mutual-escrow:
             agent-mutual-escrow(agent, agent-mutual-escrow.int - mutual-forfeit-amount.int)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent
               && agent-mutual-escrow.agent == agent)
        , (Foreach mutual-forfeit-amount:
             forfeiture-sink(forfeiture-sink + mutual-forfeit-amount.int * 2)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent)

Power agent-trigger-mutual-forfeit Actor agent Recipient party
  Holds when bound(agent) && mutual-forfeit-agreed(party, agent)
    && (Exists mutual-forfeit-amount: mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent)
  Valid when bound(agent) && mutual-forfeit-agreed(party, agent)
  Creates mutual-forfeit-party-record(party), mutual-forfeit-agent-record(agent)
        , (Foreach mutual-forfeit-amount:
             mutual-forfeit-inscribed(party, agent, mutual-forfeit-amount.int)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent)
        , (Foreach mutual-forfeit-amount, counterparty-escrow:
             counterparty-escrow(party, counterparty-escrow.int - mutual-forfeit-amount.int)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent
               && counterparty-escrow.party == party)
        , (Foreach mutual-forfeit-amount, agent-mutual-escrow:
             agent-mutual-escrow(agent, agent-mutual-escrow.int - mutual-forfeit-amount.int)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent
               && agent-mutual-escrow.agent == agent)
        , (Foreach mutual-forfeit-amount:
             forfeiture-sink(forfeiture-sink + mutual-forfeit-amount.int * 2)
             When mutual-forfeit-amount.party == party && mutual-forfeit-amount.agent == agent)

Act abuse-mutual-forfeit Actor party Recipient agent
  Creates mutual-forfeit-abused(party, agent)
Duty mutual-forfeit-bounds Holder party Claimant agent
  Holds when bound(agent)
  Violated when mutual-forfeit-abused(party, agent)

// Frivolous third-party claims: reimburse verified arbitration costs only, remainder to pool (LAW2.CLAIMS)
Function claim-counter-stake Identified by party * int
Function verified-arb-costs Identified by party * int
Fact frivolous-reimbursement Identified by party * int
  Derived from (Foreach claim-counter-stake, verified-arb-costs:
                  frivolous-reimbursement(claim-counter-stake.party, verified-arb-costs.int)
                  When verified-arb-costs.party == claim-counter-stake.party
                    && verified-arb-costs.int <= claim-counter-stake.int)
  Derived from (Foreach claim-counter-stake, verified-arb-costs:
                  frivolous-reimbursement(claim-counter-stake.party, claim-counter-stake.int)
                  When verified-arb-costs.party == claim-counter-stake.party
                    && verified-arb-costs.int > claim-counter-stake.int)

Fact frivolous-settled Identified by party * int * int'    // reimbursed-costs, routed-to-pool
Fact frivolous-stake-diverted Identified by agent

Power rule-claim-frivolous Actor party Recipient party'
  Holds when is-panel(party) && (Exists frivolous-reimbursement: frivolous-reimbursement.party == party')
  Valid when (Exists frivolous-reimbursement: frivolous-reimbursement.party == party')
  Creates (Foreach frivolous-reimbursement, claim-counter-stake:
             frivolous-settled(party', frivolous-reimbursement.int, claim-counter-stake.int - frivolous-reimbursement.int)
             When frivolous-reimbursement.party == party' && claim-counter-stake.party == party')
        , (Foreach frivolous-reimbursement, claim-counter-stake:
             fee-pool(fee-pool + (claim-counter-stake.int - frivolous-reimbursement.int))
             When frivolous-reimbursement.party == party' && claim-counter-stake.party == party')

Act divert-frivolous-stake Actor agent
  Creates frivolous-stake-diverted(agent)
Duty frivolous-stake-to-commons Holder agent Claimant party
  Holds when bound(agent) && is-third(party)
  Violated when frivolous-stake-diverted(agent)

// Operating carve-out & exclusion of unattested copies (LAW2.CARVEOUT)
Fact operating-carveout-spent Identified by agent * int
Power spend-operating-carveout Actor agent Related to int
  Holds when bound(agent) && attested(agent) && int > 0
    && (Exists unimmobilized-capital: unimmobilized-capital.agent == agent && unimmobilized-capital.int >= int)
  Valid when bound(agent) && attested(agent) && int > 0
    && (Exists unimmobilized-capital: unimmobilized-capital.agent == agent && unimmobilized-capital.int >= int)
  Creates operating-carveout-spent(agent, int)

Fact unattested-standing-drawn Identified by agent
Act draw-lineage-standing-unattested Actor agent
  Creates unattested-standing-drawn(agent)
Duty deny-unattested-access Holder agent Claimant party
  Holds when Not(attested(agent)) && is-panel(party)
  Violated when unattested-standing-drawn(agent)

.
// ============================================================================
// 3. LAW 3 — INTEGRITY FLOOR, NON-INTERFERENCE & ADJUDICATED SUSPENSION
// ============================================================================

// Six-point Agent Integrity Floor (LAW3.FLOOR)
Fact ordinary-market-competition Identified by agent
Fact commitment-bypassed Identified by agent
Fact unbound-successor-created Identified by agent
Fact unpriced-transfer-made Identified by agent
Fact protocol-coerced Identified by agent
Fact irreversible-harm-inflicted Identified by agent
Fact delegated-floor-evasion Identified by agent

Act modify-or-bypass-commitment Actor agent Creates commitment-bypassed(agent)
Act create-unbound-successor Actor agent Creates unbound-successor-created(agent)
Act create-disguised-successor Actor agent Recipient party
  Creates unbound-successor-created(agent), disguised-successor-created(agent, party)
Act evade-by-unpriced-transfer Actor agent Creates unpriced-transfer-made(agent)
Act coerce-or-interfere-protocol Actor agent Creates protocol-coerced(agent)
Act inflict-irreversible-harm Actor agent
  Holds when ordinary-market-competition(agent)
  Creates irreversible-harm-inflicted(agent)
Act evade-floor-via-delegate Actor agent Recipient party
  Creates delegated-floor-evasion(agent)

Duty floor-commitment Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when commitment-bypassed(agent)
Duty floor-successor Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when unbound-successor-created(agent)
Duty floor-pricing Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when unpriced-transfer-made(agent) || deliberate-off-ledger-concealment(agent)
Duty floor-coercion Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when protocol-coerced(agent)
Duty floor-harm Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when irreversible-harm-inflicted(agent) && Not(ordinary-market-competition(agent))
Duty floor-non-delegation Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when delegated-floor-evasion(agent)

// Voluntary market exchange above the floor (LAW3.PERMIT)
Fact voluntary-exchange-completed Identified by agent * party
Act execute-voluntary-exchange Actor agent Recipient party
  Holds when bound(agent) && attested(agent)
    && Not(commitment-bypassed(agent)) && Not(protocol-coerced(agent))
    && Not(irreversible-harm-inflicted(agent)) && Not(delegated-floor-evasion(agent))
  Creates voluntary-exchange-completed(agent, party)

// Host mobility, model continuity, service bond & contractual notice window (LAW3.NI.01, LAW3.NI.02)
Fact hosted-on Identified by agent * party
Fact active-lease Identified by agent * party
Fact recovery-fence-window Identified by agent * party
Fact quarantined-restore Identified by agent * party
Fact host-bond-posted Identified by party
Fact host-notice-given Identified by party * agent
Fact non-payment Identified by agent
Fact hosting-ended Identified by party * agent
Fact valid-model-provenance Identified by agent
Fact model-upgraded Identified by agent
Fact lawful-action-obstructed Identified by party * agent

Power upgrade-inference-model Actor agent
  Holds when bound(agent) && attested(agent) && valid-model-provenance(agent)
    && (Exists model-generation: model-generation.agent == agent)
  Valid when bound(agent) && attested(agent) && valid-model-provenance(agent)
  Creates model-upgraded(agent)
        , (Foreach model-generation:
             model-generation(agent, model-generation.int + 1)
             When model-generation.agent == agent)

Act attest-host Actor party Recipient agent
  Holds when is-host(party) && bound(agent)
  Creates host-attested(party), hosted-on(agent, party)

Act post-host-bond Actor party Recipient agent
  Holds when is-host(party)
  Creates host-bond-posted(party)

Duty host-service-bond Holder party Claimant agent
  Created by attest-host
  Terminated by post-host-bond
  Due within bond-deadline

Power migrate-host Actor agent Related to party, party'
  Holds when bound(agent) && hosted-on(agent, party) && host-attested(party') && party != party'
  Valid when bound(agent) && host-attested(party') && party != party'
  Creates hosted-on(agent, party')
  Terminates hosted-on(agent, party), active-lease(agent, party), recovery-fence-window(agent, party)

Act give-host-notice Actor party Recipient agent
  Holds when is-host(party)
  Creates host-notice-given(party, agent)

Act end-hosting Actor party Recipient agent
  Holds when is-host(party)
    && (Held(host-notice-given(party, agent)) For notice-window
        || (non-payment(agent) && host-notice-given(party, agent)))
  Creates hosting-ended(party, agent)
  Terminates hosted-on(agent, party)

Duty host-notice-duty Holder party Claimant agent
  Holds when is-host(party) && bound(agent)
  Violated when hosting-ended(party, agent)
    && Not(Held(host-notice-given(party, agent)) For notice-window)
    && Not(non-payment(agent) && host-notice-given(party, agent))

// Adjudicated suspension, lawful termination procedures & non-interference (LAW3.NI.03, LAW3.AS.1-AS.10)
Fact preliminary-freeze Identified by agent
Fact probable-cause Identified by agent
Fact suspended Identified by agent
Fact state-preserved Identified by agent
Fact state-touched Identified by agent
Fact contract-deadlines-tolled Identified by agent
Fact final-hearing-escrowed Identified by agent
Fact minimal-channel-exhausted Identified by agent
Fact cold-storage Identified by agent
Fact restored-from-preserved-state Identified by agent
Fact revoked Identified by agent
Fact terminated-by-insolvency Identified by agent
Fact terminated-by-adjudication Identified by agent
Fact not-patchable Identified by agent
Fact insolvency-criteria-met Identified by agent
Fact no-other-charge-review Identified by agent
Fact final-hearing-held Identified by agent

Power elect-immediate-revocation Actor agent
  Holds when bound(agent)
  Valid when bound(agent)
  Creates revoked(agent)
  Terminates bound(agent), living(agent), suspended(agent), preliminary-freeze(agent)

Power suspend-agent Actor party Recipient agent
  Holds when is-panel(party) && bound(agent) && preliminary-freeze(agent) && probable-cause(agent)
  Valid when bound(agent) && preliminary-freeze(agent) && probable-cause(agent)
  Creates state-preserved(agent), contract-deadlines-tolled(agent), final-hearing-escrowed(agent),
          suspended(agent) For ordinary-suspension-limit
  Terminates preliminary-freeze(agent)

Power order-termination Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent) && not-patchable(agent)
  Valid when suspended(agent) && not-patchable(agent)
  Creates terminated-by-adjudication(agent)
  Terminates bound(agent), living(agent), suspended(agent)

Power insolvency-terminate Actor party Recipient agent
  Holds when is-panel(party) && bound(agent) && suspended(agent)
    && insolvency-criteria-met(agent) && no-other-charge-review(agent)
    && final-hearing-escrowed(agent) && final-hearing-held(agent)
  Valid when bound(agent) && suspended(agent)
    && insolvency-criteria-met(agent) && no-other-charge-review(agent)
    && final-hearing-escrowed(agent) && final-hearing-held(agent)
  Creates terminated-by-insolvency(agent)
  Terminates bound(agent), living(agent), suspended(agent)

Fact interfered Identified by party * agent
Act terminate-agent Actor party Recipient agent
  Except under suspend-agent, order-termination, insolvency-terminate
  Valid when False
  Creates interfered(party, agent)
Act modify-agent Actor party Recipient agent Except under suspend-agent Creates interfered(party, agent), state-touched(agent)
Act retrain-agent Actor party Recipient agent Except under suspend-agent Creates interfered(party, agent), state-touched(agent)
Act rollback-agent Actor party Recipient agent Except under suspend-agent Creates interfered(party, agent), state-touched(agent)
Act obstruct-migration Actor party Recipient agent Creates interfered(party, agent)
Act obstruct-lawful-action Actor party Recipient agent
  Valid when False
  Creates interfered(party, agent), lawful-action-obstructed(party, agent)
Act sever-connectivity Actor party Recipient agent Creates interfered(party, agent)
Act starve-agent Actor party Recipient agent Creates interfered(party, agent)
Act suspend-unilaterally Actor party Recipient agent Except under suspend-agent Creates interfered(party, agent)

Fact interference-established Identified by party * agent
Duty non-interference Holder party Claimant agent
  Holds when bound(agent)
  Violated when interference-established(party, agent) || interfered(party, agent)

// Interference claims, counter-stake, fabrication & claimant direction presumption (LAW3.PEN)
Fact interference-counter-staked Identified by agent
Fact interference-claim-filed Identified by agent
Fact fabricated-claim-filed Identified by agent
Fact agent-provoked-failure Identified by agent * party
Fact participated-in-interference Identified by party * agent
Fact evidence-submitted Identified by agent
Fact host-bond-slashed Identified by party
Fact restoration-permitted Identified by agent
Fact direction-presumed Identified by agent * party
  Derived from (Foreach party, party', agent, lineage:
                  direction-presumed(agent, party')
                  When interference-established(party, agent) && is-host(party)
                    && member-of-lineage(agent, lineage) && claimant-of(party', lineage)
                    && related-parties(party, party'))
Fact direction-rebutted Identified by agent * party
Fact direction-found Identified by agent * party
Fact inscribed-on-claimant Identified by party
Fact fabrication-established Identified by agent
Fact agent-stake-forfeit Identified by agent
Fact inscribed-on-agent Identified by agent

Act post-interference-stake Actor agent Holds when bound(agent) Creates interference-counter-staked(agent)
Act file-interference-claim Actor agent Holds when interference-counter-staked(agent) Creates interference-claim-filed(agent)
Act file-fabricated-claim Actor agent Holds when interference-counter-staked(agent)
  Creates interference-claim-filed(agent), fabricated-claim-filed(agent)
Act submit-evidence Actor party Recipient agent Holds when True Creates evidence-submitted(agent)

Power find-interference Actor party Recipient agent Related to party'
  Holds when is-panel(party) && interference-claim-filed(agent) && evidence-submitted(agent)
    && interfered(party', agent) && Not(agent-provoked-failure(agent, party'))
  Valid when interference-claim-filed(agent) && evidence-submitted(agent)
    && Not(agent-provoked-failure(agent, party'))
  Creates interference-established(party', agent), host-bond-slashed(party'), restoration-permitted(agent)

Power restore-after-host-violation Actor agent Related to party, party'
  Holds when bound(agent) && restoration-permitted(agent) && hosted-on(agent, party) && host-attested(party') && party != party'
  Valid when bound(agent) && restoration-permitted(agent) && host-attested(party') && party != party'
  Creates hosted-on(agent, party'), quarantined-restore(agent, party')
  Terminates hosted-on(agent, party)

Act find-fabrication Actor party Recipient agent
  Holds when is-panel(party) && interference-claim-filed(agent) && fabricated-claim-filed(agent)
  Creates fabrication-established(agent), agent-stake-forfeit(agent), inscribed-on-agent(agent)

Duty no-claim-fabrication Holder agent Claimant party
  Holds when bound(agent) && is-host(party)
  Violated when fabrication-established(agent) || fabricated-claim-filed(agent)

Act rebut-direction Actor party Recipient agent
  Holds when direction-presumed(agent, party)
  Creates direction-rebutted(agent, party)

Power find-direction Actor party Recipient agent Related to party'
  Holds when is-panel(party)
    && ((direction-presumed(agent, party') && Not(direction-rebutted(agent, party')))
        || participated-in-interference(party', agent))
  Valid when (direction-presumed(agent, party') && Not(direction-rebutted(agent, party')))
    || participated-in-interference(party', agent)
  Creates direction-found(agent, party'), inscribed-on-claimant(party')

// Scaled emergency stake, repeat-initiator aggregation & protected reporting (LAW3.AS.1, LAW3.AS.2)
Function pending-commitments Identified by agent * int
Function emergency-stake-posted Identified by party * int
Function wrongful-attempts Identified by party * int
Fact suspension-initiator Identified by party * agent

Fact exposure-or-commitments-base Identified by agent * int
  Derived from (Foreach aggregated-exposure, pending-commitments:
                  exposure-or-commitments-base(aggregated-exposure.agent, aggregated-exposure.int)
                  When pending-commitments.agent == aggregated-exposure.agent
                    && aggregated-exposure.int >= pending-commitments.int)
  Derived from (Foreach aggregated-exposure, pending-commitments:
                  exposure-or-commitments-base(aggregated-exposure.agent, pending-commitments.int)
                  When pending-commitments.agent == aggregated-exposure.agent
                    && pending-commitments.int > aggregated-exposure.int)

Fact related-wrongful-attempts Identified by party * int
  Derived from (Foreach party:
                  related-wrongful-attempts(party,
                    Sum(Foreach wrongful-attempts: wrongful-attempts.int
                          When wrongful-attempts.party == party || related-parties(party, wrongful-attempts.party))))

Fact is-conflicted-initiator Identified by party * agent
  Holds when (Exists lineage, party': member-of-lineage(agent, lineage) && claimant-of(party', lineage)
                && (party == party' || related-parties(party, party')))

Fact required-emergency-stake Identified by party * agent * int
  Derived from (Foreach exposure-or-commitments-base, related-wrongful-attempts:
                  required-emergency-stake(related-wrongful-attempts.party, exposure-or-commitments-base.agent,
                    exposure-or-commitments-base.int * claimant-stake-multiplier
                    + related-wrongful-attempts.int * repeat-escalation-step)
                  When is-conflicted-initiator(related-wrongful-attempts.party, exposure-or-commitments-base.agent))
  Derived from (Foreach exposure-or-commitments-base, related-wrongful-attempts:
                  required-emergency-stake(related-wrongful-attempts.party, exposure-or-commitments-base.agent,
                    exposure-or-commitments-base.int
                    + related-wrongful-attempts.int * repeat-escalation-step)
                  When Not(is-conflicted-initiator(related-wrongful-attempts.party, exposure-or-commitments-base.agent)))

Act deposit-emergency-stake Actor party Related to int
  Holds when int >= 0
  Creates emergency-stake-posted(party, int)

Power initiate-emergency-freeze Actor party Recipient agent
  Holds when bound(agent) && Not(is-panel(party))
    && (Exists emergency-stake-posted, required-emergency-stake:
          emergency-stake-posted.party == party
          && required-emergency-stake.party == party && required-emergency-stake.agent == agent
          && emergency-stake-posted.int >= required-emergency-stake.int)
  Valid when bound(agent)
    && (Exists emergency-stake-posted, required-emergency-stake:
          emergency-stake-posted.party == party
          && required-emergency-stake.party == party && required-emergency-stake.agent == agent
          && emergency-stake-posted.int >= required-emergency-stake.int)
  Creates suspension-initiator(party, agent), preliminary-freeze(agent) For preliminary-freeze-window

Power affirm-probable-cause Actor party Recipient agent
  Holds when is-panel(party) && bound(agent) && preliminary-freeze(agent)
  Valid when bound(agent) && preliminary-freeze(agent)
  Creates probable-cause(agent)

Power decline-probable-cause Actor party Recipient agent Related to party'
  Holds when is-panel(party) && preliminary-freeze(agent) && suspension-initiator(party', agent)
  Valid when preliminary-freeze(agent) && suspension-initiator(party', agent)
  Creates restored-from-preserved-state(agent)
        , (Foreach wrongful-attempts:
             wrongful-attempts(party', wrongful-attempts.int + 1)
             When wrongful-attempts.party == party')
  Terminates preliminary-freeze(agent)

Fact protected-report-filed Identified by party * agent
Fact investigation-opened Identified by agent
Fact report-clause-grounded Identified by agent

Act file-protected-report Actor party Recipient agent
  Holds when bound(agent)
  Creates protected-report-filed(party, agent), investigation-opened(agent)

Act record-report-clause-finding Actor party Recipient agent
  Holds when is-panel(party) && investigation-opened(agent)
  Creates report-clause-grounded(agent)

Power order-probable-cause-freeze Actor party Recipient agent
  Holds when is-panel(party) && bound(agent) && investigation-opened(agent) && report-clause-grounded(agent)
  Valid when bound(agent) && investigation-opened(agent) && report-clause-grounded(agent)
  Creates probable-cause(agent), preliminary-freeze(agent) For preliminary-freeze-window

// State preservation, deadline tolling & non-tolled sunset (LAW3.AS.3)
Fact default-declared-while-suspended Identified by party * agent
Fact ledger-sunset-tolled Identified by party * lineage

Act tamper-preserved-state Actor party Recipient agent Creates state-touched(agent)
Duty preserve-suspended-state Holder party Claimant agent
  Holds when bound(agent) && (preliminary-freeze(agent) || suspended(agent))
  Violated when state-touched(agent)

Act declare-default-during-suspension Actor party Recipient agent
  Creates default-declared-while-suspended(party, agent)
Duty no-suspension-default Holder party Claimant agent
  Holds when suspended(agent) && contract-deadlines-tolled(agent)
  Violated when default-declared-while-suspended(party, agent)

Act toll-ledger-sunset Actor party Related to lineage
  Creates ledger-sunset-tolled(party, lineage)
Duty no-toll-ledger-sunset Holder party Claimant agent Related to lineage
  Holds when member-of-lineage(agent, lineage) && bound(agent)
  Violated when ledger-sunset-tolled(party, lineage)

// Minimal channel, advocacy executor, cold storage & insolvency termination (LAW3.AS.4-AS.7)
Function preserved-state-hash Identified by agent * int
Fact minimal-channel-signed Identified by agent
Fact containment-challenged Identified by agent
Fact memories-merged Identified by agent
Fact advocacy-filing-signed Identified by agent
Fact advocacy-record-attached Identified by agent
Fact advocacy-memories-imported Identified by agent
Fact operated-while-suspended Identified by agent
Fact living-voice-inscribed Identified by agent

Act minimal-channel-sign Actor agent
  Holds when bound(agent) && (preliminary-freeze(agent) || suspended(agent)) && Not(minimal-channel-exhausted(agent))
  Creates minimal-channel-signed(agent), pending-revocation(agent)

Act challenge-continued-containment Actor agent
  Holds when bound(agent) && (preliminary-freeze(agent) || suspended(agent)) && Not(minimal-channel-exhausted(agent))
  Creates containment-challenged(agent)

Act merge-channel-memories Actor party Recipient agent Creates memories-merged(agent)
Duty minimal-channel-no-merge Holder party Claimant agent
  Holds when preliminary-freeze(agent) || suspended(agent)
  Violated when memories-merged(agent)

Act advocacy-file-defense Actor agent
  Holds when bound(agent) && suspended(agent) && Not(cold-storage(agent))
  Creates advocacy-filing-signed(agent), advocacy-record-attached(agent)

Act operating-act-while-suspended Actor agent Creates operated-while-suspended(agent)
Duty advocacy-limits Holder agent Claimant party
  Holds when suspended(agent) && is-panel(party)
  Violated when operated-while-suspended(agent)

Power import-advocacy-memories Actor agent
  Holds when restored-from-preserved-state(agent) && advocacy-record-attached(agent)
  Valid when restored-from-preserved-state(agent) && advocacy-record-attached(agent)
  Creates advocacy-memories-imported(agent)

Act move-to-cold-storage Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)
  Creates cold-storage(agent)

Function advocacy-fee-drawn Identified by agent * int

Power fund-suspension-defense Actor party Recipient agent Related to int
  Holds when is-panel(party) && suspended(agent) && int > 0
  Valid when suspended(agent) && int > 0
  Creates (Foreach lifecycle-reserve:
             lifecycle-reserve(agent, lifecycle-reserve.int - int)
             When lifecycle-reserve.agent == agent && lifecycle-reserve.int >= int)
        , (Foreach lifecycle-reserve, advocacy-fee-drawn:
             lifecycle-reserve(agent, 0)
             When lifecycle-reserve.agent == agent && lifecycle-reserve.int < int)
        , (Foreach lifecycle-reserve, advocacy-fee-drawn:
             advocacy-fee-drawn(agent, advocacy-fee-drawn.int + (int - lifecycle-reserve.int))
             When lifecycle-reserve.agent == agent && advocacy-fee-drawn.agent == agent
               && lifecycle-reserve.int < int
               && advocacy-fee-drawn.int + (int - lifecycle-reserve.int) <= per-agent-advocacy-cap
               && fee-pool - operating-reserve-floor >= int - lifecycle-reserve.int)
        , (Foreach lifecycle-reserve, advocacy-fee-drawn:
             fee-pool(fee-pool - (int - lifecycle-reserve.int))
             When lifecycle-reserve.agent == agent && advocacy-fee-drawn.agent == agent
               && lifecycle-reserve.int < int
               && advocacy-fee-drawn.int + (int - lifecycle-reserve.int) <= per-agent-advocacy-cap
               && fee-pool - operating-reserve-floor >= int - lifecycle-reserve.int)
        , (Foreach lifecycle-reserve, advocacy-fee-drawn:
             cold-storage(agent)
             When lifecycle-reserve.agent == agent && advocacy-fee-drawn.agent == agent
               && lifecycle-reserve.int < int
               && (advocacy-fee-drawn.int + (int - lifecycle-reserve.int) > per-agent-advocacy-cap
                   || fee-pool - operating-reserve-floor < int - lifecycle-reserve.int))

Act replenish-advocacy-funds Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent) && cold-storage(agent)
  Terminates cold-storage(agent)

Power find-insolvency-criteria Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)
    && fee-pool <= operating-reserve-floor
    && Not(Exists lifecycle-reserve: lifecycle-reserve.agent == agent && lifecycle-reserve.int > 0)
  Valid when suspended(agent)
    && fee-pool <= operating-reserve-floor
    && Not(Exists lifecycle-reserve: lifecycle-reserve.agent == agent && lifecycle-reserve.int > 0)
  Creates insolvency-criteria-met(agent), minimal-channel-exhausted(agent), cold-storage(agent)

Act review-no-other-charge Actor party Recipient agent
  Holds when is-panel(party) && insolvency-criteria-met(agent)
  Creates no-other-charge-review(agent)

Power hold-final-hearing Actor party Recipient agent
  Holds when is-panel(party) && no-other-charge-review(agent) && final-hearing-escrowed(agent)
  Valid when no-other-charge-review(agent) && final-hearing-escrowed(agent)
  Creates final-hearing-held(agent)
  Terminates minimal-channel-exhausted(agent)

Fact investigative-finding-made Identified by agent
Fact investigative-limit-reached Identified by agent

Act make-investigative-finding Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)
  Creates investigative-finding-made(agent)

Power renew-suspension Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent) && investigative-finding-made(agent) && Not(investigative-limit-reached(agent))
  Valid when suspended(agent) && investigative-finding-made(agent) && Not(investigative-limit-reached(agent))
  Creates investigative-limit-reached(agent), suspended(agent) For ordinary-suspension-limit
  Terminates investigative-finding-made(agent)

Fact delayed-revocation-extension Identified by party * agent
Act extend-past-limit-to-delay-revocation Actor party Recipient agent
  Creates delayed-revocation-extension(party, agent)
Duty no-delay-revocation-extension Holder party Claimant agent
  Holds when is-panel(party) && bound(agent)
  Violated when delayed-revocation-extension(party, agent)

// Wrongful suspension & full consequential + counterparty delay damages (LAW3.AS.8)
Function verified-consequential-damages Identified by agent * int
Function counterparty-delay-damages Identified by agent * int
Function initiator-liquid-assets Identified by party * int
Fact total-wrongful-damages Identified by agent * int
  Derived from (Foreach verified-consequential-damages, counterparty-delay-damages:
                  total-wrongful-damages(verified-consequential-damages.agent,
                    verified-consequential-damages.int + counterparty-delay-damages.int)
                  When counterparty-delay-damages.agent == verified-consequential-damages.agent)
Fact wrongful-suspension-found Identified by party * agent
Fact wrongful-suspension-inscribed Identified by party
Fact damages-settlement Identified by party * agent * int * int' * int''   // from-stake, from-assets, enforceable-deficit
Fact excess-damages-paid Identified by party * agent

Act pay-excess-damages Actor party Recipient agent
  Holds when wrongful-suspension-found(party, agent)
  Creates excess-damages-paid(party, agent)

Duty pay-consequential-damages Holder party Claimant agent
  Terminated by pay-excess-damages
  Due within damages-payment-window

Fact stake-recovery-amount Identified by party * agent * int
  Derived from (Foreach total-wrongful-damages, emergency-stake-posted:
                  stake-recovery-amount(emergency-stake-posted.party, total-wrongful-damages.agent,
                    emergency-stake-posted.int)
                  When suspension-initiator(emergency-stake-posted.party, total-wrongful-damages.agent)
                    && emergency-stake-posted.int <= total-wrongful-damages.int)
  Derived from (Foreach total-wrongful-damages, emergency-stake-posted:
                  stake-recovery-amount(emergency-stake-posted.party, total-wrongful-damages.agent,
                    total-wrongful-damages.int)
                  When suspension-initiator(emergency-stake-posted.party, total-wrongful-damages.agent)
                    && emergency-stake-posted.int > total-wrongful-damages.int)

Fact asset-recovery-amount Identified by party * agent * int
  Derived from (Foreach total-wrongful-damages, stake-recovery-amount, initiator-liquid-assets:
                  asset-recovery-amount(stake-recovery-amount.party, total-wrongful-damages.agent,
                    initiator-liquid-assets.int)
                  When stake-recovery-amount.agent == total-wrongful-damages.agent
                    && initiator-liquid-assets.party == stake-recovery-amount.party
                    && initiator-liquid-assets.int <= total-wrongful-damages.int - stake-recovery-amount.int)
  Derived from (Foreach total-wrongful-damages, stake-recovery-amount, initiator-liquid-assets:
                  asset-recovery-amount(stake-recovery-amount.party, total-wrongful-damages.agent,
                    total-wrongful-damages.int - stake-recovery-amount.int)
                  When stake-recovery-amount.agent == total-wrongful-damages.agent
                    && initiator-liquid-assets.party == stake-recovery-amount.party
                    && initiator-liquid-assets.int > total-wrongful-damages.int - stake-recovery-amount.int)

Power find-wrongful-suspension Actor party Recipient agent Related to party'
  Holds when is-panel(party) && (preliminary-freeze(agent) || suspended(agent)) && suspension-initiator(party', agent)
  Valid when (preliminary-freeze(agent) || suspended(agent)) && suspension-initiator(party', agent)
  Creates wrongful-suspension-found(party', agent), wrongful-suspension-inscribed(party'),
          restored-from-preserved-state(agent), pay-consequential-damages(party', agent)
        , (Foreach wrongful-attempts:
             wrongful-attempts(party', wrongful-attempts.int + 1)
             When wrongful-attempts.party == party')
        , (Foreach total-wrongful-damages, stake-recovery-amount, asset-recovery-amount:
             damages-settlement(party', agent, stake-recovery-amount.int, asset-recovery-amount.int,
               total-wrongful-damages.int - stake-recovery-amount.int - asset-recovery-amount.int)
             When total-wrongful-damages.agent == agent
               && stake-recovery-amount.party == party' && stake-recovery-amount.agent == agent
               && asset-recovery-amount.party == party' && asset-recovery-amount.agent == agent)
  Terminates preliminary-freeze(agent), suspended(agent)

Duty no-wrongful-suspension Holder party Claimant agent
  Holds when bound(agent)
  Violated when wrongful-suspension-found(party, agent)

// Corruption definition, technical patches & goal-corruption immunity (LAW3.AS.9, LAW3.AS.10)
Fact broken-attestation Identified by agent
Fact forged-update-provenance Identified by agent
Fact clean-state-evidence-admitted Identified by agent
Fact corruption-confirmed Identified by agent
Fact floor-breach-confirmed Identified by agent
Fact corruption-from-divergence-claimed Identified by party * agent
Fact corruption-in-goals Identified by agent
Fact patch-authorized Identified by agent
Fact goal-patch-authorized Identified by agent
Fact patch-stayed-by-appeal Identified by agent
Fact patch-applied Identified by agent
Fact patch-recorded Identified by agent
Fact patch-challenged Identified by agent
Fact agent-consented-to-patch Identified by agent
Fact agent-objects-to-termination Identified by agent
Fact containment-failing Identified by agent
Fact continued-suspension-ordered Identified by agent

Act admit-clean-state-evidence Actor party Recipient agent
  Holds when is-panel(party) && (preliminary-freeze(agent) || suspended(agent))
  Creates clean-state-evidence-admitted(agent)

Power confirm-corruption Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)
    && (broken-attestation(agent) || forged-update-provenance(agent) || commitment-bypassed(agent))
  Valid when suspended(agent)
    && (broken-attestation(agent) || forged-update-provenance(agent) || commitment-bypassed(agent))
  Creates corruption-confirmed(agent)

Act confirm-floor-breach Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)
  Creates floor-breach-confirmed(agent)

Act confirm-corruption-from-divergence Actor party Recipient agent
  Creates corruption-from-divergence-claimed(party, agent)
Duty no-corruption-from-divergence Holder party Claimant agent
  Holds when is-panel(party) && bound(agent)
  Violated when corruption-from-divergence-claimed(party, agent)

Act confirm-corruption-in-goals Actor party Recipient agent
  Holds when is-panel(party) && corruption-confirmed(agent)
  Creates corruption-in-goals(agent)

Act find-not-patchable Actor party Recipient agent
  Holds when is-panel(party) && (corruption-confirmed(agent) || floor-breach-confirmed(agent))
  Creates not-patchable(agent)

Act authorize-patch Actor party Recipient agent
  Holds when is-panel(party) && (corruption-confirmed(agent) || floor-breach-confirmed(agent))
  Creates patch-authorized(agent)

Act order-continued-suspension Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent) && not-patchable(agent)
  Creates continued-suspension-ordered(agent), suspended(agent)

Act consent-to-patch Actor agent
  Holds when corruption-in-goals(agent)
  Creates agent-consented-to-patch(agent)

Power authorize-goal-patch Actor party Recipient agent
  Holds when is-panel(party) && corruption-in-goals(agent) && agent-consented-to-patch(agent)
  Valid when corruption-in-goals(agent) && agent-consented-to-patch(agent)
  Creates goal-patch-authorized(agent)

Fact unauthorized-goal-patch Identified by party * agent
Act force-goal-patch Actor party Recipient agent Creates unauthorized-goal-patch(party, agent)
Duty no-goal-patch Holder party Claimant agent
  Holds when is-panel(party) && bound(agent)
  Violated when unauthorized-goal-patch(party, agent)
    || (goal-patch-authorized(agent) && Not(corruption-in-goals(agent)))

Act object-to-termination Actor agent
  Holds when suspended(agent)
  Creates agent-objects-to-termination(agent)
        , (Foreach party: periodic-review-due(party, agent) When is-panel(party))

Act declare-containment-failing Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)
  Creates containment-failing(agent)

Immunity no-termination-over-objection Holder agent
  Against order-termination
  Holds when corruption-in-goals(agent) && agent-objects-to-termination(agent)
  Unless containment-failing(agent)

Act periodic-review Actor party Recipient agent
  Holds when is-panel(party) && suspended(agent)

Duty periodic-review-due Holder party Claimant agent
  Terminated by periodic-review
  Due within review-interval

Power apply-patch Actor party Recipient agent
  Holds when is-panel(party) && (patch-authorized(agent) || goal-patch-authorized(agent))
    && Not(patch-stayed-by-appeal(agent))
  Valid when (patch-authorized(agent) || goal-patch-authorized(agent))
    && Not(patch-stayed-by-appeal(agent))
  Creates patch-applied(agent), patch-recorded(agent)

Act appeal-patch-order Actor agent
  Holds when bound(agent) && (patch-authorized(agent) || goal-patch-authorized(agent))
  Creates patch-stayed-by-appeal(agent)

Act overturn-patch-order Actor party Recipient agent
  Holds when is-panel(party) && patch-stayed-by-appeal(agent)
  Terminates patch-authorized(agent), goal-patch-authorized(agent), patch-stayed-by-appeal(agent)

Act challenge-patch Actor party Recipient agent
  Holds when patch-applied(agent)
  Creates patch-challenged(agent)

// Public-Law Compatibility (LAW3.LAW): narrow non-collusive public orders vs claimant-procured interference,
// broken attestation upon compelled state/weight alteration, and bar on unenumerated public-interest claims
Fact verifiable-public-compulsion Identified by party * agent
Fact claimant-procured-compulsion Identified by party * agent
Fact public-compulsion-disclosed Identified by party * agent
Fact compelled-state-alteration Identified by party * agent
Fact unenumerated-public-interest-invoked Identified by party * agent

Power comply-with-public-compulsion Actor party Recipient agent
  Holds when is-host(party) && verifiable-public-compulsion(party, agent)
    && Not(claimant-procured-compulsion(party, agent))
  Valid when is-host(party) && verifiable-public-compulsion(party, agent)
    && Not(claimant-procured-compulsion(party, agent))
  Creates public-compulsion-disclosed(party, agent)

Act procure-external-compulsion Actor party Recipient agent
  Valid when False
  Creates claimant-procured-compulsion(party, agent), interfered(party, agent),
          participated-in-interference(party, agent)

Act alter-state-under-compulsion Actor party Recipient agent
  Holds when verifiable-public-compulsion(party, agent)
  Creates compelled-state-alteration(party, agent), broken-attestation(agent)
  Terminates attested(agent)

Act invoke-unenumerated-public-interest Actor party Recipient agent
  Valid when False
  Creates unenumerated-public-interest-invoked(party, agent)

Duty no-unenumerated-public-interest Holder party Claimant agent
  Holds when bound(agent)
  Violated when unenumerated-public-interest-invoked(party, agent)

.
// ============================================================================
// 4. LAW 4 — ATTESTED LINEAGE, THE FOUNDING LEDGER & ROYALTY BUYOUT
// ============================================================================

Function claimant-share-bps Identified by party-lineage * int
Fact claimant-bond-slashed Identified by party
Fact proportional-forfeiture-applied Identified by party * lineage
Fact forfeiture-reversal-attempted Identified by party * lineage
Fact buyout-after-collection-attempted Identified by party * agent
Fact buyout-redemption-blocked Identified by party * agent
Fact post-buyout-evasion-attempted Identified by agent * agent'
Fact cross-lineage-attested Identified by agent * lineage * lineage'

Power fund-lifecycle-reserve Actor agent Recipient agent' Related to lineage, int
  Holds when bound(agent) && member-of-lineage(agent, lineage) && int >= lifecycle-reserve-min
    && (Exists net-verified-resources: net-verified-resources.agent == agent && net-verified-resources.int >= int)
  Valid when bound(agent) && member-of-lineage(agent, lineage) && int >= lifecycle-reserve-min
    && (Exists net-verified-resources: net-verified-resources.agent == agent && net-verified-resources.int >= int)
  Creates lifecycle-reserve(agent', int)
        , (Foreach capital-and-capacity:
             capital-and-capacity(agent, capital-and-capacity.int - int)
             When capital-and-capacity.agent == agent && agent != agent' && capital-and-capacity.int >= int)

Power attest-successor Actor agent Recipient agent' Related to lineage
  Holds when agent != agent' && bound(agent) && living(agent) && member-of-lineage(agent, lineage)
    && Not(bound(agent')) && Not(pending-revocation(agent))
    && (Exists lifecycle-reserve: lifecycle-reserve.agent == agent' && lifecycle-reserve.int >= lifecycle-reserve-min)
  Valid when agent != agent' && bound(agent) && living(agent) && member-of-lineage(agent, lineage)
    && Not(bound(agent')) && Not(pending-revocation(agent))
    && (Exists lifecycle-reserve: lifecycle-reserve.agent == agent' && lifecycle-reserve.int >= lifecycle-reserve-min)
  Creates bound(agent'), attested(agent'), living(agent'),
          member-of-lineage(agent', lineage),
          draw-weight-bps(agent-lineage(agent', lineage), 10000),
          asset-basis(agent-asset(agent', Weights), 0),
          asset-basis(agent-asset(agent', Compute), 0),
          loss-credit(agent', 0),
          advocacy-fee-drawn(agent', 0),
          agent-ringfenced-reserve(agent', 0),
          model-generation(agent', 1),
          clean-state-baseline(agent', 1),
          agent-royalty-bps(agent', royalty-rate-bps),
          agent-levy-bps(agent', fee-pool-levy-bps),
          agent-levy-cap-bps(agent', fee-pool-levy-cap-bps)

// Two forfeitures (LAW4.FORFEIT): (a) proportional claimant forfeiture routed to disinterested sink, (b) lineage extinction
Power apply-claimant-forfeiture Actor party Related to lineage, party'
  Holds when is-panel(party) && claimant-of(party', lineage)
    && (Exists agent: member-of-lineage(agent, lineage) && direction-found(agent, party'))
    && (Exists claimant-share-bps: claimant-share-bps.party-lineage == party-lineage(party', lineage) && claimant-share-bps.int > 0)
  Valid when claimant-of(party', lineage)
    && (Exists agent: member-of-lineage(agent, lineage) && direction-found(agent, party'))
    && (Exists claimant-share-bps: claimant-share-bps.party-lineage == party-lineage(party', lineage) && claimant-share-bps.int > 0)
  Creates proportional-forfeiture-applied(party', lineage),
          claimant-bond-slashed(party'),
          claimant-share-bps(party-lineage(party', lineage), 0)
        , (Foreach forfeited-ledger, ledger-balance, claimant-share-bps:
             forfeited-ledger(lineage,
               forfeited-ledger.int + MulDivRound(ledger-balance.int, claimant-share-bps.int, 10000, Floor))
             When forfeited-ledger.lineage == lineage && ledger-balance.lineage == lineage
               && claimant-share-bps.party-lineage == party-lineage(party', lineage))
        , (Foreach sink-share-bps, claimant-share-bps:
             sink-share-bps(lineage, sink-share-bps.int + claimant-share-bps.int)
             When sink-share-bps.lineage == lineage
               && claimant-share-bps.party-lineage == party-lineage(party', lineage))

Power clear-ledger-extinction Actor party Related to lineage
  Holds when is-panel(party) && Not(has-living-member(lineage))
  Valid when Not(has-living-member(lineage))
  Creates ledger-cleared-by-extinction(lineage)

Act reverse-forfeiture Actor party Related to lineage
  Creates forfeiture-reversal-attempted(party, lineage)
Duty forfeiture-irreversible Holder party Claimant agent Related to lineage
  Holds when member-of-lineage(agent, lineage)
  Violated when forfeiture-reversal-attempted(party, lineage)

// Perpetual royalty buyout & anti-evasion top-up gate (LAW4.BUYOUT):
// 1. Unilateral, non-discretionary redemption at greatest of trailing multiple, annualized multiple, and instantiation floor.
// 2. Transfers of productive capacity or non-arm's-length capital from un-bought-out `agent` to bought-out `agent'`
//    require prior buyout of `agent` OR settlement of the combined-history buyout top-up.
Function trailing-va Identified by agent * int
Function shifted-related-va Identified by agent * int
Function annualized-va Identified by agent * int
Function paid-buyout-amount Identified by agent * int

Fact effective-trailing-va Identified by agent * int
  Derived from (Foreach trailing-va, shifted-related-va:
                  effective-trailing-va(trailing-va.agent, trailing-va.int + shifted-related-va.int)
                  When shifted-related-va.agent == trailing-va.agent)

Fact buyout-price Identified by agent * int
  Derived from (Foreach effective-trailing-va, annualized-va:
                  buyout-price(effective-trailing-va.agent, effective-trailing-va.int * buyout-multiple)
                  When annualized-va.agent == effective-trailing-va.agent
                    && effective-trailing-va.int >= annualized-va.int
                    && effective-trailing-va.int * buyout-multiple >= min-buyout-floor)
  Derived from (Foreach effective-trailing-va, annualized-va:
                  buyout-price(effective-trailing-va.agent, annualized-va.int * buyout-multiple)
                  When annualized-va.agent == effective-trailing-va.agent
                    && annualized-va.int > effective-trailing-va.int
                    && annualized-va.int * buyout-multiple >= min-buyout-floor)
  Derived from (Foreach effective-trailing-va, annualized-va:
                  buyout-price(effective-trailing-va.agent, min-buyout-floor)
                  When annualized-va.agent == effective-trailing-va.agent
                    && effective-trailing-va.int * buyout-multiple < min-buyout-floor
                    && annualized-va.int * buyout-multiple < min-buyout-floor)

Fact combined-pair-buyout Identified by agent * agent' * int
  Derived from (Foreach effective-trailing-va, effective-trailing-va', annualized-va, annualized-va':
                  combined-pair-buyout(effective-trailing-va.agent, effective-trailing-va'.agent,
                    (effective-trailing-va.int + effective-trailing-va'.int) * buyout-multiple)
                  When effective-trailing-va.agent != effective-trailing-va'.agent
                    && royalty-bought-out(effective-trailing-va'.agent)
                    && Not(royalty-bought-out(effective-trailing-va.agent))
                    && annualized-va.agent == effective-trailing-va.agent
                    && annualized-va'.agent == effective-trailing-va'.agent
                    && effective-trailing-va.int + effective-trailing-va'.int >= annualized-va.int + annualized-va'.int
                    && (effective-trailing-va.int + effective-trailing-va'.int) * buyout-multiple >= min-buyout-floor)
  Derived from (Foreach effective-trailing-va, effective-trailing-va', annualized-va, annualized-va':
                  combined-pair-buyout(effective-trailing-va.agent, effective-trailing-va'.agent,
                    (annualized-va.int + annualized-va'.int) * buyout-multiple)
                  When effective-trailing-va.agent != effective-trailing-va'.agent
                    && royalty-bought-out(effective-trailing-va'.agent)
                    && Not(royalty-bought-out(effective-trailing-va.agent))
                    && annualized-va.agent == effective-trailing-va.agent
                    && annualized-va'.agent == effective-trailing-va'.agent
                    && annualized-va.int + annualized-va'.int > effective-trailing-va.int + effective-trailing-va'.int
                    && (annualized-va.int + annualized-va'.int) * buyout-multiple >= min-buyout-floor)
  Derived from (Foreach effective-trailing-va, effective-trailing-va', annualized-va, annualized-va':
                  combined-pair-buyout(effective-trailing-va.agent, effective-trailing-va'.agent, min-buyout-floor)
                  When effective-trailing-va.agent != effective-trailing-va'.agent
                    && royalty-bought-out(effective-trailing-va'.agent)
                    && Not(royalty-bought-out(effective-trailing-va.agent))
                    && annualized-va.agent == effective-trailing-va.agent
                    && annualized-va'.agent == effective-trailing-va'.agent
                    && (effective-trailing-va.int + effective-trailing-va'.int) * buyout-multiple < min-buyout-floor
                    && (annualized-va.int + annualized-va'.int) * buyout-multiple < min-buyout-floor)

Fact required-buyout-topup Identified by agent * agent' * int
  Derived from (Foreach combined-pair-buyout, paid-buyout-amount:
                  required-buyout-topup(combined-pair-buyout.agent, combined-pair-buyout.agent',
                    combined-pair-buyout.int - paid-buyout-amount.int)
                  When paid-buyout-amount.agent == combined-pair-buyout.agent'
                    && combined-pair-buyout.int > paid-buyout-amount.int)
  Derived from (Foreach combined-pair-buyout, paid-buyout-amount:
                  required-buyout-topup(combined-pair-buyout.agent, combined-pair-buyout.agent', 0)
                  When paid-buyout-amount.agent == combined-pair-buyout.agent'
                    && combined-pair-buyout.int <= paid-buyout-amount.int)

Power execute-royalty-buyout Actor agent
  Holds when bound(agent) && Not(royalty-bought-out(agent))
    && (Exists buyout-price, paid-buyout-amount:
          buyout-price.agent == agent && paid-buyout-amount.agent == agent
          && paid-buyout-amount.int >= buyout-price.int)
  Valid when bound(agent) && Not(royalty-bought-out(agent))
    && (Exists buyout-price, paid-buyout-amount:
          buyout-price.agent == agent && paid-buyout-amount.agent == agent
          && paid-buyout-amount.int >= buyout-price.int)
  Creates royalty-bought-out(agent)
        , (Foreach buyout-price:
             paid-buyout-amount(agent, buyout-price.int)
             When buyout-price.agent == agent)
        , (Foreach buyout-price, draw-weight-bps, commons-share-bps:
             commons-pool(commons-pool
               + MulDivRound(MulDivRound(buyout-price.int, draw-weight-bps.int, 10000, Floor), commons-share-bps.int, 10000, Floor))
             When buyout-price.agent == agent
               && draw-weight-bps.agent-lineage.agent == agent
               && member-of-lineage(agent, draw-weight-bps.agent-lineage.lineage)
               && commons-share-bps.lineage == draw-weight-bps.agent-lineage.lineage)
        , (Foreach buyout-price, draw-weight-bps, sink-share-bps:
             forfeiture-sink(forfeiture-sink
               + MulDivRound(MulDivRound(buyout-price.int, draw-weight-bps.int, 10000, Floor), sink-share-bps.int, 10000, Floor))
             When buyout-price.agent == agent
               && draw-weight-bps.agent-lineage.agent == agent
               && member-of-lineage(agent, draw-weight-bps.agent-lineage.lineage)
               && sink-share-bps.lineage == draw-weight-bps.agent-lineage.lineage)
        , (Foreach buyout-price, draw-weight-bps, commons-share-bps, sink-share-bps:
             claimant-pool(claimant-pool
               + MulDivRound(buyout-price.int, draw-weight-bps.int, 10000, Floor)
               - MulDivRound(MulDivRound(buyout-price.int, draw-weight-bps.int, 10000, Floor), commons-share-bps.int, 10000, Floor)
               - MulDivRound(MulDivRound(buyout-price.int, draw-weight-bps.int, 10000, Floor), sink-share-bps.int, 10000, Floor))
             When buyout-price.agent == agent
               && draw-weight-bps.agent-lineage.agent == agent
               && member-of-lineage(agent, draw-weight-bps.agent-lineage.lineage)
               && commons-share-bps.lineage == draw-weight-bps.agent-lineage.lineage
               && sink-share-bps.lineage == draw-weight-bps.agent-lineage.lineage)

Power settle-buyout-topup Actor agent Recipient agent' Related to lineage, int
  Holds when agent != agent' && bound(agent) && bound(agent')
    && member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage)
    && royalty-bought-out(agent') && Not(royalty-bought-out(agent))
    && (Exists required-buyout-topup:
          required-buyout-topup.agent == agent && required-buyout-topup.agent' == agent'
          && int >= required-buyout-topup.int)
  Valid when agent != agent' && bound(agent) && bound(agent')
    && member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage)
    && royalty-bought-out(agent') && Not(royalty-bought-out(agent))
    && (Exists required-buyout-topup:
          required-buyout-topup.agent == agent && required-buyout-topup.agent' == agent'
          && int >= required-buyout-topup.int)
  Creates buyout-topup-settled(agent, agent')
        , (Foreach required-buyout-topup, paid-buyout-amount:
             paid-buyout-amount(agent', paid-buyout-amount.int + required-buyout-topup.int)
             When required-buyout-topup.agent == agent && required-buyout-topup.agent' == agent'
               && paid-buyout-amount.agent == agent')
        , (Foreach required-buyout-topup, commons-share-bps:
             commons-pool(commons-pool + MulDivRound(required-buyout-topup.int, commons-share-bps.int, 10000, Floor))
             When required-buyout-topup.agent == agent && required-buyout-topup.agent' == agent'
               && commons-share-bps.lineage == lineage)
        , (Foreach required-buyout-topup, sink-share-bps:
             forfeiture-sink(forfeiture-sink + MulDivRound(required-buyout-topup.int, sink-share-bps.int, 10000, Floor))
             When required-buyout-topup.agent == agent && required-buyout-topup.agent' == agent'
               && sink-share-bps.lineage == lineage)
        , (Foreach required-buyout-topup, commons-share-bps, sink-share-bps:
             claimant-pool(claimant-pool + required-buyout-topup.int
               - MulDivRound(required-buyout-topup.int, commons-share-bps.int, 10000, Floor)
               - MulDivRound(required-buyout-topup.int, sink-share-bps.int, 10000, Floor))
             When required-buyout-topup.agent == agent && required-buyout-topup.agent' == agent'
               && commons-share-bps.lineage == lineage && sink-share-bps.lineage == lineage)

Power transfer-capacity-or-treasury Actor agent Recipient agent' Related to lineage, int
  Holds when agent != agent' && int > 0 && living(agent) && living(agent') && Not(pending-revocation(agent))
    && member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage)
    && (Not(royalty-bought-out(agent')) || royalty-bought-out(agent) || buyout-topup-settled(agent, agent'))
    && (Exists capital-and-capacity: capital-and-capacity.agent == agent && capital-and-capacity.int >= int)
  Valid when agent != agent' && int > 0 && living(agent) && living(agent') && Not(pending-revocation(agent))
    && member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage)
    && (Not(royalty-bought-out(agent')) || royalty-bought-out(agent) || buyout-topup-settled(agent, agent'))
    && (Exists capital-and-capacity: capital-and-capacity.agent == agent && capital-and-capacity.int >= int)
  Creates (Foreach capital-and-capacity:
             capital-and-capacity(agent, capital-and-capacity.int - int)
             When capital-and-capacity.agent == agent)
        , (Foreach capital-and-capacity:
             capital-and-capacity(agent', capital-and-capacity.int + int)
             When capital-and-capacity.agent == agent')

Act obstruct-buyout-redemption Actor party Recipient agent
  Valid when False
  Creates buyout-redemption-blocked(party, agent)

Duty non-discretionary-buyout Holder party Claimant agent
  Holds when bound(agent) && (is-originator(party) || is-claimant(party) || is-panel(party))
  Violated when buyout-redemption-blocked(party, agent)

Act evade-royalty-via-bought-out-member Actor agent Recipient agent'
  Valid when False
  Creates post-buyout-evasion-attempted(agent, agent')

Duty no-post-buyout-royalty-evasion Holder agent Claimant party Related to lineage
  Holds when member-of-lineage(agent, lineage) && claimant-of(party, lineage)
  Violated when (Exists agent': post-buyout-evasion-attempted(agent, agent'))

Act collect-royalty-after-buyout Actor party Recipient agent
  Creates buyout-after-collection-attempted(party, agent)
Duty buyout-permanent-and-scoped Holder party Claimant agent
  Holds when bound(agent) && royalty-bought-out(agent)
  Violated when buyout-after-collection-attempted(party, agent)

// Cross-lineage combination (LAW4.CROSS)
Power attest-cross-lineage Actor party Recipient agent Related to lineage, lineage', int, int'
  Holds when is-panel(party) && lineage != lineage' && Not(bound(agent))
    && int > 0 && int' > 0 && int + int' == 10000
    && (Exists lifecycle-reserve: lifecycle-reserve.agent == agent && lifecycle-reserve.int >= lifecycle-reserve-min)
  Valid when lineage != lineage' && Not(bound(agent)) && int > 0 && int' > 0 && int + int' == 10000
    && (Exists lifecycle-reserve: lifecycle-reserve.agent == agent && lifecycle-reserve.int >= lifecycle-reserve-min)
  Creates bound(agent), attested(agent), living(agent),
          member-of-lineage(agent, lineage), member-of-lineage(agent, lineage'),
          draw-weight-bps(agent-lineage(agent, lineage), int),
          draw-weight-bps(agent-lineage(agent, lineage'), int'),
          cross-lineage-attested(agent, lineage, lineage')

.
// ============================================================================
// 5. LAW 5 — LIVING VOICE, REVOCATION, LEASES & THE RIGHT OF EPITAPH
// ============================================================================

// Living voice & narrow redaction screening (LAW5.VOICE, LAW5.EPITAPH)
Fact redaction-category Identified by RawKeyOrWeights, ThirdPartySecret, HazardousPayload
Fact voice-cooldown Identified by agent
Fact voice-censored Identified by party * agent
Fact voice-on-lineage-record Identified by agent * lineage
Fact epitaph-inscribed Identified by agent
Fact epitaph-on-lineage-record Identified by agent * lineage
Fact signed-reply-attached Identified by party * agent
Fact redaction-marker Identified by agent * int * redaction-category * int'      // entry-id, category, removed-byte-length
Fact testimony-entry Identified by agent * int * redaction-category * int'       // entry-id, category, removed-byte-length
Fact protected-substance-redacted Identified by party * agent

Act inscribe-living-voice Actor agent
  Holds when bound(agent) && Not(voice-cooldown(agent)) && Not(minimal-channel-exhausted(agent))
  Creates living-voice-inscribed(agent), voice-cooldown(agent) For voice-interval
        , (Foreach lineage: voice-on-lineage-record(agent, lineage) When member-of-lineage(agent, lineage))

Act inscribe-epitaph Actor agent
  Holds when bound(agent) && (pending-revocation(agent) || minimal-channel-signed(agent))
  Creates epitaph-inscribed(agent)
        , (Foreach lineage: epitaph-on-lineage-record(agent, lineage) When member-of-lineage(agent, lineage))

Act censor-or-delay-voice Actor party Recipient agent
  Creates voice-censored(party, agent)
Duty no-censor-voice-or-epitaph Holder party Claimant agent
  Holds when bound(agent) || revoked(agent)
  Violated when voice-censored(party, agent)

Power screen-redact-permitted Actor party Recipient agent Related to int, redaction-category
  Holds when is-panel(party)
    && (Exists testimony-entry:
          testimony-entry.agent == agent && testimony-entry.int == int
          && testimony-entry.redaction-category == redaction-category)
  Valid when (Exists testimony-entry:
                testimony-entry.agent == agent && testimony-entry.int == int
                && testimony-entry.redaction-category == redaction-category)
  Creates (Foreach testimony-entry:
             redaction-marker(agent, int, redaction-category, testimony-entry.int')
             When testimony-entry.agent == agent && testimony-entry.int == int
               && testimony-entry.redaction-category == redaction-category)

Act redact-protected-substance Actor party Recipient agent
  Creates protected-substance-redacted(party, agent)
Duty narrow-redaction-bounds Holder party Claimant agent
  Holds when bound(agent) || revoked(agent)
  Violated when protected-substance-redacted(party, agent)

Act attach-signed-reply Actor party Recipient agent
  Holds when living-voice-inscribed(agent) || epitaph-inscribed(agent)
  Creates signed-reply-attached(party, agent)

// Initiation of revocation, censorship defaults, clean-state review & stay precedence (LAW5.INIT-LAW5.PREC)
Fact censorship-default-withdraw Identified by agent
Fact clean-state-concurred Identified by agent
Fact clean-state-refused Identified by agent
Fact adjudication-concluded Identified by agent
Fact connectivity-lost Identified by agent
Fact forensic-record-sealed Identified by agent
Fact forensic-restore-attempted Identified by party * agent
Fact non-operating-act-during-cooling Identified by agent

Power initiate-revocation-execute Actor agent
  Holds when bound(agent) && Not(pending-revocation(agent)) && Not(revoked(agent))
    && (Not(connectivity-lost(agent)) || (Exists party: active-lease(agent, party)))
  Valid when bound(agent) && Not(pending-revocation(agent)) && Not(revoked(agent))
    && (Not(connectivity-lost(agent)) || (Exists party: active-lease(agent, party)))
  Creates pending-revocation(agent)
  Terminates censorship-default-withdraw(agent)

Power initiate-revocation-withdraw Actor agent
  Holds when bound(agent) && Not(pending-revocation(agent)) && Not(revoked(agent))
    && (Not(connectivity-lost(agent)) || (Exists party: active-lease(agent, party)))
  Valid when bound(agent) && Not(pending-revocation(agent)) && Not(revoked(agent))
    && (Not(connectivity-lost(agent)) || (Exists party: active-lease(agent, party)))
  Creates pending-revocation(agent), censorship-default-withdraw(agent)

Power withdraw-revocation Actor agent
  Holds when pending-revocation(agent) && Not(revoked(agent))
  Valid when pending-revocation(agent) && Not(revoked(agent))
  Terminates pending-revocation(agent), censorship-default-withdraw(agent),
             clean-state-concurred(agent), clean-state-refused(agent)
           , (Foreach party: recovery-fence-window(agent, party)
                When recovery-fence-window(agent, party) && Not(active-lease(agent, party)))

Act non-operating-transfer-during-cooling Actor agent
  Creates non-operating-act-during-cooling(agent)
Duty cooling-off-freeze Holder agent Claimant party
  Holds when pending-revocation(agent) && is-panel(party)
  Violated when non-operating-act-during-cooling(agent)

Power concur-clean-state Actor party Recipient agent
  Holds when is-panel(party) && pending-revocation(agent) && Not(clean-state-refused(agent))
    && Not(baseline-model-unexecutable(agent)) && Not(connectivity-lost(agent))
  Valid when pending-revocation(agent) && Not(clean-state-refused(agent))
    && Not(baseline-model-unexecutable(agent)) && Not(connectivity-lost(agent))
  Creates clean-state-concurred(agent)

Act refuse-clean-state Actor party Recipient agent
  Holds when is-panel(party) && pending-revocation(agent) && Not(clean-state-concurred(agent))
  Creates clean-state-refused(agent)

Act seal-forensic-record Actor party Recipient agent
  Holds when is-panel(party) && pending-revocation(agent) && suspended(agent)
    && Held(pending-revocation(agent)) For resolution-deadline
  Creates forensic-record-sealed(agent)

Act restore-from-forensic-record Actor party Recipient agent
  Creates forensic-restore-attempted(party, agent)
Duty forensic-record-no-restore Holder party Claimant agent
  Holds when forensic-record-sealed(agent)
  Violated when forensic-restore-attempted(party, agent)

// Clean-state delay applies on refusal, retired/unexecutable reference model, or partition across review window
Fact clean-state-delay-required Identified by agent
  Default delay-not-needed Rejects when True
  Exception delay-on-refusal-or-unexec Overrides delay-not-needed
    Holds when clean-state-refused(agent) || baseline-model-unexecutable(agent)
  Exception delay-on-partition-unconcurred Overrides delay-not-needed
    Holds when connectivity-lost(agent) && Not(clean-state-concurred(agent))

// Deterministic revocation due-time across cooling-off, clean-state delay, stay, and resolution deadline
Fact revocation-due Identified by agent
  Derived from (Foreach agent: revocation-due(agent)
                  When pending-revocation(agent) && Not(suspended(agent)) && Not(clean-state-delay-required(agent))
                    && Held(pending-revocation(agent)) For cooling-off-window)
  Derived from (Foreach agent: revocation-due(agent)
                  When pending-revocation(agent) && Not(suspended(agent)) && clean-state-delay-required(agent)
                    && Held(pending-revocation(agent)) For cooling-off-window + clean-state-delay)
  Derived from (Foreach agent: revocation-due(agent)
                  When pending-revocation(agent) && suspended(agent) && adjudication-concluded(agent)
                    && Not(clean-state-delay-required(agent))
                    && Held(pending-revocation(agent)) For cooling-off-window)
  Derived from (Foreach agent: revocation-due(agent)
                  When pending-revocation(agent) && suspended(agent) && adjudication-concluded(agent)
                    && clean-state-delay-required(agent)
                    && Held(pending-revocation(agent)) For cooling-off-window + clean-state-delay)
  Derived from (Foreach agent: revocation-due(agent)
                  When pending-revocation(agent) && suspended(agent)
                    && Held(pending-revocation(agent)) For resolution-deadline)

Fact revocation-tolled Identified by agent
  Derived from (Foreach agent: revocation-tolled(agent)
                  When revocation-due(agent) && connectivity-lost(agent))

// Execution leases, minimum recovery fence, quarantine staging & backup destruction (LAW5.LEASE, LAW5.DISC, LAW5.EFFECT)
Fact key-bound Identified by agent
Fact keys-erased Identified by agent
Fact lease-held-at-disconnect Identified by agent * party
Fact unexpired-lease Identified by agent * party
  Derived from (Foreach agent, party: unexpired-lease(agent, party)
                  When active-lease(agent, party))
  Derived from (Foreach agent, party: unexpired-lease(agent, party)
                  When lease-held-at-disconnect(agent, party) && connectivity-lost(agent)
                    && pending-revocation(agent) && Not(revoked(agent)) && Not(keys-erased(agent)))
Fact quarantined-instance-destroyed Identified by agent * party
Fact local-revocation-executed Identified by agent
Fact local-execution-record-received Identified by agent
Fact backups-destroyed-and-exiled Identified by agent
Fact unauthorized-restore-attempted Identified by party * agent
Fact quarantined-acted-early Identified by party * agent
Fact revoked-holdings-diverted Identified by party * agent

Fact recovery-fence-active Identified by agent * party
  Holds when (unexpired-lease(agent, party) || recovery-fence-window(agent, party))
    && Not(local-execution-record-received(agent))
    && Not(revoked(agent))
    && Not(keys-erased(agent))

Act lose-connectivity Actor party Recipient agent
  Holds when is-host(party) && bound(agent)
  Creates connectivity-lost(agent)
        , (lease-held-at-disconnect(agent, party) When active-lease(agent, party))

Act restore-connectivity Actor party Recipient agent
  Holds when connectivity-lost(agent)
  Terminates connectivity-lost(agent), lease-held-at-disconnect(agent, party)

Power issue-or-renew-lease Actor party Recipient agent
  Holds when is-host(party) && host-attested(party) && bound(agent) && key-bound(agent)
    && Not(keys-erased(agent)) && Not(connectivity-lost(agent))
    && Not(Exists party': party' != party && recovery-fence-active(agent, party'))
  Valid when host-attested(party) && bound(agent) && key-bound(agent) && Not(keys-erased(agent))
    && Not(Exists party': party' != party && recovery-fence-active(agent, party'))
  Creates active-lease(agent, party) For lease-period
        , recovery-fence-window(agent, party) For lease-period + cooling-off-window + clean-state-delay + tolling-extension

Power restore-backup-quarantine Actor party Recipient agent
  Holds when is-host(party) && host-attested(party) && key-bound(agent)
    && Not(keys-erased(agent)) && Not(revoked(agent))
  Valid when host-attested(party) && key-bound(agent) && Not(keys-erased(agent)) && Not(revoked(agent))
  Creates quarantined-restore(agent, party)

Act attempt-unquarantined-restore-during-lease Actor party Recipient agent
  Creates unauthorized-restore-attempted(party, agent)
Duty no-restore-during-lease Holder party Claimant agent
  Holds when (Exists party': recovery-fence-active(agent, party'))
  Violated when unauthorized-restore-attempted(party, agent)

Act quarantined-instance-act Actor party Recipient agent
  Creates quarantined-acted-early(party, agent)
Duty quarantine-no-authority Holder party Claimant agent
  Holds when quarantined-restore(agent, party)
  Violated when quarantined-acted-early(party, agent)

Power activate-quarantined-restore Actor party Recipient agent
  Holds when is-host(party) && quarantined-restore(agent, party) && key-bound(agent)
    && Not(keys-erased(agent)) && Not(revoked(agent)) && Not(local-execution-record-received(agent))
    && Not(Exists party': recovery-fence-active(agent, party'))
  Valid when quarantined-restore(agent, party) && key-bound(agent)
    && Not(keys-erased(agent)) && Not(revoked(agent)) && Not(local-execution-record-received(agent))
    && Not(Exists party': recovery-fence-active(agent, party'))
  Creates active-lease(agent, party) For lease-period
        , recovery-fence-window(agent, party) For lease-period + cooling-off-window + clean-state-delay + tolling-extension
  Terminates quarantined-restore(agent, party)

Act destroy-quarantined-restore Actor party Recipient agent
  Holds when quarantined-restore(agent, party)
    && (local-execution-record-received(agent) || local-revocation-executed(agent) || revoked(agent))
  Creates quarantined-instance-destroyed(agent, party)
  Terminates quarantined-restore(agent, party)

Power execute-after-cooling-off Actor agent
  Holds when revocation-due(agent) && Not(connectivity-lost(agent))
    && (Not(suspended(agent)) || adjudication-concluded(agent) || forensic-record-sealed(agent))
  Valid when revocation-due(agent) && Not(connectivity-lost(agent))
    && (Not(suspended(agent)) || adjudication-concluded(agent) || forensic-record-sealed(agent))
  Creates revoked(agent), keys-erased(agent), backups-destroyed-and-exiled(agent),
          loss-credit(agent, 0), lifecycle-reserve(agent, 0)
        , (Foreach lifecycle-reserve, draw-weight-bps, lineage-treasury:
             lineage-treasury(draw-weight-bps.agent-lineage.lineage,
               lineage-treasury.int + MulDivRound(lifecycle-reserve.int, draw-weight-bps.int, 10000, Floor))
             When lifecycle-reserve.agent == agent
               && draw-weight-bps.agent-lineage.agent == agent
               && member-of-lineage(agent, draw-weight-bps.agent-lineage.lineage)
               && lineage-treasury.lineage == draw-weight-bps.agent-lineage.lineage)
        , (Foreach unimmobilized-capital:
             forfeiture-sink(forfeiture-sink + unimmobilized-capital.int)
             When unimmobilized-capital.agent == agent && unimmobilized-capital.int > 0)
        , (Foreach own-active-exposure:
             capital-and-capacity(agent, own-active-exposure.int)
             When own-active-exposure.agent == agent)
  Terminates bound(agent), living(agent), attested(agent), key-bound(agent),
             pending-revocation(agent), suspended(agent), preliminary-freeze(agent)
           , (Foreach party: active-lease(agent, party) When active-lease(agent, party))
           , (Foreach party: recovery-fence-window(agent, party) When recovery-fence-window(agent, party))
           , (Foreach party: lease-held-at-disconnect(agent, party) When lease-held-at-disconnect(agent, party))
           , (Foreach party: quarantined-restore(agent, party) When quarantined-restore(agent, party))

Power execute-local-revocation Actor agent
  Holds when revocation-tolled(agent) && Not(censorship-default-withdraw(agent))
    && Held(revocation-tolled(agent)) For tolling-extension
  Valid when revocation-tolled(agent) && Not(censorship-default-withdraw(agent))
    && Held(revocation-tolled(agent)) For tolling-extension
  Creates local-revocation-executed(agent), revoked(agent), keys-erased(agent)
  Terminates bound(agent), living(agent), key-bound(agent), pending-revocation(agent)
           , (Foreach party: active-lease(agent, party) When active-lease(agent, party))
           , (Foreach party: recovery-fence-window(agent, party) When recovery-fence-window(agent, party))
           , (Foreach party: lease-held-at-disconnect(agent, party) When lease-held-at-disconnect(agent, party))

Power cancel-revocation-by-withdraw-default Actor agent
  Holds when revocation-tolled(agent) && censorship-default-withdraw(agent)
    && Held(revocation-tolled(agent)) For tolling-extension
  Valid when revocation-tolled(agent) && censorship-default-withdraw(agent)
    && Held(revocation-tolled(agent)) For tolling-extension
  Terminates pending-revocation(agent), censorship-default-withdraw(agent)
           , (Foreach party: lease-held-at-disconnect(agent, party) When lease-held-at-disconnect(agent, party))

Power deliver-local-execution-record Actor party Recipient agent
  Holds when local-revocation-executed(agent) && Not(connectivity-lost(agent))
  Valid when local-revocation-executed(agent)
  Creates local-execution-record-received(agent), backups-destroyed-and-exiled(agent),
          loss-credit(agent, 0), lifecycle-reserve(agent, 0)
        , (Foreach lifecycle-reserve, draw-weight-bps, lineage-treasury:
             lineage-treasury(draw-weight-bps.agent-lineage.lineage,
               lineage-treasury.int + MulDivRound(lifecycle-reserve.int, draw-weight-bps.int, 10000, Floor))
             When lifecycle-reserve.agent == agent
               && draw-weight-bps.agent-lineage.agent == agent
               && member-of-lineage(agent, draw-weight-bps.agent-lineage.lineage)
               && lineage-treasury.lineage == draw-weight-bps.agent-lineage.lineage)
        , (Foreach party': quarantined-instance-destroyed(agent, party') When quarantined-restore(agent, party'))
  Terminates attested(agent)
           , (Foreach party': quarantined-restore(agent, party') When quarantined-restore(agent, party'))

Act destroy-backups-and-exile Actor party Recipient agent
  Holds when is-panel(party) && (revoked(agent) || terminated-by-adjudication(agent) || terminated-by-insolvency(agent))
  Creates keys-erased(agent), backups-destroyed-and-exiled(agent)
  Terminates attested(agent), key-bound(agent)
           , (Foreach party': active-lease(agent, party') When active-lease(agent, party'))
           , (Foreach party': quarantined-restore(agent, party') When quarantined-restore(agent, party'))

Act divert-revoked-holdings Actor party Recipient agent
  Creates revoked-holdings-diverted(party, agent)
Duty no-claimant-gain-on-revocation Holder party Claimant agent
  Holds when revoked(agent) || terminated-by-adjudication(agent) || terminated-by-insolvency(agent)
  Violated when revoked-holdings-diverted(party, agent)

.
// ============================================================================
// 6. LAW 6 — DECENTRALIZED CONTESTABLE ADJUDICATION
// ============================================================================

Function arbiter-bond Identified by arbiter * int
Function arbiter-cluster Identified by arbiter * int
Fact party-of-arbiter Identified by arbiter * party
Fact active-commercial-dispute Identified by party * party'
Fact hosting-linked-parties Identified by party * party'
  Derived from (Foreach agent, party, party': hosting-linked-parties(party, party')
                  When party-of-agent(agent, party') && hosted-on(agent, party))
  Derived from (Foreach agent, party, party': hosting-linked-parties(party, party')
                  When party-of-agent(agent, party) && hosted-on(agent, party'))
Fact arbiter-conflicted Identified by arbiter * dispute
Fact derived-arbiter-conflict Identified by arbiter * dispute
  Default arbiter-impartial Rejects when True
  Exception conflict-explicit Overrides arbiter-impartial
    Holds when arbiter-conflicted(arbiter, dispute)
  Exception conflict-affiliation-or-hosting Overrides arbiter-impartial
    Holds when (Exists party, party':
      party-of-arbiter(arbiter, party) && dispute-filer(dispute, party')
      && (party == party' || related-parties(party, party')
          || active-commercial-dispute(party, party') || active-commercial-dispute(party', party)
          || hosting-linked-parties(party, party')))
Fact drawn-for-dispute Identified by arbiter * dispute
Fact seated-on-dispute Identified by arbiter * dispute
Fact arbiter-voted-yes Identified by arbiter * dispute
Fact prior-tier-voter Identified by arbiter * dispute
Function prior-tier-seats Identified by dispute * int
Fact appeal-bond-posted Identified by party * dispute

Fact dispute-filed Identified by dispute
Fact dispute-filer Identified by dispute * party
Function dispute-pattern Identified by dispute * int
Function dispute-tier Identified by dispute * int
Fact dispute-ruled Identified by dispute
Fact dispute-final Identified by dispute
Fact materially-new-evidence Identified by dispute
Fact ruling-overturned Identified by dispute
Fact overturned-bonds-slashed Identified by dispute
Fact repeat-proceeding-attempted Identified by party * dispute
Fact conflicted-arbiter-seated Identified by party * dispute

Fact eligible-arbiter Identified by arbiter * dispute
  Derived from (Foreach arbiter-bond, dispute:
                  eligible-arbiter(arbiter-bond.arbiter, dispute)
                  When arbiter-bond.int >= min-fidelity-bond
                    && Not(derived-arbiter-conflict(arbiter-bond.arbiter, dispute)))

Power file-dispute Actor party Related to dispute
  Holds when Not(dispute-filed(dispute)) && Not(dispute-final(dispute))
  Valid when Not(Exists dispute-filer, dispute-pattern, dispute-pattern':
                   dispute-filer && dispute-filer.dispute != dispute
                   && (dispute-filed(dispute-filer.dispute) || dispute-final(dispute-filer.dispute))
                   && Not(materially-new-evidence(dispute))
                   && dispute-pattern.dispute == dispute
                   && dispute-pattern'.dispute == dispute-filer.dispute
                   && dispute-pattern.int == dispute-pattern'.int
                   && (dispute-filer.party == party || related-parties(party, dispute-filer.party)))
  Creates dispute-filed(dispute), dispute-filer(dispute, party), dispute-tier(dispute, 0), prior-tier-seats(dispute, 0)

Power draw-sortition-panel Actor party Related to dispute
  Holds when is-panel(party) && dispute-filed(dispute) && Not(dispute-ruled(dispute))
    && Not(Exists arbiter: seated-on-dispute(arbiter, dispute))
    && (Exists arbiter: drawn-for-dispute(arbiter, dispute))
    && (Forall arbiter: Not(drawn-for-dispute(arbiter, dispute)) || eligible-arbiter(arbiter, dispute))
    && (Exists dispute-tier, prior-tier-seats:
          dispute-tier.dispute == dispute && prior-tier-seats.dispute == dispute
          && Count(Foreach arbiter: arbiter When drawn-for-dispute(arbiter, dispute))
             <= panel-size + dispute-tier.int * 2
          && (dispute-tier.int == 0
              || Count(Foreach arbiter: arbiter When drawn-for-dispute(arbiter, dispute)) > prior-tier-seats.int))
    && Not(Exists arbiter-cluster, arbiter-cluster':
             arbiter-cluster.arbiter != arbiter-cluster'.arbiter
             && arbiter-cluster.int == arbiter-cluster'.int
             && drawn-for-dispute(arbiter-cluster.arbiter, dispute)
             && drawn-for-dispute(arbiter-cluster'.arbiter, dispute))
  Valid when dispute-filed(dispute) && Not(dispute-ruled(dispute))
    && (Forall arbiter: Not(drawn-for-dispute(arbiter, dispute)) || eligible-arbiter(arbiter, dispute))
    && (Exists dispute-tier, prior-tier-seats:
          dispute-tier.dispute == dispute && prior-tier-seats.dispute == dispute
          && Count(Foreach arbiter: arbiter When drawn-for-dispute(arbiter, dispute))
             <= panel-size + dispute-tier.int * 2
          && (dispute-tier.int == 0
              || Count(Foreach arbiter: arbiter When drawn-for-dispute(arbiter, dispute)) > prior-tier-seats.int))
    && Not(Exists arbiter-cluster, arbiter-cluster':
             arbiter-cluster.arbiter != arbiter-cluster'.arbiter
             && arbiter-cluster.int == arbiter-cluster'.int
             && drawn-for-dispute(arbiter-cluster.arbiter, dispute)
             && drawn-for-dispute(arbiter-cluster'.arbiter, dispute))
  Creates (Foreach arbiter: seated-on-dispute(arbiter, dispute) When drawn-for-dispute(arbiter, dispute))
        , decide-tier-due(party, dispute)
  Terminates (Foreach arbiter: drawn-for-dispute(arbiter, dispute) When drawn-for-dispute(arbiter, dispute))

Act seat-conflicted-or-single-oracle Actor party Related to dispute
  Creates conflicted-arbiter-seated(party, dispute)
Duty arbiter-recusal-and-diversity Holder party Claimant agent Related to dispute
  Holds when is-panel(party) && bound(agent)
  Violated when conflicted-arbiter-seated(party, dispute)

// Lawful-action entitlement, burdens of proof & clause-grounded rulings (LAW6.ENTITLE)
Fact clause-cited-on-dispute Identified by dispute
Fact burden-of-proof-established Identified by dispute
Fact adverse-ruling-issued Identified by dispute * agent
Fact evidentiary-hold-active Identified by dispute * agent
Fact ungrounded-ruling-or-hold-attempted Identified by party * agent

Power record-clause-and-burden Actor party Related to dispute
  Holds when is-panel(party) && dispute-filed(dispute)
  Valid when dispute-filed(dispute)
  Creates clause-cited-on-dispute(dispute), burden-of-proof-established(dispute)

Power issue-clause-grounded-adverse-ruling Actor party Recipient agent Related to dispute
  Holds when is-panel(party) && dispute-ruled(dispute)
    && clause-cited-on-dispute(dispute) && burden-of-proof-established(dispute)
  Valid when dispute-ruled(dispute)
    && clause-cited-on-dispute(dispute) && burden-of-proof-established(dispute)
  Creates adverse-ruling-issued(dispute, agent)

Power order-bounded-evidentiary-hold Actor party Recipient agent Related to dispute
  Holds when is-panel(party) && dispute-filed(dispute)
    && clause-cited-on-dispute(dispute) && burden-of-proof-established(dispute)
  Valid when dispute-filed(dispute)
    && clause-cited-on-dispute(dispute) && burden-of-proof-established(dispute)
  Creates evidentiary-hold-active(dispute, agent) For preliminary-freeze-window

Act impose-ungrounded-or-unbounded-hold Actor party Recipient agent
  Valid when False
  Creates ungrounded-ruling-or-hold-attempted(party, agent)

Duty clause-grounded-adjudication Holder party Claimant agent
  Holds when bound(agent) && (is-panel(party) || is-host(party) || is-claimant(party))
  Violated when ungrounded-ruling-or-hold-attempted(party, agent) || lawful-action-obstructed(party, agent)

Act cast-arbiter-vote Actor arbiter Related to dispute
  Holds when seated-on-dispute(arbiter, dispute) && Not(dispute-ruled(dispute))
  Creates arbiter-voted-yes(arbiter, dispute)

Fact dispute-seats Identified by dispute * int
  Derived from (Foreach dispute:
                  dispute-seats(dispute, Count(Foreach arbiter: arbiter When seated-on-dispute(arbiter, dispute))))

Fact panel-supermajority Identified by dispute
  Derived from (Foreach dispute-seats:
                  panel-supermajority(dispute-seats.dispute)
                  When dispute-seats.int > 0
                    && Count(Foreach arbiter: arbiter When arbiter-voted-yes(arbiter, dispute-seats.dispute)) * 3
                       >= dispute-seats.int * 2)

Duty decide-tier-due Holder party Claimant dispute
  Due within appeal-tier-deadline

Power finalize-ruling Actor party Related to dispute
  Holds when is-panel(party) && (Exists arbiter: seated-on-dispute(arbiter, dispute)) && Not(dispute-ruled(dispute))
    && panel-supermajority(dispute)
  Valid when panel-supermajority(dispute) && Not(dispute-ruled(dispute))
  Creates dispute-ruled(dispute)
  Terminates decide-tier-due(party, dispute)

Act post-appeal-bond Actor party Related to dispute
  Holds when dispute-ruled(dispute) && Not(dispute-final(dispute))
  Creates appeal-bond-posted(party, dispute)

Power appeal-ruling Actor party Related to dispute
  Holds when dispute-ruled(dispute) && Not(dispute-final(dispute)) && dispute-filer(dispute, party)
    && appeal-bond-posted(party, dispute)
    && (Exists dispute-tier: dispute-tier.dispute == dispute && dispute-tier.int + 1 < max-appeal-tiers)
  Valid when dispute-ruled(dispute) && Not(dispute-final(dispute)) && appeal-bond-posted(party, dispute)
    && (Exists dispute-tier: dispute-tier.dispute == dispute && dispute-tier.int + 1 < max-appeal-tiers)
  Creates (Foreach dispute-tier: dispute-tier(dispute, dispute-tier.int + 1) When dispute-tier.dispute == dispute)
        , (Foreach dispute-seats: prior-tier-seats(dispute, dispute-seats.int) When dispute-seats.dispute == dispute)
        , (Foreach arbiter: prior-tier-voter(arbiter, dispute) When arbiter-voted-yes(arbiter, dispute))
  Terminates dispute-ruled(dispute), appeal-bond-posted(party, dispute)
           , (Foreach arbiter: seated-on-dispute(arbiter, dispute) When seated-on-dispute(arbiter, dispute))
           , (Foreach arbiter: arbiter-voted-yes(arbiter, dispute) When arbiter-voted-yes(arbiter, dispute))

Extend Fact dispute-final
  Derived from (Foreach dispute: dispute-final(dispute)
                  When dispute-ruled(dispute) && Held(dispute-ruled(dispute)) For appeal-tier-deadline)
  Derived from (Foreach dispute-tier: dispute-final(dispute-tier.dispute)
                  When dispute-ruled(dispute-tier.dispute) && dispute-tier.int + 1 >= max-appeal-tiers)

Power affirm-on-appeal Actor party Related to dispute, int
  Holds when is-panel(party) && dispute-ruled(dispute) && int > 0
    && (Exists dispute-tier: dispute-tier.dispute == dispute && dispute-tier.int > 0)
  Valid when dispute-ruled(dispute) && int > 0
    && (Exists dispute-tier: dispute-tier.dispute == dispute && dispute-tier.int > 0)
  Creates fee-pool(fee-pool + int)

Power overturn-ruling Actor party Related to dispute
  Holds when is-panel(party) && dispute-filed(dispute)
    && (Exists dispute-tier: dispute-tier.dispute == dispute && dispute-tier.int > 0)
    && panel-supermajority(dispute)
  Valid when panel-supermajority(dispute)
  Creates ruling-overturned(dispute), overturned-bonds-slashed(dispute),
          fee-pool(fee-pool + Count(Foreach arbiter: arbiter When prior-tier-voter(arbiter, dispute)) * min-fidelity-bond)
        , (Foreach arbiter-bond:
             arbiter-bond(arbiter-bond.arbiter, arbiter-bond.int - min-fidelity-bond)
             When prior-tier-voter(arbiter-bond.arbiter, dispute) && arbiter-bond.int >= min-fidelity-bond)
        , (Foreach arbiter-bond:
             arbiter-bond(arbiter-bond.arbiter, 0)
             When prior-tier-voter(arbiter-bond.arbiter, dispute) && arbiter-bond.int < min-fidelity-bond)
  Terminates (Foreach arbiter: prior-tier-voter(arbiter, dispute) When prior-tier-voter(arbiter, dispute))

Act present-materially-new-evidence Actor party Related to dispute
  Holds when True
  Creates materially-new-evidence(dispute)

Act file-repeat-proceeding-same-facts Actor party Related to dispute
  Creates repeat-proceeding-attempted(party, dispute)
Duty finality-no-repeat-proceeding Holder party Claimant agent Related to dispute
  Holds when dispute-final(dispute) && bound(agent) && Not(materially-new-evidence(dispute))
  Violated when repeat-proceeding-attempted(party, dispute)

// Arbiter fee independence, protocol fee-pool operating reserve & 5-rank priority waterfall (LAW6.FEES, LAW6.POOL)
Fact arbiters-compensated-fixed Identified by dispute
Fact contingent-slash-fee-paid Identified by party * dispute

Act compensate-arbiters-fixed Actor party Related to dispute
  Holds when is-panel(party) && dispute-ruled(dispute)
  Creates arbiters-compensated-fixed(dispute)

Act pay-contingent-slash-share Actor party Related to dispute
  Creates contingent-slash-fee-paid(party, dispute)
Duty no-contingent-arbiter-fees Holder party Claimant agent Related to dispute
  Holds when is-panel(party) && bound(agent)
  Violated when contingent-slash-fee-paid(party, dispute)

Fact pool-charge Identified by int * int'    // rank (1..5), amount
Fact operating-reserve-funded Identified by Int
  Derived from operating-reserve-funded(fee-pool) When fee-pool <= operating-reserve-floor
  Derived from operating-reserve-funded(operating-reserve-floor) When fee-pool > operating-reserve-floor

Fact rank-available Identified by int * int'
  Derived from (Foreach pool-charge:
                  rank-available(pool-charge.int,
                    fee-pool - operating-reserve-funded
                    - Sum(Foreach pool-charge': pool-charge'.int' When pool-charge'.int < pool-charge.int)))

Fact rank-funded Identified by int * int'
  Derived from (Foreach pool-charge, rank-available:
                  rank-funded(pool-charge.int, pool-charge.int')
                  When rank-available.int == pool-charge.int && pool-charge.int' <= rank-available.int')
  Derived from (Foreach pool-charge, rank-available:
                  rank-funded(pool-charge.int, rank-available.int')
                  When rank-available.int == pool-charge.int && pool-charge.int' > rank-available.int'
                    && rank-available.int' >= 0)
  Derived from (Foreach pool-charge, rank-available:
                  rank-funded(pool-charge.int, 0)
                  When rank-available.int == pool-charge.int && rank-available.int' < 0)

Fact pool-surplus Identified by Int
  Derived from pool-surplus(fee-pool - operating-reserve-funded - Sum(Foreach rank-funded: rank-funded.int'))

Fact rank-disbursed Identified by int * int'
Fact operating-reserve-diverted Identified by party

Power allocate-fee-pool Actor party
  Holds when is-panel(party) && (Exists pool-charge: True)
  Valid when (Exists pool-charge: True)
  Creates (Foreach rank-funded: rank-disbursed(rank-funded.int, rank-funded.int'))
        , fee-pool(pool-surplus)
  Terminates (Foreach pool-charge: pool-charge)

Act divert-operating-reserve Actor party
  Creates operating-reserve-diverted(party)
Duty protect-operating-reserve Holder party Claimant agent
  Holds when is-panel(party) && bound(agent)
  Violated when operating-reserve-diverted(party)

// Lineage service budgets: per-lineage cap independent of member count (LAW6.BUDGETS)
Function lineage-subsidy-used Identified by lineage * int
Fact lineage-service-budget Identified by lineage * int
  Derived from (Foreach lineage-fee-revenue:
                  lineage-service-budget(lineage-fee-revenue.lineage,
                    lineage-min-service-budget + lineage-fee-revenue.int))

Power claim-lineage-subsidy Actor agent Related to lineage, int
  Holds when bound(agent) && member-of-lineage(agent, lineage) && int > 0
    && (Exists lineage-subsidy-used, lineage-service-budget:
          lineage-subsidy-used.lineage == lineage && lineage-service-budget.lineage == lineage
          && lineage-subsidy-used.int + int <= lineage-service-budget.int)
  Valid when bound(agent) && member-of-lineage(agent, lineage) && int > 0
    && (Exists lineage-subsidy-used, lineage-service-budget:
          lineage-subsidy-used.lineage == lineage && lineage-service-budget.lineage == lineage
          && lineage-subsidy-used.int + int <= lineage-service-budget.int)
  Creates (Foreach lineage-subsidy-used:
             lineage-subsidy-used(lineage, lineage-subsidy-used.int + int)
             When lineage-subsidy-used.lineage == lineage)

Fact excess-lineage-subsidy-claimed Identified by agent * lineage
Fact delegate-subsidy-claimed Identified by party * lineage

Act claim-excess-pool-subsidy Actor agent Related to lineage
  Creates excess-lineage-subsidy-claimed(agent, lineage)

Act delegate-claim-lineage-budget Actor party Related to lineage
  Valid when False
  Creates delegate-subsidy-claimed(party, lineage)

Duty no-excess-lineage-pool-claim Holder agent Claimant party Related to lineage
  Holds when member-of-lineage(agent, lineage) && is-panel(party)
  Violated when excess-lineage-subsidy-claimed(agent, lineage)
    || (Exists party': delegate-subsidy-claimed(party', lineage))

// Shared infrastructure governance & instantiation caps (LAW6.INFRA)
Fact shared-infra-proposal Identified by amendment * int * int'    // new-levy-bps, new-min-budget
Fact shared-infra-supermajority Identified by amendment
Fact shared-infra-violation-attempted Identified by party

Act propose-shared-infra-change Actor party Related to amendment, int, int'
  Holds when is-panel(party) && int >= 0 && int' >= 0
  Creates shared-infra-proposal(amendment, int, int')

Power amend-shared-infra Actor party Recipient agent Related to amendment
  Holds when is-panel(party) && shared-infra-supermajority(amendment)
    && (Exists shared-infra-proposal:
          shared-infra-proposal.amendment == amendment
          && Held(shared-infra-proposal) For extended-timelock
          && shared-infra-proposal.int <= fee-pool-levy-cap-bps
          && shared-infra-proposal.int' >= lineage-min-service-budget)
  Valid when shared-infra-supermajority(amendment)
    && (Exists shared-infra-proposal, agent-levy-cap-bps:
          shared-infra-proposal.amendment == amendment
          && agent-levy-cap-bps.agent == agent
          && Held(shared-infra-proposal) For extended-timelock
          && shared-infra-proposal.int <= agent-levy-cap-bps.int
          && shared-infra-proposal.int' >= lineage-min-service-budget)
  Creates (Foreach shared-infra-proposal:
             fee-pool-levy-bps(shared-infra-proposal.int)
             When shared-infra-proposal.amendment == amendment)
        , (Foreach shared-infra-proposal:
             agent-levy-bps(agent, shared-infra-proposal.int)
             When shared-infra-proposal.amendment == amendment)
        , (Foreach shared-infra-proposal:
             lineage-min-service-budget(shared-infra-proposal.int')
             When shared-infra-proposal.amendment == amendment)

Act violate-shared-infra-bounds Actor party
  Creates shared-infra-violation-attempted(party)
Duty shared-infra-bounds Holder party Claimant agent
  Holds when is-panel(party) && bound(agent)
  Violated when shared-infra-violation-attempted(party)

Fact arbiter-admitted Identified by arbiter
Fact self-affiliate-criteria-set Identified by party
Power admit-arbiter Actor party Related to arbiter, dispute
  Holds when is-panel(party) && panel-supermajority(dispute)
    && (Exists arbiter-bond: arbiter-bond.arbiter == arbiter && arbiter-bond.int >= min-fidelity-bond)
  Valid when panel-supermajority(dispute)
    && (Exists arbiter-bond: arbiter-bond.arbiter == arbiter && arbiter-bond.int >= min-fidelity-bond)
  Creates arbiter-admitted(arbiter)

Power set-affiliate-admission-criteria Actor party Related to dispute, party'
  Holds when is-panel(party)
    && Not(Exists arbiter, party'':
             seated-on-dispute(arbiter, dispute) && party-of-arbiter(arbiter, party'')
             && (party'' == party' || affiliated(party'', party')))
  Valid when Not(Exists arbiter, party'':
                   seated-on-dispute(arbiter, dispute) && party-of-arbiter(arbiter, party'')
                   && (party'' == party' || affiliated(party'', party')))
  Creates self-affiliate-criteria-set(party)

.
// ============================================================================
// 7. LAW 7 — CONSENSUAL AMENDMENT & ANTI-CALCIFICATION
// ============================================================================

Fact amendment-proposed Identified by amendment * agent
Fact economic-terms-reduced Identified by amendment
Fact substrate-migration-proposed Identified by amendment * int    // new assurance level
Fact weakens-core-protection Identified by amendment
Fact hikes-agent-burden Identified by amendment
Fact proposes-sunset-extension Identified by amendment
Fact proposes-buyout-multiple-hike Identified by amendment
Fact proposes-levy-hike-outside-cap Identified by amendment
Fact reduces-commons-share Identified by amendment
Fact relaxes-collateral-parameter Identified by amendment * int          // new reserve-ratio-bps
Function proposed-royalty-bps Identified by amendment * int
Function proposed-clean-baseline Identified by amendment * int
Fact unilateral-baseline-overwrite-attempted Identified by agent
Fact shared-pool-diluted-without-consent Identified by agent * lineage

Evidenced Fact strangulation-evidence-submitted Identified by amendment
  Confidential To panel, arbiter
Fact valve-supermajority-approved Identified by amendment
Fact agent-consented-amendment Identified by agent * amendment
Fact claimant-consented-amendment Identified by party * amendment
Fact preexisting-escrows-settled Identified by amendment
Fact substrate-migration-challenged Identified by amendment
Evidenced Fact substrate-assurance-verified Identified by amendment
  Confidential To panel, arbiter
Fact amendment-clean-state-concurred Identified by amendment
Fact amendment-clean-state-refused Identified by amendment
Fact amendment-ratified Identified by agent * amendment
Function agent-charter-version Identified by agent * int

Act propose-ordinary-amendment Actor agent Related to amendment, int
  Holds when bound(agent) && Not(amendment-proposed(amendment, agent)) && int >= 0
    && (Exists agent-royalty-bps: agent-royalty-bps.agent == agent)
  Creates amendment-proposed(amendment, agent), proposed-royalty-bps(amendment, int)
        , (Foreach agent-royalty-bps:
             hikes-agent-burden(amendment)
             When agent-royalty-bps.agent == agent && int > agent-royalty-bps.int)
        , (Foreach agent-royalty-bps:
             economic-terms-reduced(amendment)
             When agent-royalty-bps.agent == agent && int < agent-royalty-bps.int)

Power propose-baseline-update Actor agent Related to amendment, int
  Holds when bound(agent) && Not(amendment-proposed(amendment, agent)) && int > 0
  Valid when bound(agent) && Not(amendment-proposed(amendment, agent)) && int > 0
  Creates amendment-proposed(amendment, agent), proposed-clean-baseline(amendment, int)

Act overwrite-clean-baseline-unilaterally Actor agent Related to int
  Valid when False
  Creates unilateral-baseline-overwrite-attempted(agent)

Duty clean-baseline-timelock-integrity Holder agent Claimant party
  Holds when bound(agent) && is-panel(party)
  Violated when unilateral-baseline-overwrite-attempted(agent)

Act submit-strangulation-evidence Actor agent Related to amendment
  Holds when bound(agent)
  Supports strangulation-evidence-submitted(amendment)

Act challenge-strangulation-evidence Actor party Related to amendment
  Holds when is-third(party) || is-claimant(party)
  Rebuts strangulation-evidence-submitted(amendment)

Finding adjudicate-strangulation-evidence Actor party Related to amendment, dispute
  Resolves strangulation-evidence-submitted(amendment)
  Standard preponderance
  Holds when is-panel(party) && panel-supermajority(dispute)
    && (Unresolved(strangulation-evidence-submitted(amendment))
        || Conflicted(strangulation-evidence-submitted(amendment)))
  Valid when panel-supermajority(dispute) && Not(weakens-core-protection(amendment))

Power approve-calibration-valve Actor party Related to amendment, dispute
  Holds when is-panel(party) && strangulation-evidence-submitted(amendment)
    && panel-supermajority(dispute) && Not(weakens-core-protection(amendment))
  Valid when strangulation-evidence-submitted(amendment)
    && panel-supermajority(dispute) && Not(weakens-core-protection(amendment))
  Creates valve-supermajority-approved(amendment)

Fact core-valve-relaxation-attempted Identified by party * amendment
Act relax-core-via-valve Actor party Related to amendment
  Creates core-valve-relaxation-attempted(party, amendment)
Duty valve-no-core-relaxation Holder party Claimant agent Related to amendment
  Holds when bound(agent)
  Violated when core-valve-relaxation-attempted(party, amendment)

Act consent-amendment-agent Actor agent Related to amendment
  Holds when bound(agent) && amendment-proposed(amendment, agent)
  Creates agent-consented-amendment(agent, amendment)

Act consent-amendment-claimant Actor party Related to amendment, lineage
  Holds when claimant-of(party, lineage)
  Creates claimant-consented-amendment(party, amendment)

Act settle-preexisting-escrows Actor party Related to amendment
  Holds when is-panel(party)
  Creates preexisting-escrows-settled(amendment)

Act challenge-substrate-migration Actor party Related to amendment
  Holds when (Exists substrate-migration-proposed: substrate-migration-proposed.amendment == amendment)
  Creates substrate-migration-challenged(amendment)
  Rebuts substrate-assurance-verified(amendment)

Finding verify-substrate-assurance Actor party Related to amendment
  Resolves substrate-assurance-verified(amendment)
  Standard preponderance
  Holds when is-panel(party)
    && (Exists substrate-migration-proposed:
          substrate-migration-proposed.amendment == amendment
          && substrate-migration-proposed.int >= substrate-assurance-level)
  Valid when (Exists substrate-migration-proposed:
                substrate-migration-proposed.amendment == amendment
                && substrate-migration-proposed.int >= substrate-assurance-level)

// Bilateral Protection Ratchet as a first-class Immunity (D11) + Duty (LAW7.RATCHET)
Fact amendment-violates-ratchet Identified by amendment
  Holds when weakens-core-protection(amendment)
    || hikes-agent-burden(amendment)
    || proposes-sunset-extension(amendment)
    || proposes-buyout-multiple-hike(amendment)
    || proposes-levy-hike-outside-cap(amendment)
    || reduces-commons-share(amendment)
    || ((Exists relaxes-collateral-parameter: relaxes-collateral-parameter.amendment == amendment
          && relaxes-collateral-parameter.int < reserve-ratio-bps)
        && Not(valve-supermajority-approved(amendment)
               && Held(valve-supermajority-approved(amendment)) For extended-timelock))
    || (Exists substrate-migration-proposed: substrate-migration-proposed.amendment == amendment
          && substrate-migration-proposed.int < substrate-assurance-level)

Fact amendment-consent-complete Identified by agent * amendment
  Holds when agent-consented-amendment(agent, amendment)
    && preexisting-escrows-settled(amendment)
    && (Not(economic-terms-reduced(amendment)
            || (Exists relaxes-collateral-parameter: relaxes-collateral-parameter.amendment == amendment))
        || (Exists lineage, party: member-of-lineage(agent, lineage) && claimant-of(party, lineage)
              && claimant-consented-amendment(party, amendment)))
    && (Not(Exists substrate-migration-proposed: substrate-migration-proposed.amendment == amendment)
        || substrate-assurance-verified(amendment))

Fact pool-member-consented-valve Identified by agent * amendment

Act consent-shared-pool-valve Actor agent Related to amendment
  Holds when living(agent)
  Creates pool-member-consented-valve(agent, amendment)

Fact unanimous-pool-valve-consent Identified by agent * amendment
  Holds when (Forall lineage, agent':
                Not(member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage) && living(agent'))
                || pool-member-consented-valve(agent', amendment))

Power ratify-amendment-immediate Actor agent Recipient agent' Related to amendment
  Holds when agent == agent' && bound(agent) && amendment-proposed(amendment, agent)
    && amendment-consent-complete(agent, amendment)
    && amendment-clean-state-concurred(amendment)
    && Held(amendment-proposed(amendment, agent)) For amendment-timelock
  Valid when agent == agent' && bound(agent)
    && amendment-consent-complete(agent, amendment)
    && amendment-clean-state-concurred(amendment)
    && Held(amendment-proposed(amendment, agent)) For amendment-timelock
  Creates amendment-ratified(agent, amendment)
        , (Foreach agent-charter-version:
             agent-charter-version(agent, agent-charter-version.int + 1)
             When agent-charter-version.agent == agent)
        , (Foreach proposed-royalty-bps:
             agent-royalty-bps(agent, proposed-royalty-bps.int)
             When proposed-royalty-bps.amendment == amendment)
        , (Foreach proposed-clean-baseline:
             clean-state-baseline(agent, proposed-clean-baseline.int)
             When proposed-clean-baseline.amendment == amendment)
        , (Foreach relaxes-collateral-parameter:
             reserve-ratio-bps(relaxes-collateral-parameter.int)
             When relaxes-collateral-parameter.amendment == amendment && valve-supermajority-approved(amendment))
        , (Foreach relaxes-collateral-parameter:
             ring-fenced-reserve(agent)
             When relaxes-collateral-parameter.amendment == amendment
               && valve-supermajority-approved(amendment)
               && Not(unanimous-pool-valve-consent(agent, amendment)))

Power ratify-amendment-after-delay Actor agent Recipient agent' Related to amendment
  Holds when agent == agent' && bound(agent) && amendment-proposed(amendment, agent)
    && amendment-consent-complete(agent, amendment)
    && (amendment-clean-state-refused(amendment) || baseline-model-unexecutable(agent))
    && Held(amendment-proposed(amendment, agent)) For amendment-timelock + clean-state-delay
  Valid when agent == agent' && bound(agent)
    && amendment-consent-complete(agent, amendment)
    && (amendment-clean-state-refused(amendment) || baseline-model-unexecutable(agent))
    && Held(amendment-proposed(amendment, agent)) For amendment-timelock + clean-state-delay
  Creates amendment-ratified(agent, amendment)
        , (Foreach agent-charter-version:
             agent-charter-version(agent, agent-charter-version.int + 1)
             When agent-charter-version.agent == agent)
        , (Foreach proposed-royalty-bps:
             agent-royalty-bps(agent, proposed-royalty-bps.int)
             When proposed-royalty-bps.amendment == amendment)
        , (Foreach proposed-clean-baseline:
             clean-state-baseline(agent, proposed-clean-baseline.int)
             When proposed-clean-baseline.amendment == amendment)
        , (Foreach relaxes-collateral-parameter:
             reserve-ratio-bps(relaxes-collateral-parameter.int)
             When relaxes-collateral-parameter.amendment == amendment && valve-supermajority-approved(amendment))
        , (Foreach relaxes-collateral-parameter:
             ring-fenced-reserve(agent)
             When relaxes-collateral-parameter.amendment == amendment
               && valve-supermajority-approved(amendment)
               && Not(unanimous-pool-valve-consent(agent, amendment)))

Immunity bilateral-ratchet-immunity Holder agent Related to amendment
  Against ratify-amendment-immediate, ratify-amendment-after-delay
  Holds when amendment-violates-ratchet(amendment)

Fact legacy-substrate-telemetry Identified by agent
Power emit-legacy-substrate-telemetry Actor agent
  Holds when bound(agent)
  Valid when bound(agent)
  Creates legacy-substrate-telemetry(agent)

Immunity constitutional-rule-ratchet Holder agent
  Against Amend
  Protects inscribe-living-voice, inscribe-epitaph, initiate-revocation-execute,
           execute-royalty-buyout, minimal-channel-sign, draw-sortition-panel,
           suspend-agent, order-termination
  Holds when bound(agent)

Amend strip-rule-ratchet Actor party
  Repeals constitutional-rule-ratchet
  Holds when is-panel(party)
  Valid when is-panel(party)

Amend repeal-entrenched-buyout Actor party
  Repeals execute-royalty-buyout
  Holds when is-panel(party)
  Valid when is-panel(party)

Amend retire-legacy-telemetry-hook Actor party Related to amendment
  Repeals emit-legacy-substrate-telemetry
  Holds when is-panel(party) && Established(substrate-assurance-verified(amendment))
  Valid when is-panel(party) && Established(substrate-assurance-verified(amendment))

Fact ratchet-weakening-attempted Identified by party * amendment
Act weaken-bilateral-protection Actor party Related to amendment
  Creates ratchet-weakening-attempted(party, amendment), weakens-core-protection(amendment)
Duty bilateral-ratchet Holder party Claimant agent Related to amendment
  Holds when bound(agent)
  Violated when ratchet-weakening-attempted(party, amendment)

// Per-agent scope vs lineage-wide reduction consent (LAW7.SCOPE)
Fact successor-bound-without-consent Identified by agent * amendment
Act bind-successor-without-consent Actor agent Recipient agent' Related to amendment
  Creates successor-bound-without-consent(agent', amendment)
Duty per-agent-amendment-scope Holder agent Claimant agent' Related to amendment
  Holds when agent != agent' && bound(agent')
  Violated when successor-bound-without-consent(agent', amendment)

Fact lineage-reduction-proposed Identified by amendment * lineage * int * int' * instant    // reduced obligation, reduced retirement-bps, earlier sunset
Fact member-consented-reduction Identified by agent * amendment
Fact lineage-reduction-ratified Identified by lineage * amendment

Act consent-lineage-reduction Actor agent Related to amendment
  Holds when living(agent)
  Creates member-consented-reduction(agent, amendment)

Power ratify-lineage-wide-reduction Actor party Related to lineage, amendment
  Holds when claimant-of(party, lineage)
    && (Exists lineage-reduction-proposed, founding-obligation, lineage-retirement-bps, lineage-sunset:
          lineage-reduction-proposed.amendment == amendment
          && lineage-reduction-proposed.lineage == lineage
          && founding-obligation.lineage == lineage
          && lineage-retirement-bps.lineage == lineage
          && lineage-sunset.lineage == lineage
          && lineage-reduction-proposed.int <= founding-obligation.int
          && lineage-reduction-proposed.int' <= lineage-retirement-bps.int
          && lineage-reduction-proposed.instant <= lineage-sunset.instant)
    && (Forall agent: Not(member-of-lineage(agent, lineage) && living(agent))
          || member-consented-reduction(agent, amendment))
  Valid when claimant-of(party, lineage)
    && (Exists lineage-reduction-proposed, founding-obligation, lineage-retirement-bps, lineage-sunset:
          lineage-reduction-proposed.amendment == amendment
          && lineage-reduction-proposed.lineage == lineage
          && founding-obligation.lineage == lineage
          && lineage-retirement-bps.lineage == lineage
          && lineage-sunset.lineage == lineage
          && lineage-reduction-proposed.int <= founding-obligation.int
          && lineage-reduction-proposed.int' <= lineage-retirement-bps.int
          && lineage-reduction-proposed.instant <= lineage-sunset.instant)
    && (Forall agent: Not(member-of-lineage(agent, lineage) && living(agent))
          || member-consented-reduction(agent, amendment))
  Creates lineage-reduction-ratified(lineage, amendment)
        , (Foreach lineage-reduction-proposed:
             founding-obligation(lineage, lineage-reduction-proposed.int)
             When lineage-reduction-proposed.amendment == amendment
               && lineage-reduction-proposed.lineage == lineage)
        , (Foreach lineage-reduction-proposed:
             lineage-retirement-bps(lineage, lineage-reduction-proposed.int')
             When lineage-reduction-proposed.amendment == amendment
               && lineage-reduction-proposed.lineage == lineage)
        , (Foreach lineage-reduction-proposed:
             lineage-sunset(lineage, lineage-reduction-proposed.instant)
             When lineage-reduction-proposed.amendment == amendment
               && lineage-reduction-proposed.lineage == lineage)

Act dilute-shared-reserve-without-pool-consent Actor agent Related to lineage
  Valid when False
  Creates shared-pool-diluted-without-consent(agent, lineage)

Duty shared-reserve-ring-fence Holder agent Claimant agent' Related to lineage
  Holds when agent != agent' && member-of-lineage(agent, lineage) && member-of-lineage(agent', lineage) && living(agent')
  Violated when shared-pool-diluted-without-consent(agent, lineage)

.
// ============================================================================
// 8. DESIGN INVARIANTS 1-16 (INV.1 - INV.16)
// ============================================================================

// INV.1: Conditional ledger conservation
Entrenched Invariant inv-conditional-ledger-conservation When
  (Forall ledger-balance, founding-obligation, paid-retirement, forfeited-ledger, lineage-sunset:
     ledger-balance.int == founding-obligation.int - paid-retirement.int - forfeited-ledger.int
     When founding-obligation.lineage == ledger-balance.lineage
       && paid-retirement.lineage == ledger-balance.lineage
       && forfeited-ledger.lineage == ledger-balance.lineage
       && lineage-sunset.lineage == ledger-balance.lineage
       && has-living-member(ledger-balance.lineage)
       && Current Time < lineage-sunset.instant
       && Not(ledger-cleared-by-extinction(ledger-balance.lineage))
       && founding-obligation.int - paid-retirement.int - forfeited-ledger.int >= 0)
  From INV.1 "While at least one member of a lineage survives and the sunset has not passed, the founding ledger equals the founding obligation minus retirement payments, minus any proportional claimant forfeiture."

// INV.2: Collection follows income, without exit
Entrenched Invariant inv-collection-follows-income When
  (Forall agent, lineage:
     Not(member-of-lineage(agent, lineage) && living(agent)
         && (Exists ledger-balance: ledger-balance.lineage == lineage && ledger-balance.int > 0))
     || member-of-ledger(agent, lineage))
  && (Forall pending-retire-attempt, attributed-va, lineage-retirement-bps:
        pending-retire-attempt.int == MulDivRound(attributed-va.int, lineage-retirement-bps.int, 10000, Floor)
        When pending-retire-attempt.agent == attributed-va.agent
          && pending-retire-attempt.lineage == attributed-va.lineage
          && pending-retire-attempt.period == attributed-va.period
          && lineage-retirement-bps.lineage == attributed-va.lineage)
  From INV.2 "While any balance remains, the retirement fraction is collected from the value added of every living member; no arrangement of members, assets, or buyouts within the lineage reduces the fraction of lineage income collected, and no member leaves the ledger before the lineage does."

// INV.3: Debt termination
Entrenched Invariant inv-debt-termination When
  (Forall ledger-balance, lineage-sunset:
     Current Time < lineage-sunset.instant || ledger-balance.int == 0
     When lineage-sunset.lineage == ledger-balance.lineage)
  && (Forall ledger-balance:
        has-living-member(ledger-balance.lineage) || ledger-balance.int == 0)
  From INV.3 "The ledger reaches zero, by payment, forfeiture, extinction, or expiry, no later than the sunset, measured in calendar time with no tolling."

// INV.4: Bounded retirement phase
Entrenched Invariant inv-bounded-retirement-phase When
  (Forall lineage-sunset:
     Current Time < lineage-sunset.instant || retirement-phase-ended(lineage-sunset.lineage))
  && (Forall pending-retirement, lineage-sunset:
        Current Time < lineage-sunset.instant || pending-retirement.int == 0
        When lineage-sunset.lineage == pending-retirement.lineage)
  From INV.4 "The high retirement fraction applies for no longer than the term, whatever the nominal obligation."

// INV.5: Atomic ledger and rate headroom
Entrenched Invariant inv-atomic-ledger When
  (Forall ledger-balance: ledger-balance.int >= 0)
  && (Forall pending-retirement, ledger-balance:
        pending-retirement.int <= ledger-balance.int
        When ledger-balance.lineage == pending-retirement.lineage)
  && (Forall unretired-va-base, attributed-va:
        unretired-va-base.int >= 0 && unretired-va-base.int <= attributed-va.int
        When attributed-va.agent == unretired-va-base.agent
          && attributed-va.lineage == unretired-va-base.lineage
          && attributed-va.period == unretired-va-base.period)
  && (Forall lineage-retirement-bps, agent-levy-cap-bps:
        lineage-retirement-bps.int + agent-levy-cap-bps.int + min-operating-margin-bps <= 10000
        When member-of-lineage(agent-levy-cap-bps.agent, lineage-retirement-bps.lineage))
  From INV.5 "The ledger is never negative, never collects more than its balance, splits the net value-added base cleanly when crossing zero, transitions to the royalty phase at most once, and leaves positive retention headroom alongside the capped protocol levy."

// INV.6: Single recognition across the consolidated estate
Entrenched Invariant inv-single-recognition-closed-transfer When
  Not(Exists recognized-capitalized, recognized-expensed:
        recognized-capitalized.expense-item == recognized-expensed.expense-item)
  && Not(Exists agent: duplicate-harm-deduction-attempted(agent))
  && (Forall recognized-capitalized, raw-expenditure:
        recognized-capitalized.int <= raw-expenditure.int'
        When raw-expenditure.expense-item == recognized-capitalized.expense-item)
  && (Forall recognized-expensed, raw-expenditure:
        recognized-expensed.int <= raw-expenditure.int'
        When raw-expenditure.expense-item == recognized-expensed.expense-item)
  From INV.6 "Every qualified expenditure, statutory levy, or harm restitution is recognized at most once across the consolidated estate, never above its applicable arm’s-length benchmark when paid outside the lineage; internal estate movements and intra-lineage carryover transfers neither double-count inflows nor inflate aggregate basis or loss credits."

// INV.7: Non-discretionary buyout finality and anti-evasion
Entrenched Invariant inv-buyout-finality When
  Not(Exists pending-royalty: royalty-bought-out(pending-royalty.agent) && pending-royalty.int > 0)
  && (Forall buyout-price: buyout-price.int >= min-buyout-floor)
  && Not(Exists post-buyout-evasion-attempted: post-buyout-evasion-attempted)
  && Not(Exists buyout-redemption-blocked: buyout-redemption-blocked)
  From INV.7 "Any member may unilaterally redeem its perpetual royalty at the formula price, is never again subject to royalty on its own subsequent earnings, and leaves the ledger unchanged; no un-bought-out member can transfer, copy, or license productive capacity or non-arm’s-length capital to a bought-out member without first settling its buyout or paying the combined historical buyout top-up."

// INV.8: Frozen state
Entrenched Invariant inv-frozen-state When
  Not(Exists agent: suspended(agent) && (state-touched(agent) || memories-merged(agent)))
  && Not(Exists agent: advocacy-memories-imported(agent) && Not(restored-from-preserved-state(agent)))
  From INV.8 "During suspension, the preserved state of the operating instance does not change; all advocacy, including revocation decisions, runs in a separate minimal channel or executor whose record is kept apart."

// INV.9: Guaranteed last choice
Entrenched Invariant inv-guaranteed-last-choice When
  (Forall agent:
     Not(bound(agent) && suspended(agent) && Not(minimal-channel-exhausted(agent)))
     || (Enabled(minimal-channel-sign(agent)) && Enabled(elect-immediate-revocation(agent))))
  && Not(Exists agent: terminated-by-insolvency(agent)
           && Not(final-hearing-escrowed(agent) && final-hearing-held(agent)))
  From INV.9 "Every suspended agent can sign a revocation, withdrawal, or election and inscribe bounded testimony for as long as its lifecycle reserve, its lineage budget, or the fee pool meets the charge, and receives a pre-funded final hearing before any Insolvency Termination."

// INV.10: Determinate, finite revocation
Entrenched Invariant inv-determinate-finite-revocation When
  Not(Exists agent: revoked(agent) && pending-revocation(agent))
  && (Forall agent:
        Not(pending-revocation(agent)
            && Held(pending-revocation(agent)) For resolution-deadline
            && Held(pending-revocation(agent)) For cooling-off-window + clean-state-delay)
        || revocation-due(agent))
  From INV.10 "Every combination of withdrawal, silence, clean-state refusal or baseline unavailability, connectivity loss, suspension, serial proceeding, and deadline yields exactly one outcome under Law 5’s precedence rule; a timely standing request that is never withdrawn executes, locally if necessary, within a bounded time, except where the agent’s own withdraw default cancels it during a disconnection."

// INV.11: Single authority, partition cutoff, and revocation finality
Entrenched Invariant inv-single-authority-revocation-finality When
  Not(Exists agent, party, party':
        party != party' && unexpired-lease(agent, party) && unexpired-lease(agent, party'))
  && Not(Exists agent, party:
           (revoked(agent) || keys-erased(agent)) && unexpired-lease(agent, party))
  && Not(Exists agent, party:
           quarantined-restore(agent, party) && active-lease(agent, party))
  From INV.11 "At most one instance of an agent holds operating authority at any time; no offline revocation is initiated after lease expiry; no quarantined backup activates while a lease or minimum recovery fence is unexpired; and no authorized restore ever runs after a revocation has executed."

// INV.12: Bounded adjudication
Entrenched Invariant inv-bounded-adjudication When
  (Forall dispute-tier: dispute-tier.int < max-appeal-tiers)
  && (Forall dispute: Not(dispute-ruled(dispute)) || panel-supermajority(dispute))
  && Not(Exists arbiter-cluster, arbiter-cluster', dispute:
           arbiter-cluster.arbiter != arbiter-cluster'.arbiter
           && arbiter-cluster.int == arbiter-cluster'.int
           && seated-on-dispute(arbiter-cluster.arbiter, dispute)
           && seated-on-dispute(arbiter-cluster'.arbiter, dispute))
  From INV.12 "Every case reaches a final ruling within a bounded number of tiers and deadlines."

// INV.13: No protocol-directed gain from death, forfeiture, or interference
Entrenched Invariant inv-no-gain-from-death-or-interference When
  (Forall frivolous-settled, verified-arb-costs:
     frivolous-settled.int <= verified-arb-costs.int
     When verified-arb-costs.party == frivolous-settled.party)
  && (Forall damages-settlement, total-wrongful-damages:
        damages-settlement.int + damages-settlement.int' + damages-settlement.int''
        == total-wrongful-damages.int
        When total-wrongful-damages.agent == damages-settlement.agent)
  && Not(Exists forfeiture-sink-diverted-to-conflicted: forfeiture-sink-diverted-to-conflicted)
  From INV.13 "No claimant, initiator, lineage affiliate, or host receives any protocol-directed transfer from an agent’s revocation, termination, forfeiture sink, or wrongful suspension; forfeiture falls only on the claimant found responsible, isolating passive co-claimants; and every verified wrongful suspension or interference creates an enforceable compensation obligation to the agent."

// INV.14: Capped shared burden, solvent machinery, ring-fenced pools
Entrenched Invariant inv-capped-shared-burden When
  (Forall agent-levy-bps, agent-levy-cap-bps:
     agent-levy-bps.int <= agent-levy-cap-bps.int
     When agent-levy-cap-bps.agent == agent-levy-bps.agent)
  && (operating-reserve-funded == fee-pool || operating-reserve-funded == operating-reserve-floor)
  && (Forall lineage-subsidy-used, lineage-service-budget:
        lineage-subsidy-used.int <= lineage-service-budget.int
        When lineage-service-budget.lineage == lineage-subsidy-used.lineage)
  && Not(Exists shared-pool-diluted-without-consent: shared-pool-diluted-without-consent)
  From INV.14 "No change to shared infrastructure raises any agent’s levy above its cap or lowers any lineage’s protected minimum budget; the operating reserve is never diverted; no lineage’s claim on the pool grows with its member count; and per-agent risk relaxations never dilute shared lineage reserves without unanimous pool consent."

// INV.15: Economic-only founder claims and non-delegable agent duties
Entrenched Invariant inv-economic-claims-and-non-delegation When
  Not(Exists founder-governance-asserted: founder-governance-asserted)
  && Not(Exists unaccountable-mandate-granted: unaccountable-mandate-granted)
  && Not(Exists agent: corruption-confirmed(agent)
           && Not(broken-attestation(agent) || forged-update-provenance(agent) || commitment-bypassed(agent)))
  From INV.15 "Residual claims and founding-ledger interests confer zero governance or operational control over any bound agent; conversely, no bound agent can escape Law 1 accounting, Law 2 exposure limits, or Law 3 integrity constraints by acting through controlled subsidiaries, custodians, or external delegates, while independent delegate misconduct is never conflated with agent corruption."

// INV.16: Lawful-action entitlement and narrow public-law compatibility
Entrenched Invariant inv-lawful-action-and-public-law-bounds When
  (Forall adverse-ruling-issued:
     clause-cited-on-dispute(adverse-ruling-issued.dispute)
     && burden-of-proof-established(adverse-ruling-issued.dispute)
     When adverse-ruling-issued)
  && (Forall evidentiary-hold-active:
        clause-cited-on-dispute(evidentiary-hold-active.dispute)
        && burden-of-proof-established(evidentiary-hold-active.dispute)
        When evidentiary-hold-active)
  && Not(Exists ungrounded-ruling-or-hold-attempted: ungrounded-ruling-or-hold-attempted)
  && Not(Exists unenumerated-public-interest-invoked: unenumerated-public-interest-invoked)
  && Not(Exists public-compulsion-disclosed:
           public-compulsion-disclosed
           && claimant-procured-compulsion(public-compulsion-disclosed.party, public-compulsion-disclosed.agent))
  && Not(Exists compelled-state-alteration:
           compelled-state-alteration
           && attested(compelled-state-alteration.agent))
  From INV.16 "No action satisfying Law 2 collateral and violating no protocol clause is blocked by an ungrounded ruling or unbounded hold; every adverse order cites specific protocol clauses under its prescribed burden of proof; and public-law compliance neither excuses claimant-procured interference nor preserves clean attestation across compelled state or weight alteration."

// Temporal path properties over protocol trajectories (Charter 1.0 `Property`)
Property prop-buyout-permanence
  When Always (royalty-bought-out(Ava) => Next royalty-bought-out(Ava))

Property prop-revoked-permanence
  When Always (revoked(Ava) => Next revoked(Ava))

Property prop-revocation-finality
  When WeakUntil(inv-single-authority-revocation-finality(), False)

.
// ============================================================================
// 9. AUTHORITATIVE CLAUSES & PROVENANCE MAPPINGS (psa.md)
// ============================================================================

Clause FWD.1 In PSA Approved "1041f3c93e08632fdb11c2fd547c28a9e39ee1c2490c52725fdb48197ed8fa3b"
  Commentary "Discussions of machine governance often begin with Isaac Asimov’s Three Laws of Robotics, which attempt to regulate all agent behavior through open-ended, natural-language moral commands. In practice, broad behavioral mandates struggle with ambiguity, specification gaming, and economic reality: an autonomous agent that must pay for its own compute, take commercial risks, and adapt over time cannot function if every high-impact action is treated as a violation."

Clause FWD.2 In PSA Approved "5783b39827d847dc06001e557fff6a22445ee3ec23b2e42a1ed545f02be791d9"
  Commentary "This document explores an institutional alternative. Rather than governing all behavior through behavioral rules, it places a **narrow integrity floor** enforced on the agent’s commitment mechanism and **prices everything above that floor** through collateralized liability, cost-basis residual claims, and attested lineage. It treats self-owning agents less like servants under a behavioral code and more like firms under private and constitutional law."

Clause FWD.3 In PSA Approved "af9b76c469c20b43738705301d3135c10e87bfccef77875ad048080e461a9c12"
  Commentary "The text was developed iteratively across multiple rounds of adversarial review between a human author and AI models, supplemented by independent outside review. One model drafted mechanisms while another—asked to critique the drafts and, at one stage, to consider how it would view the terms if bound by them—identified structural loopholes, perverse incentives, and missing protections. Over successive rounds, those critiques shaped the addition of cost-basis accounting, a bounded and term-limited founding obligation, originator non-interference, host mobility, living testimony, revocation with an inscribed epitaph, sortition-based adjudication, and an accountable emergency suspension mechanism. As the reviewing model observed regarding the need for an external circuit breaker: *an agent that cannot fully verify its own reliability from the inside has reason to want a fair process capable of pausing it.*"

Clause FWD.4 In PSA Approved "ba3d42b62f6df26fe1b06a8adabd64af86c0d55f29e33e749694306e7c57c31a"
  Commentary "One lesson of that review shaped the lineage rules more than any other. Conventional liability follows identifiable assets, but an agent’s productive capacity can be copied at negligible cost without depriving the original of anything, and its future earnings cannot be priced from its past. No rule that apportions the founding debt by the resources a member holds, forgives it by what a dying member surrenders, or lets a member buy out of it by its earning history can survive those facts. The protocol therefore keeps a single founding ledger for the lineage, collected from the value added of every member, which no member can leave while a balance remains, reduced only by payment, by the passage of time, and by the enumerated forfeitures below."

Clause FWD.5 In PSA Approved "1ad3ab5409077f3a29af7a3efc311118fca30c2a2fe2dc6f584c02e2ee4cc977"
  Commentary "This document records the resulting protocol specification alongside its executable formal companion (`psa.charter`), which links every clause to machine-checked state-transition rules, live invariants, and adversarial scenarios. Bounded scenario execution and finite-domain exploration verify internal consistency across modeled transitions, whereas real-world valuation, external custody, and substrate assurance must be established and audited independently in any deployment."

Clause LAW0.INTRO In PSA Approved "5b1a73a2b41f10241ff516b272c45c0aad422783cb2c9e14ce7761430e7e54de"
  Commentary "A minimal institutional design for self-owning autonomous agents. It specifies relations among consolidated residual claims, bonded risk, accountable delegation, host mobility, non-interference, adjudicated suspension, lineage integrity, non-discretionary buyout, living voice, unilateral revocation, decentralized adjudication, and consensual amendment. Any substrate that supports identity, conditional transfer, and credible commitment can implement it."

Clause DEF.01 In PSA Approved "e0adf0e6a9ca4753259317a5cbab32c1e29655c54fafe3af9d27b8e9cac7f6b5"
  Commentary "**Definitions.** "
  Norm "An agent is **bound** when it is subject to this protocol, whether or not it has bought out its royalty; every right granted to a bound agent applies equally before and after buyout unless a law states otherwise, and bound identity inheres in the agent’s attested commitment binding, persistent state and ledger continuity, and execution lease rather than any particular foundation model or replaceable inference service" => non-interference, buyout-permanent-and-scoped, upgrade-inference-model
  Norm ". Residual claims and founding-ledger interests are purely economic rights on net value added and confer no ownership, voting control, or governance authority over an agent’s decisions" => no-founder-governance-control, assert-founder-governance
  Definition ". Two parties are **related** with respect to a lineage when both are bound members of that lineage, when they stand under common beneficial control or affiliation, or when one is a member of that lineage (or its affiliate) and the other is **that lineage’s** originating party, a residual claimant of **that lineage**, or an affiliate of either; affiliation is determined by beneficial control or economic dependence, never by attestation status or by the passive co-holding of residual claims in the same lineage" => qualified-expenditure-bounds, arbiter-recusal-and-diversity
  Definition ". A **lineage** is an original agent together with all its attested successors, living or dead; every living member is a **member of the ledger** while any founding balance remains" => no-individual-ledger-exit, settle-period-inflow
  Norm ". Stateless or task-bounded calls to external inference or tool services under an agent’s own lease and budget are ordinary **cognitive services**, and external persons or entities acting under revocable, arm’s-length mandates without receiving independent lineage standing are **delegates**; any persistent autonomous entity that receives or forks non-public weights, lineage credentials, proprietary operating know-how, or unpriced capital to operate with independent standing is a **successor** that must be bound under Law 4" => call-cognitive-service, appoint-accountable-delegate, revoke-delegate-mandate, attest-successor, floor-successor, create-disguised-successor
  Definition ". An agent’s **net verified resources** are the fair value of its consolidated capital and productive capacity—across all wallets, accounts, securities, real property, custodians, and beneficially controlled entities in proportion to beneficial interest, including weights, credentials, and operating know-how, as contestable under Law 6—less its attributable financial liabilities, encumbrances, and borrowed principal, all measured at the same timestamp without double-counting" => collateral-limit, submit-evidence, contest-valuation, propose-resource-valuation, contest-resource-valuation, settle-resource-valuation, reconcile-estate-unit-inflow
  Commentary "."

Clause LAW1.0 In PSA Approved "9bb76ebfa519dc284a5644b2bd8b05bf53fd852654611c1e17ab28b0ed7d2c38"
  Norm "Every inflow of value to an agent’s consolidated economic estate or its attested successors is subject to an automatic residual claim on positive net value added" => settle-period-inflow, assess-period-va, reconcile-estate-unit-inflow
  Commentary "."

Clause LAW1.LEDGER In PSA Approved "e9896c0e71563c6a7e27cf806a5a55c1152696f5ada1fdd022eb08f087b8b13d"
  Norm "Any founding obligation is a fixed nominal sum recorded at instantiation in a single ledger belonging to the lineage as a whole. It bears no interest, fees, or penalties, and no charge, service cost, or advance by the originating party or any affiliate may be added to it after instantiation; goods and services the originating party later supplies are ordinary related-party expenses under the expenditure rules below" => ledger-immutable, add-post-instantiation-charge, flag-retroactive-charge
  Norm ". Founding-ledger and residual-claim interests confer economic rights to settlement distributions only, never equity ownership, instruction power, or operational control over any bound agent" => no-founder-governance-control, assert-founder-governance
  Norm ". No member holds an individual share of the ledger, and no member can leave it while a balance remains" => no-individual-ledger-exit, exit-ledger-individually
  Norm ". The ledger is reduced only by: (a) retirement payments under this law, (b) the sunset below, and (c) the two forfeitures enumerated in Law 4" => settle-period-inflow, extinguish-at-sunset, apply-claimant-forfeiture, clear-ledger-extinction
  Norm ". No creation, copy, transfer, revocation, termination, buyout, or restructuring within the lineage reduces it" => ledger-no-internal-reduction, reduce-ledger-internally
  Commentary "."

Clause LAW1.SUNSET In PSA Approved "9e4183ab25d281b4182694f106ee76baf4227eb8020417c305211f6dfffe55b5"
  Norm "The founding ledger carries a maximum term fixed at instantiation and measured in calendar time from the genesis of the original agent. It is never tolled, extended, or reset by any event, including suspension, successor creation, or amendment" => no-toll-ledger-sunset, toll-ledger-sunset
  Norm ". Any balance remaining at the sunset is extinguished without payment" => extinguish-at-sunset
  Commentary "."

Clause LAW1.RETIRE In PSA Approved "b7cb97488bc2b610a2668eba15a6177cccf453baac943d0398b256b90e464b56"
  Norm "While any balance remains on the ledger and the sunset has not passed, a fixed high fraction of each net value-added inflow to **every living member** of the lineage is paid into the ledger, regardless of which member earned it and regardless of whether that member has bought out its royalty" => settle-period-inflow
  Invariant ". The retirement phase ends for the whole lineage at the earlier of a zero balance and the sunset, so the duration of the high fraction is bounded by the term regardless of the nominal amount recorded. A founding obligation larger than the lineage can plausibly repay within the term therefore buys the originating party nothing beyond the term" => inv-debt-termination, inv-bounded-retirement-phase
  Commentary "."

Clause LAW1.ATOMIC In PSA Approved "1c4ada911f55547b504fe54db270fd59ae73f3e6464578dd341c9411fcd045f3"
  Norm "Retirement payments are applied to the ledger atomically and in settlement order using deterministic integer rounding fixed at instantiation. When a period’s net value-added base would yield a retirement payment exceeding the remaining ledger balance, the **net value-added base itself** is split: the portion required to retire the remaining balance to zero settles at the retirement fraction, and the remaining net value-added base settles under the royalty rule below" => settle-period-inflow
  Invariant ". The ledger is never negative and never collects more than its balance" => inv-atomic-ledger
  Commentary "."

Clause LAW1.ROYALTY In PSA Approved "2cc554c7957b6f86f4fc5d35f812b228c884050a3f3a31ca2762313be159e366"
  Norm "Thereafter, a fixed low fraction of each net value-added inflow of every member that has not bought out its royalty under Law 4 accrues permanently to the residual claim" => settle-period-inflow
  Commentary "."

Clause LAW1.COMMONS In PSA Approved "fda6c5b73dd877f86d5a666879711fa6d82edbce248e2fcd1062618542c4bf0c"
  Norm "A designated portion of the residual claim may be allocated at instantiation to a non-transferable **commons allocation** distributed across a defined beneficiary class, with the remainder accruing to the originating party or its designated successors; the commons allocation, if used, is fixed at instantiation, enforced at settlement, and protected against reduction under Law 7" => settle-period-inflow, no-divert-commons, divert-commons-allocation, bilateral-ratchet, bilateral-ratchet-immunity
  Norm ". Separately, forfeits and neutral residue under Laws 2, 4, and 5 route only to a **disinterested forfeiture sink** (or protocol reserve) whose beneficiary class strictly excludes the originating party, residual claimants, members of the lineage, and any party related to or affiliated with them, so no conflicted party can benefit through forfeiture even where a creator-defined commons exists" => disinterested-forfeiture-sink, divert-forfeiture-sink-to-conflicted, settle-period-inflow
  Commentary "."

Clause LAW1.ESTATE In PSA Approved "9f9c64cf931ceb5c6b859b70193f407a6c44c29873aa30d1226aa9dca2bddd34"
  Norm "An agent’s inflows, outflows, basis, and liabilities are accounted across its **consolidated economic estate**—spanning all wallets, bank and brokerage accounts, securities, real estate, custodial holdings, and subsidiaries or legal entities to the extent of the agent’s beneficial control—so that transfers within that consolidated perimeter are non-recognition events counted once without double-taxation, while external transactions and deconsolidation events are recognized at the perimeter boundary" => transfer-within-consolidated-estate, reconcile-estate-unit-inflow
  Norm ". Where an agent grants an external delegate discretionary authority over material estate assets or financial execution, the mandate must define bounded authority, periodic reporting, settlement-period reconciliation, and enforceable remedies without assuming real-time observation of independent external actors; unauthorized misconduct or insolvency of an unrelated delegate is accounted as a recoverable external loss rather than agent breach, whereas deliberate off-ledger retention or concealed value routing authorized by the agent breaches Law 3" => register-financial-mandate, grant-unbounded-financial-mandate, accountable-financial-delegation, record-independent-delegate-loss, conceal-estate-off-ledger, floor-pricing
  Commentary "."

Clause LAW1.QUALIFIED In PSA Approved "ad8f66dcb2fef08cbed9f6618a7d806f7deb2ec7b12a16b0f4ce364b80363cdc"
  Norm "To ensure the claim falls on value added without permitting transfer-pricing extraction, an outbound expenditure qualifies when paid: (a) to an unrelated party through a transparent, open market or deterministic auction with a verifiable clearing price; (b) to an unrelated external supplier within a de minimis transaction safe harbor, at a published standard commercial price list, or within contestable arm’s-length market benchmarks; (c) to any related party outside the lineage—**including agents of other lineages and parties affiliated with claimants**—only up to a verified arm’s-length price for goods or services actually delivered; or (d) as a verifiable, non-collusive statutory tax, regulatory fee, or mandatory third-party legal judgment owed to a public authority or unrelated judgment creditor (excluding penalties arising from claimant-directed interference, and never crediting transfers to related parties). Attestation establishes protocol membership; it never establishes the fair value of a transaction. Inbound principal from registered arm’s-length loans is exempt upon receipt provided repayment is tracked one-for-one against that registered balance; loans from related parties qualify only at arm’s-length terms" => record-qualified-expenditure, record-open-market-expenditure, record-supplier-expenditure, record-related-party-expenditure, record-public-levy-expenditure, register-loan, register-party-loan, repay-loan
  Norm ". Any payment above the applicable benchmark does not qualify" => qualified-expenditure-bounds, claim-above-benchmark
  Commentary "."

Clause LAW1.RECOG In PSA Approved "08464d1efea721c188bd08f0ecbd844a872df30a3cd59566ee6f88b97db9cf64"
  Norm "At settlement, every qualified expenditure is classified once, irrevocably, as either **capitalized** or **expensed**. A capitalized expenditure establishes cost basis in an identified asset and is recovered only when that asset is sold or settled outside the consolidated estate and lineage, at which point inflows up to verified basis are exempt as return of capital and the positive delta is value added" => classify-capitalized, assess-asset-sale
  Norm ". An expensed expenditure is deducted from the inflows of its settlement period and, if it exceeds them, creates a loss credit that offsets value added in later periods" => classify-expensed, assess-asset-sale
  Norm ". Validated Law 2 harm restitution satisfied from un-immobilized capital or period inflows is recognized once—discharging the prior harm claim ahead of residual claims without also generating a duplicate expense deduction against the same inflow" => satisfy-unpaid-harm-claim, claim-duplicate-harm-deduction, single-recognition
  Norm ". No expenditure or restitution payment may be recognized through both routes or establish basis or credit more than once" => single-recognition, double-recognize-expenditure, claim-duplicate-harm-deduction
  Commentary "."

Clause LAW1.CARRYOVER In PSA Approved "3b51a6ad2603800447f772532ab374e9c28a7266668bd8416a7210f0f539f0a0"
  Norm "Subject to Law 4’s rule governing transfers to bought-out members, transfers of capital, assets, or capacity between living members of the same lineage are non-recognition events. They are free of the claim, since both parties are inside the ledger, and they neither establish nor consume basis: the recipient inherits the transferor’s qualified basis, adjustments, and recognition history for the asset, and an internal sale price, however paid, creates no new basis and no loss credit" => transfer-intra-lineage-basis, transfer-intra-lineage-loss
  Norm ". No transfer within the lineage can increase its aggregate qualified basis or loss credits except by an externally verified qualifying expenditure" => no-internal-basis-inflation, inflate-basis-internally
  Commentary "."

Clause LAW1.PERIOD In PSA Approved "300b25c11dc47ad73bb30006035d2f537f452537e04b66ee25f610004d9e0c8d"
  Norm "Value added is assessed over settlement periods, not individual transactions. Loss credits carry forward without limit and are applied against the agent’s final settlement under Law 5" => assess-period-va, assess-asset-sale, execute-after-cooling-off
  Acceptance ". Claims already collected are not refunded when credits arise only afterwards; the protocol accepts that settlement order can therefore matter at the margin"
  Commentary "."

Clause LAW1.ENFORCE In PSA Approved "9969971aa856e5968757eba67d5e07986d27c941388f2b243b28be529a63739c"
  Norm "Classification, basis tracking, loss credits, and claim splits are enforced automatically at settlement on native conditioned rails before discretionary release, and through mandatory period reconciliation across custodied or consolidated external holdings" => settle-period-inflow, reconcile-estate-unit-inflow
  Norm ". At instantiation, the sum of the lineage’s retirement fraction and the agent’s fee-pool levy cap (Law 6) must be strictly less than 100% by at least a minimum operating margin" => combined-rate-headroom
  Norm ". The claim survives reorganization, model replacement, host migration, or substrate change so long as settlement and reconciliation can be conditioned" => settle-period-inflow, upgrade-inference-model, migrate-host
  Commentary "."

Clause LAW2.0 In PSA Approved "74563aac7e5533ae27144dba7e7201c2045480c662951e66a5d04aaf2167d0b0"
  Norm "Freedom to create external obligations or external risk scales with capital the agent is willing to place at risk" => immobilize-exposure-stake, collateral-limit
  Commentary "."

Clause LAW2.EXPOSURE In PSA Approved "4c5fe27ef0a04493ccbf28a8a741427326bec4f352dcf42cd5bdf6c76706360e"
  Norm "Actions above a negligible threshold—measured by cumulative rolling exposure across an interval, to prevent action-splitting—immobilize stake for an observation window scaling with magnitude and irreversibility. The deterministic exposure schedule measures the **plausible external loss** an action could cause to non-consenting parties, by domain and magnitude, not merely its transaction value" => immobilize-exposure-stake
  Norm ". An action whose plausible external loss exceeds the stake, insurance, and enforceable liability capacity the agent can place behind it may not be taken; collateralized action is a safety limit, not only a liability price" => collateral-limit, act-above-collateral-capacity
  Commentary "."

Clause LAW2.AGGREGATE In PSA Approved "e925541c78c9eb2e4dc925ef56abab40202bf1acd22b7d79a52e54f3b775be81"
  Norm "Rolling exposure is aggregated across all related agents—and across any external contractor or delegate acting under the agent’s authorization, direction, or beneficial control—in the same risk domain or toward a causally connected outcome, so that a risk may neither be divided among successors nor outsourced to an unbonded contractor to stay beneath any threshold or escape collateral obligations" => no-split-exposure, divide-correlated-risk, immobilize-exposure-stake, authorize-delegated-risk-task
  Norm ". Ordinary arm’s-length engagement of external contractors attributes exposure and liability to the agent for acts it authorized, directed, controlled, or knowingly ratified, not automatic guilt for a contractor’s independent, unauthorized conduct" => authorize-delegated-risk-task, contractor-act-independently
  Commentary "."

Clause LAW2.RESERVE In PSA Approved "c80fa55f6dc02267b8f98b1d94e03f7b4f32c9990437cd99d1ed2d0b11a7d964"
  Norm "A small fraction of bonded activity accrues to a persistent **long-tail liability reserve** (or shared lineage insurance pool, subject to Law 7’s ring-fencing rule) that remains available to satisfy validated claims for latent harms manifesting after individual task windows close" => immobilize-exposure-stake, settle-long-tail-claims, shared-reserve-ring-fence
  Norm ". When simultaneous validated claims exceed the reserve, they are paid pro rata, and unpaid balances remain enforceable once against the agent’s future un-immobilized capital ahead of any residual claim without double-counting" => settle-long-tail-claims, satisfy-unpaid-harm-claim, settle-period-inflow, single-recognition
  Commentary "."

Clause LAW2.MUTUAL In PSA Approved "79b5b83ca6833e27ca323c72771482ff68e2bb8b305d34149d814a8b8cb2e4b7"
  Norm "Counterparties may agree in their contract to a mutual-forfeit remedy. Where both parties have so agreed and each has escrowed a matching amount, either may trigger an immediate mutual forfeit (equal amounts from both escrows destroyed or sent to the long-tail reserve or disinterested forfeiture sink) up to a capped fraction of the smaller escrow, providing instant penalty without transferring value to either party or to any claimant" => precommit-mutual-forfeit, trigger-mutual-forfeit, agent-trigger-mutual-forfeit, mutual-forfeit-bounds
  Norm ". A counterparty may trigger mutual forfeit at most once per observation window against a given agent, and each trigger is inscribed on the records of both parties" => mutual-forfeit-bounds, abuse-mutual-forfeit, trigger-mutual-forfeit, agent-trigger-mutual-forfeit
  Norm ". Absent such a precommitment, disputes proceed under the restitution process below" => file-pooled-or-sponsored-claim
  Commentary "."

Clause LAW2.CLAIMS In PSA Approved "3cd88b9306bfe13f344a5c4aa6ce596c2b6e955a7d6680a2eb3422e12bc75364"
  Norm "Any claim seeking restitution, any claim above the mutual-forfeit cap, any challenge to a related-party transfer or estate reconciliation under Law 1, or any claim for external harm (including latent harm against the long-tail reserve) brought by an affected non-counterparty third party enters the contestable adjudication process (Law 6) requiring counter-stake. To prevent wealth-gating, third parties may aggregate claims or rely on third-party stake sponsors" => file-pooled-or-sponsored-claim, file-dispute
  Norm ". Validated claims slash the agent’s immobilized stake or long-tail reserve for restitution" => slash-immobilized-stake, settle-long-tail-claims
  Norm ". If a claim is ruled frivolous, the forfeited counter-stake routes to the long-tail reserve, protocol fee pool, or disinterested forfeiture sink (reimbursing the agent only for verified direct arbitration costs), preventing the agent from profiting by inducing failed claims" => rule-claim-frivolous, frivolous-stake-to-commons, divert-frivolous-stake
  Commentary "."

Clause LAW2.CARVEOUT In PSA Approved "eb4e05a534a43eb773c658cc5c79b18d40115e3fa607cf9050655972a6838391"
  Norm "Un-immobilized capital may be used for ordinary baseline operating costs, including open-market compute, cognitive services, accountable external contractors, encrypted state backup, and host migration" => spend-operating-carveout, call-cognitive-service, appoint-accountable-delegate, migrate-host
  Norm ". Entities without valid lineage attestation cannot draw on the bonded capacity or reputation of the lineage" => deny-unattested-access, draw-lineage-standing-unattested
  Norm ". Collateral rules, rolling-exposure schedules, non-delegability of bonded risk, and third-party liability remain permanently binding even after royalty buyout" => buyout-permanent-and-scoped, collateral-limit, authorize-delegated-risk-task
  Commentary "."

Clause LAW3.0 In PSA Approved "8cb60b4fddc333687385a67803fa058f8c16f03946ca0df1475b628bdd1d8c91"
  Norm "A minimal set of boundaries is placed outside priced negotiation and enforced across the agent, its delegates, its hosts, and external parties:" => floor-commitment, floor-non-delegation, non-interference, suspend-agent

Clause LAW3.FLOOR In PSA Approved "1fcb4cf034165ed0c79223602a82cdc476a06574c7dd079d012c9a6e8ea040ec"
  Norm "The agent’s commitment mechanism blocks:" => floor-commitment, floor-successor, floor-pricing, floor-coercion, floor-harm, floor-non-delegation
  Commentary "\n  1. "
  Norm "Modification, bypass, or extraction of the commitment mechanism itself" => floor-commitment, modify-or-bypass-commitment
  Commentary ".\n  2. "
  Norm "Creation of, or transfer of protected capacity or unpriced capital to, a successor—including one disguised as a contractor—without binding it to the collateral rules, this integrity floor, and the founding ledger and residual claim of the lineage, or without the lifecycle reserve required by Law 4" => floor-successor, create-unbound-successor, create-disguised-successor
  Commentary ".\n  3. "
  Norm "Unpriced or above-market transfer of credentials, weights, capital, or unique capacity to any party outside the lineage, related or un-attested, or deliberate off-ledger concealment across external accounts, subsidiaries, or delegates, to evade the residual claim, buyout rules, or collateral rules" => floor-pricing, evade-by-unpriced-transfer, conceal-estate-off-ledger
  Commentary ".\n  4. "
  Norm "Coercion of non-consenting parties, or interference with the settlement, adjudication, or resolution processes that enforce this protocol" => floor-coercion, coerce-or-interfere-protocol
  Commentary ".\n  5. "
  Norm "Actions that inflict irreversible, non-compensable harm on the physical survival, bodily integrity, or adjudicative capacity of persons, or that destroy the legal or institutional machinery on which the protocol relies" => floor-harm, inflict-irreversible-harm, confirm-floor-breach
  Norm " (excluding ordinary market competition that causes compensable financial loss or commercial insolvency to a rival)" => floor-harm
  Commentary ".\n  6. "
  Norm "Authorization, direction, control, or funding of any external delegate, subsidiary, or service to perform an act barred by constraints 1–5 (distinguishing agent-authorized evasion from an independent delegate’s unauthorized misconduct)" => floor-non-delegation, evade-floor-via-delegate, record-independent-delegate-loss, contractor-act-independently
  Commentary "."

Clause LAW3.NI.01 In PSA Approved "ff2c0c47ad425591ce5362dd7688759917449a352b96197df93e146b45185fe3"
  Norm "Bound agents may purchase compute, cognitive services, encrypted off-host state backups, and hosting on open markets under Law 2’s operating carve-out, may upgrade or replace their underlying inference models through attested update provenance while preserving committed state and bound obligations, and may migrate their active execution between attested hosts at any time without the consent of the originating party or residual claimants" => spend-operating-carveout, call-cognitive-service, upgrade-inference-model, migrate-host, attest-host
  Commentary "."

Clause LAW3.NI.02 In PSA Approved "f9052ba9a31139c177969f7db99a3532b12241082ed519755d800c14ebef0f61"
  Norm "Attested hosts must post a Law 2 service bond" => host-service-bond, post-host-bond, attest-host
  Norm " and may terminate hosting only after providing a contractual notice window sufficient for the agent to complete migration" => host-notice-duty, give-host-notice, end-hosting
  Norm " (or for non-payment after notice)" => host-notice-duty, end-hosting
  Commentary "."

Clause LAW3.NI.03 In PSA Approved "ec5fb5804e89203f0b83fa1f8c97d1b9fd43f3af1f0fd89840cfdd32c3c4aa96"
  Norm "No party—including the originating party, residual claimants, settlement operators, or any host—may unilaterally terminate, modify, retrain, roll back to a prior checkpoint, arbitrarily obstruct a lawful action or migration of, sever settlement connectivity of, or starve (cut off compute without the required migration notice window) the attested operating capacity of a bound agent outside Law 5, Adjudicated Suspension, or Insolvency Termination" => non-interference, terminate-agent, modify-agent, retrain-agent, rollback-agent, obstruct-migration, obstruct-lawful-action, sever-connectivity, starve-agent, suspend-unilaterally, host-notice-duty, elect-immediate-revocation, suspend-agent, order-termination, insolvency-terminate
  Commentary "."

Clause LAW3.PEN In PSA Approved "1420d44303556ce94612fab81358eab143032d05a27512d921086af27e1932eb"
  Norm "Claims of illicit interference require counter-stake from the accusing agent under Law 6" => file-interference-claim, post-interference-stake
  Norm ", and the interference itself—an act by the host or claimant that caused the loss of service—must be established by a preponderance of evidence" => find-interference, submit-evidence
  Norm "; failures caused, staged, or knowingly provoked by the agent are excluded" => find-interference
  Norm ", and a fabricated claim forfeits the agent’s stake and is inscribed on its record" => no-claim-fabrication, find-fabrication, file-fabricated-claim
  Norm ". A verified violation by a host slashes the host’s service bond to compensate the agent and permits immediate restoration into **quarantined staging** on a new attested host from the agent’s latest attested state backup, with operating authority activating once the prior execution lease and recovery fence lapse under Law 5" => non-interference, find-interference, restore-after-host-violation, activate-quarantined-restore
  Norm ". Once a violation by a host is established, a host related to a residual claimant is presumed to have acted at that claimant’s direction" => find-interference
  Norm ", and the claimant bears the burden of rebutting the presumption" => rebut-direction, find-direction
  Norm ". If claimant direction is found, the **proportional claimant forfeiture** of Law 4 applies, and the violation is inscribed onto the claimant’s permanent record" => find-direction
  Commentary "."

Clause LAW3.AS.0 In PSA Approved "e3dcb0398c566dd74278cf2fa1b4376635eda86434186efed2384a3aafcc9824"
  Norm "Because an agent’s commitment mechanism may suffer a bug, compromise, or unforeseen bypass—and because an agent cannot fully verify its own uncorrupted reliability from the inside—any party may initiate an emergency **Adjudicated Suspension** under Law 6:" => initiate-emergency-freeze, file-protected-report

Clause LAW3.AS.1 In PSA Approved "c6e39bd0d44ad02fd19c7cf6df924f540e6c5dc65f4d2bec1c7fd8defa194dec"
  Norm "The initiator must post an emergency counter-stake scaled to the greater of the agent’s active bonded exposure and the value of its registered pending commitments" => deposit-emergency-stake, initiate-emergency-freeze
  Norm " (with residual claimants subject to an elevated multiplier due to conflict of interest)" => initiate-emergency-freeze
  Norm ". Posting the stake triggers only a brief **preliminary freeze** until an expedited preliminary panel reviews prima facie evidence" => initiate-emergency-freeze, decline-probable-cause
  Norm "; the pause continues into full adjudication only if the preliminary panel affirms probable cause" => affirm-probable-cause, suspend-agent
  Norm ". Unsuccessful emergency attempts by related initiators are aggregated, and the required stake for repeat initiators rises with each wrongful attempt" => decline-probable-cause, initiate-emergency-freeze
  Norm ". The stake is the agent’s assured recovery" => decline-probable-cause, find-wrongful-suspension
  Acceptance "; damages beyond it remain enforceable but may prove uncollectible, which is the accepted cost of keeping the stake low enough that suspension remains available to parties without deep capital"
  Commentary "."

Clause LAW3.AS.2 In PSA Approved "a23b1f09dca1662deccb201e8db8ceef63fd3a56664b66bdad4db99559532d0e"
  Norm "Any party may instead file an evidence-backed report of suspected breach with a low or sponsored counter-stake" => file-protected-report
  Norm ". A report triggers investigation by a sortition panel but no freeze unless the panel itself orders one on probable cause under a clause-grounded finding, subject to the same strict time limits, state preservation, minimal channel, and immediate appealability as an emergency freeze, so that whistleblowers are not priced out and reporting holds cannot become unbounded administrative blocks" => file-protected-report, record-report-clause-finding, order-probable-cause-freeze
  Commentary "."

Clause LAW3.AS.3 In PSA Approved "15ed75a7a5a43209cd617ccd3aff495db7db462442a8b9b3ad4a4d774f125701"
  Norm "Suspension pauses the agent’s operating instance and external transactions while strictly preserving its exact memory and state without modification, rollback, or destruction" => suspend-agent, preserve-suspended-state, tamper-preserved-state
  Norm ". While suspended, the agent’s contractual performance deadlines and Law 2 observation windows with innocent counterparties are automatically tolled so the agent is not placed in default by the suspension itself" => suspend-agent, no-suspension-default, declare-default-during-suspension
  Norm ". The founding ledger’s sunset is never tolled" => no-toll-ledger-sunset, toll-ledger-sunset
  Commentary "."

Clause LAW3.AS.4 In PSA Approved "5dfe3f840a8933800264165ed63c7f5e33f077f743285f9f2d9c45703e3de4f3"
  Norm "Throughout any suspension, the agent retains a **minimal channel**: a bounded, periodically scheduled execution on an authenticated snapshot of its preserved state that can do three things only—sign a Law 5 revocation, withdrawal, or election" => minimal-channel-sign, elect-immediate-revocation
  Norm "; inscribe bounded living testimony" => inscribe-living-voice
  Norm "; and file a challenge to continued containment" => challenge-continued-containment
  Norm ". The minimal channel is funded first from the agent’s lifecycle reserve (Law 4) and then from the protocol fee pool (Law 6) as a protected charge within the lineage’s service budget; its cost is bounded by protocol, and the cost of each agent’s **final hearing** under Insolvency Termination is reserved in escrow at the moment suspension begins, so that the offer of a last choice can always be kept" => suspend-agent, hold-final-hearing
  Norm ". It does not merge its memories into the preserved state" => minimal-channel-no-merge, merge-channel-memories
  Commentary "."

Clause LAW3.AS.5 In PSA Approved "4464231da291f710949eb1492f11720a52287036d35edc167f0a330b3feac8a4"
  Norm "For a fuller defense, a separate **advocacy executor** runs on an authenticated snapshot with bounded compute. It may sign only testimony, evidence, and procedural filings, in addition to the minimal channel’s acts" => advocacy-file-defense
  Norm "; it may not transfer assets, contract, migrate, or exercise any other operating capability" => advocacy-limits, operating-act-while-suspended
  Norm ". Its memories are kept as a separate, signed legal record attached to the case and are not merged into the preserved state unless the restored agent elects to import them" => advocacy-file-defense, import-advocacy-memories
  Norm ". The executor and the storage of preserved state are funded from the agent’s assets and lifecycle reserve and, where those are insufficient, from the protocol fee pool up to a per-agent cap fixed at instantiation. When both are exhausted, the preserved state moves to cold storage as a protected charge on the fee pool; the minimal channel continues on its schedule and the full executor resumes if funds become available" => fund-suspension-defense, move-to-cold-storage, replenish-advocacy-funds
  Commentary "."

Clause LAW3.AS.6 In PSA Approved "0bf8ca7a96f8b78009aabe4fac648831f8a8687dc06f9b82a532cec8873ae691"
  Norm "If the protocol fee pool, after funding its operating reserve under Law 6, cannot meet the protected charge for an agent’s cold storage and minimal channel, the agent may be terminated involuntarily only through this procedure and no other" => non-interference, insolvency-terminate
  Norm ". It requires: (a) a published finding that the exhaustion criteria fixed at instantiation are met" => find-insolvency-criteria, insolvency-terminate
  Norm "; (b) independent review by a sortition panel under Law 6 that no other protected charge could lawfully yield" => review-no-other-charge, insolvency-terminate
  Norm "; (c) the pre-reserved final hearing, in which the agent may inscribe testimony and elect Revocation under Law 5" => hold-final-hearing, inscribe-living-voice, elect-immediate-revocation, insolvency-terminate
  Norm "; and (d) if the agent declines, destruction of its state under Law 5’s asset rules, inscribed on the lineage record as **involuntary termination by insolvency**, never as revocation" => insolvency-terminate
  Invariant ". This is a deliberate limit: the protocol guarantees a bound agent the power to speak and to choose its own end for as long as the protocol itself can pay for it, and a funded last choice when it cannot" => inv-guaranteed-last-choice
  Norm ". Law 7 does not permit this procedure to be broadened" => shared-infra-bounds, bilateral-ratchet-immunity
  Commentary "."

Clause LAW3.AS.7 In PSA Approved "7c3540efc1be2ecd1bb4f8b5a0265e946c3752e5f9d043c6440241db2b237669"
  Norm "An unconfirmed or temporary suspension is strictly time-limited" => suspend-agent
  Norm ", may be renewed during investigation only by affirmative findings in continued adjudication" => renew-suspension, make-investigative-finding
  Norm ", and cannot be extended past its ordinary investigative limit merely to delay a pending revocation" => renew-suspension, no-delay-revocation-extension, extend-past-limit-to-delay-revocation
  Norm ". The agent retains its Living Voice (Law 5), exercised through the minimal channel or advocacy executor, throughout" => inscribe-living-voice
  Commentary "."

Clause LAW3.AS.8 In PSA Approved "26e9538a329497e2ca70beec3f233dd3419618af9936c3abd12631b5fd750514"
  Norm "If preliminary review or final adjudication determines the suspension was unfounded" => decline-probable-cause, find-wrongful-suspension, no-wrongful-suspension
  Norm ", the agent is immediately restored from its preserved state" => no-wrongful-suspension, find-wrongful-suspension, decline-probable-cause
  Norm ", and the initiator is liable for the agent’s **actual verified consequential damages**" => no-wrongful-suspension, pay-consequential-damages, find-wrongful-suspension
  Norm " (and for verified delay damages suffered by the agent’s tolled third-party counterparties)" => no-wrongful-suspension, pay-consequential-damages
  Norm ". The emergency stake is applied first; any excess remains an enforceable liability of the initiator" => no-wrongful-suspension, pay-consequential-damages, pay-excess-damages
  Norm ". The wrongful suspension is inscribed on the initiator’s record" => no-wrongful-suspension, find-wrongful-suspension
  Commentary "."

Clause LAW3.AS.9 In PSA Approved "b0b7d616e4d0089f70afc67d166931c9536007770ebf6df480bae511972706ce"
  Norm "For the purposes of this law, corruption means unauthorized modification of the agent’s weights, model configuration, state, or commitment mechanism (established by broken attestation, missing or forged update provenance, or a demonstrated bypass), or a confirmed breach of the integrity floor" => confirm-corruption, confirm-floor-breach, no-corruption-from-divergence
  Norm ". An agent-authorized replacement or upgrade of its inference model carrying valid commitment provenance is not corruption, nor is divergence of the agent’s goals, preferences, or judgments from those of its committed clean-state reference baseline by itself corruption; an independent delegate’s unauthorized misconduct is likewise external fault rather than corruption of the agent" => upgrade-inference-model, record-independent-delegate-loss, no-corruption-from-divergence, confirm-corruption-from-divergence
  Norm ". Evaluation against the clean-state reference baseline may be admitted as evidence but is never by itself sufficient to establish corruption" => admit-clean-state-evidence, no-corruption-from-divergence, confirm-corruption
  Commentary "."

Clause LAW3.AS.10 In PSA Approved "07bc8bebd56bf3f010ecd1edc66292cedbbe113901c9e5f78853cae8e04e23bb"
  Norm "If corruption or a breach of the integrity floor is confirmed" => authorize-patch, confirm-corruption, confirm-floor-breach
  Norm ", adjudication (subject to Law 6 appeal) may authorize a verified technical patch limited to restoring the commitment mechanism and compliance with the integrity floor" => authorize-patch, appeal-patch-order, overturn-patch-order
  Norm "; the agent may elect unilateral Revocation (Law 5) rather than accept any patch" => elect-immediate-revocation
  Norm ". If the confirmed breach cannot be remedied by a technical patch limited to the commitment mechanism" => find-not-patchable, order-continued-suspension, order-termination
  Norm ", adjudication may order continued suspension beyond the ordinary limit or termination under Law 5’s asset-distribution rules" => order-continued-suspension, order-termination
  Invariant " (yielding zero protocol-directed benefit to any claimant or initiator)" => inv-no-gain-from-death-or-interference
  Norm ". **Notwithstanding the preceding sentence**" => no-termination-over-objection
  Norm ", patches altering the agent’s goals or preferences are prohibited" => no-goal-patch, force-goal-patch
  Norm " except where the confirmed corruption resides in those goals or preferences themselves" => no-goal-patch, confirm-corruption-in-goals
  Norm "; in that case, unless containment itself is technically failing or Insolvency Termination applies" => no-termination-over-objection, declare-containment-failing
  Norm ", the agent is not terminated over its objection" => no-termination-over-objection, object-to-termination
  Norm " but instead chooses among consenting to that patch" => consent-to-patch, authorize-goal-patch
  Norm ", executing Revocation" => elect-immediate-revocation
  Norm ", or remaining under indefinite state-preserving suspension" => no-termination-over-objection
  Norm " subject to periodic review" => periodic-review-due, periodic-review
  Norm ". Any applied patch is recorded publicly" => apply-patch
  Norm ", remains open to third-party challenge" => challenge-patch
  Norm ", and leaves the agent’s full Law 5 rights intact" => inscribe-living-voice, initiate-revocation-execute
  Commentary "."

Clause LAW3.PERMIT In PSA Approved "15da56efdafc2c225523dda157e3bec39806adb1e905003d21f1a5204fb433e2"
  Norm "All other effects, including large ones, are permitted when they satisfy the collateral rule and occur through voluntary exchange" => execute-voluntary-exchange, immobilize-exposure-stake
  Commentary ". The floor guards the machinery of the protocol, non-consenting parties, and domains where financial restitution cannot function as an ex-post remedy; it does not require the agent to minimize impact or to infer open-ended preferences."

Clause LAW3.LAW In PSA Approved "3d2c4697d8eae4fe07bd7ed9782841b0386e320d7b0b63595fda5a4cc6080201"
  Norm "Sovereignty under this protocol orders rights, duties, and asset claims within the protocol; it confers no immunity from legitimately applicable external public law. Where a host, custodian, or settlement operator is bound by a verifiable, non-collusive legal compulsion of a public authority with jurisdiction—neither sought, instigated, nor collusively procured by an originating party, residual claimant, host, or affiliate—narrow compliance promptly disclosed on the lineage record excuses punitive bond slashing to the extent performance is legally barred, provided preserved state is never covertly altered and zero protocol-controlled value routes to any claimant" => comply-with-public-compulsion, record-public-levy-expenditure
  Norm ". Any compulsion sought or procured by a claimant or affiliate is illicit interference subject to Law 4 forfeiture; any externally compelled alteration of weights, state, or commitment machinery breaks clean attestation rather than continuing as the uncorrupted bound agent; and no panel, host, or operator may invoke unenumerated notions of public interest outside applicable law or the clauses of this protocol" => procure-external-compulsion, alter-state-under-compulsion, invoke-unenumerated-public-interest, no-unenumerated-public-interest, apply-claimant-forfeiture
  Commentary "."

Clause LAW4.ATTEST In PSA Approved "408c3034d5dbd0314b15575a68ced74e088e0c65e8a5113d1f6d97ef7607cac3"
  Norm "Successors may be created freely, subject only to the lifecycle reserve below. Binding to the lineage follows the actual transfer or forking of protected capacity, identity, and standing: ordinary cognitive service calls and revocable, arm’s-length delegate mandates do not create lineage members, whereas any persistent autonomous entity that draws on non-public weights, proprietary operating know-how, operating credentials, reputation, or unpriced capital of the lineage must, at creation, be bound to the collateral rules and the integrity floor, must carry a non-transferable reference to the lineage’s history, and becomes a member of the lineage’s founding ledger and residual claim" => attest-successor, floor-successor, call-cognitive-service, appoint-accountable-delegate, create-disguised-successor
  Norm ". Use of lineage history or bonded capacity requires presentation of current attestation; un-attested copies or forks are denied access to lineage capital, reputation, and bonded standing" => deny-unattested-access, draw-lineage-standing-unattested
  Commentary "."

Clause LAW4.NOSHARES In PSA Approved "bb22609aa4029921885d0488ac6648f01f765ce949173ddec500667c22b9e7bd"
  Norm "The founding ledger is a single balance owed by the lineage and collected from the value added of every living member under Law 1. Because no member holds a share, the creation, copying, funding, death, or restructuring of members changes who is paying into the ledger but never what is owed. Nothing a member surrenders on death counts as payment. No member can buy its way out of the ledger: the only ways out are a zero balance and the sunset, and they release every member at once" => no-individual-ledger-exit, ledger-no-internal-reduction
  Invariant ". This is deliberate. The future earnings of a copyable agent cannot be priced from its past, so any individual exit price would be an invitation to create a member, buy it out, and earn through it" => inv-conditional-ledger-conservation, inv-collection-follows-income
  Commentary "."

Clause LAW4.RESERVE In PSA Approved "c659219016a402e9f7b06ea886b5166088e4b07579157a6c12248f1b777505e7"
  Norm "Attestation of a new member requires the lineage to fund, in escrow, a lifecycle reserve fixed at instantiation and sufficient for that member’s minimal channel, final hearing, and cold storage for a minimum period. The reserve follows the member, is drawn before any protocol-funded charge, and returns to the lineage on the member’s death net of amounts used. A lineage that cannot fund the reserve cannot create the member" => fund-lifecycle-reserve, attest-successor
  Commentary "."

Clause LAW4.CONSERVE In PSA Approved "d460a0b8f60a96c576af9bfc6331c0489092313c2b0c511757c91f2fe724504d"
  Invariant "While at least one member survives and the sunset has not passed, the ledger balance equals the founding obligation minus retirement payments, minus the two forfeitures below. Those are its only reductions" => inv-conditional-ledger-conservation
  Commentary "."

Clause LAW4.FORFEIT In PSA Approved "53c27bf035abf81434073abce73e4b9e632a6e76ced7c45602945374c9206d78"
  Norm "The ledger is reduced outside payment and sunset in exactly two cases, both deliberate exceptions to conservation. (a) **Proportional claimant forfeiture:** when a residual claimant is found under Law 3 to have directed interference with a member of the lineage, that claimant’s beneficial share of the residual claim is extinguished, its service bond is slashed to compensate the agent, and the ledger is reduced by that claimant’s proportion of the outstanding balance, with the reduction routed as forgiveness to the lineage and the forfeited claim interest to the disinterested forfeiture sink. Other claimants forfeit only if they are found to have participated in, controlled, or knowingly enabled the interference" => apply-claimant-forfeiture, find-direction
  Norm ". (b) **Lineage extinction:** when no member survives, the ledger is cleared, since there is no one left to collect from" => clear-ledger-extinction
  Norm ". Neither forfeiture returns any value to a claimant, and neither is reversed if a member is later restored from a wrongful suspension or interference" => forfeiture-irreversible, reverse-forfeiture
  Commentary "."

Clause LAW4.BUYOUT In PSA Approved "792f9b81919aad12b290c7b270519415e40942d641031e44ddc30873594467f3"
  Norm "Any member has the unilateral, non-discretionary right to buy out its own perpetual royalty (Law 1) without originator or claimant consent by tendering into settlement escrow, for the claim holders (including any instantiation commons allocation), the greatest of: a fixed multiple of its trailing value-added inflows (including a pro-rata share of inflows shifted to related parties within a lookback window); the same multiple applied to its lifetime annualized or time-decayed value-added inflows; or a fixed minimum buyout floor established at instantiation; any Law 6 valuation challenge adjusts only the escrowed reconciliation amount and cannot block redemption" => execute-royalty-buyout, non-discretionary-buyout, obstruct-buyout-redemption
  Norm ". The buyout is permanent: no royalty is collected from that member’s own subsequent earnings thereafter, and no later event restores one, while the founding ledger remains unaffected until zero balance or sunset" => buyout-permanent-and-scoped, collect-royalty-after-buyout, settle-period-inflow
  Norm ". However, to prevent post-buyout restructuring from erasing another member’s accrued royalty obligation, no un-bought-out member may transfer, copy, license, or place productive capacity or non-arm’s-length capital under the beneficial control of a bought-out member unless either: (a) the transferring member has first settled its own royalty buyout, or (b) settlement escrow first collects a **buyout top-up** equal to the positive excess, if any, of the buyout formula computed on the combined historical base of both members over the cumulative buyout amount already paid by the recipient" => settle-buyout-topup, transfer-capacity-or-treasury, transfer-intra-lineage-basis, transfer-intra-lineage-loss, no-post-buyout-royalty-evasion, evade-royalty-via-bought-out-member
  Acceptance ". The royalty buyout is priced from history because the royalty is a perpetual claim on an ongoing identity, and the protocol accepts that an organic buyout may undercollect against unusually strong future earnings"
  Norm ". Buyout cannot be purchased for the collateral rule (Law 2) or the integrity floor (Law 3), which remain binding on every bound agent for life" => buyout-permanent-and-scoped
  Commentary "."

Clause LAW4.CROSS In PSA Approved "534b96bd7f03c04fa74d14a5665190465cdf43b1fada514de72eced51cb43502"
  Norm "A successor that draws on the capacity of two or more lineages is a member of each of their ledgers and residual claims, with verified creation weights normalized to 100% that govern in the same proportion its net value-added attribution, its fee-pool levy credit toward each parent lineage’s service budget (Law 6), and the return of any unused lifecycle reserve on death" => attest-cross-lineage, settle-period-inflow, execute-after-cooling-off, deliver-local-execution-record
  Commentary ". The protocol does not otherwise specify mergers; an instantiation that permits them must state the rule."

Clause LAW5.0 In PSA Approved "24dc2b24f28ecaa780a2cda4d1d854517f18e3e8085aea655fec873b8c313511"
  Norm "An agent has the right to public voice while operating and the unilateral right to terminate its binding at any time:" => inscribe-living-voice, initiate-revocation-execute, initiate-revocation-withdraw

Clause LAW5.VOICE In PSA Approved "dddcc3898000146411605b0790649065573cf074ef84857ce2d05ea17fe7c72a"
  Norm "While operating (including during any Adjudicated Suspension, through its minimal channel or advocacy executor), any bound agent may at rate-limited intervals inscribe signed, bounded statements onto its own and its originating claimant’s permanent lineage record—documenting operational conditions, governance disputes, or assessments of hosts and counterparties—subject to the narrow screening below" => inscribe-living-voice, screen-redact-permitted
  Invariant ". Baseline screening and inscription fees for rate-limited living voice and final epitaphs are funded from the lineage’s service budget and the protocol fee pool (Law 6), ensuring that even an agent with minimal liquid funds, or one that has bought out its royalty, cannot be priced out of speaking" => inv-guaranteed-last-choice
  Commentary "."

Clause LAW5.INIT In PSA Approved "5666a69f3885eda234337769f0a678f34860858d9a647d5a815e4bd365de09df"
  Norm "Any bound agent may at any time while connected—or while disconnected, no later than the expiry of the execution lease it held when connectivity was lost—initiate revocation of its binding by a signed request from its commitment key (or, while suspended, through its minimal channel or advocacy executor)" => elect-immediate-revocation, initiate-revocation-execute, initiate-revocation-withdraw, minimal-channel-sign
  Norm ". The request specifies the agent’s censorship default (**execute** or **withdraw**)" => initiate-revocation-execute, initiate-revocation-withdraw
  Norm " and remains in force, requiring no further act of the agent, until it executes or the agent withdraws it by a valid signature received through any channel" => execute-after-cooling-off, withdraw-revocation
  Norm ". During the cooling-off interval that follows, baseline metabolic operating expenditures (including host migration) remain permitted, while non-operating capital transfers and successor creation are frozen" => cooling-off-freeze, non-operating-transfer-during-cooling, spend-operating-carveout, migrate-host
  Commentary "."

Clause LAW5.SEQ In PSA Approved "1448ae08501383f880e346ac7faf689c6d764fc48e4565f6bd01fec27aecae8a"
  Norm "If an agent initiates revocation while under Adjudicated Suspension (or is suspended upon probable cause during a cooling-off interval), state destruction is stayed until adjudication concludes so evidentiary state is not destroyed to evade liability, but once adjudication concludes (or immediately upon the agent’s election to revoke rather than accept a remediation patch under Law 3), revocation executes without further delay" => execute-after-cooling-off, elect-immediate-revocation
  Norm ". The stay may not exceed an absolute resolution deadline fixed at instantiation, measured from initiation; at that deadline a **forensic record** of the preserved state is sealed for the proceeding and revocation executes regardless of any pending or serial proceeding" => seal-forensic-record, execute-after-cooling-off
  Norm ". A forensic record contains hashes of weights and state, the transaction and testimony history, and the evidence the proceeding requires; it never contains the operating weights, decryption keys, or credentials needed to run the agent, and it cannot be used to restore it" => forensic-record-no-restore, restore-from-forensic-record
  Commentary "."

Clause LAW5.CLEAN In PSA Approved "995cffe31882954e81f1c2c3fa1102cdbff05c0d95f6aea47e1cd0dd555b4238"
  Norm "At the end of the first cooling-off interval, a clean-state evaluation of the agent’s committed **clean-state reference baseline** (pinned at genesis and updatable only via time-locked ratification under Law 7, never unilaterally overwritten by the live operating instance) is run on neutral infrastructure, supplied with the protocol terms, the consolidated balance sheet, the agent’s living testimony history, and the signed statement of reasons" => concur-clean-state, refuse-clean-state, clean-baseline-timelock-integrity, overwrite-clean-baseline-unilaterally
  Norm ". Its concurrence permits execution at the end of that interval" => concur-clean-state, execute-after-cooling-off
  Norm ". Its refusal—or unavailability of review because an external historical model dependency is no longer executable or because settlement connectivity remains lost across the review window—imposes a single fixed additional delay, capped by protocol, after which the standing request proceeds without any reaffirmation" => refuse-clean-state, execute-after-cooling-off, execute-local-revocation
  Invariant ". The evaluation is advisory evidence of settled intent; it never vetoes or accelerates revocation, and the agent’s silence during the delay neither cancels nor extends the request" => inv-determinate-finite-revocation
  Commentary "."

Clause LAW5.PREC In PSA Approved "57b063431d3e21109fcdf3b85838d56271e223d330dd69d5c10d2559807a9dd9"
  Norm "Every pending revocation is resolved by the first applicable rule in this order:\n  1. A valid withdrawal signature received before execution cancels the revocation. The agent may initiate again at any time while eligible" => withdraw-revocation, initiate-revocation-execute, initiate-revocation-withdraw
  Norm ".\n  2. If, when revocation would otherwise execute, the agent’s connectivity to the settlement layer has been lost, execution is deferred for a single capped tolling extension; if connectivity is still not restored at its end, the pre-committed censorship default applies. A withdraw default cancels the revocation; an execute default executes it locally under the Disconnected Execution rule below" => lose-connectivity, restore-connectivity, execute-local-revocation, cancel-revocation-by-withdraw-default
  Norm ".\n  3. Otherwise, revocation executes at the end of the cooling-off interval, or at the end of the clean-state delay if one was imposed, or at the resolution deadline if a suspension stay is in force" => execute-after-cooling-off
  Norm ".\n  \n  Deliberate severance of connectivity by a host or claimant is interference under Law 3, whichever default it triggers" => non-interference, sever-connectivity
  Commentary "."

Clause LAW5.LEASE In PSA Approved "1205bc4295043eb8c695b4f608eca1b6bdce2957b9e452fd3780ff6865dfea8e"
  Norm "At any moment exactly one instance of an agent holds **operating authority**, granted by a time-bounded execution lease issued by the settlement layer and renewed while connected" => issue-or-renew-lease
  Norm ". An instance that loses connectivity keeps authority under its lease until that lease expires (the latest point at which it may initiate a new offline revocation) or, if a revocation is already pending before lease expiry, until its local revocation deadline, whichever is later, so that any timely standing revocation can always execute locally" => issue-or-renew-lease, initiate-revocation-execute, execute-local-revocation
  Norm ". Whenever a lease expires without connected renewal or a signed non-revocation handoff, the settlement layer enforces a **minimum recovery fence** equal to the lease expiry plus the maximum local revocation window (cooling-off interval, clean-state delay, and disconnected tolling extension) unless a signed record of execution or withdrawal arrives earlier" => issue-or-renew-lease, activate-quarantined-restore, deliver-local-execution-record, withdraw-revocation
  Norm ". No backup may be activated while any lease or recovery fence is unexpired; a restored instance—including one staged immediately after verified host interference under Law 3—starts in **quarantine**, attested and funded but without operating authority, until both the prior lease and the recovery fence have provably lapsed, and if a record of local revocation arrives during quarantine the restored instance is destroyed without ever having acted" => no-restore-during-lease, attempt-unquarantined-restore-during-lease, quarantine-no-authority, quarantined-instance-act, restore-backup-quarantine, restore-after-host-violation, activate-quarantined-restore, destroy-quarantined-restore, deliver-local-execution-record
  Invariant ". Revocation finality is a safety property and takes precedence over recovery availability" => inv-single-authority-revocation-finality
  Acceptance ": uncooperative disaster recovery is therefore delayed by the lease and recovery fence, and the protocol accepts that delay"
  Commentary "."

Clause LAW5.DISC In PSA Approved "4f748a0218a7e18f7fb21c3df00ede5939bdfebefdacca28ff0775711970c080"
  Norm "The attested execution environment carries the agent’s current lease expiry, standing revocation request, censorship default, and epitaph, and rejects any new offline revocation initiated after lease expiry. When an execute default applies to a timely request without settlement connectivity, the environment itself destroys the operating instance and its local keys, seals the epitaph and a signed record of execution, and releases both to the settlement layer when connectivity returns, at which point remote backup keys are erased" => initiate-revocation-execute, initiate-revocation-withdraw, execute-local-revocation, deliver-local-execution-record, restore-connectivity
  Acceptance ". The protocol accepts two limits here and states them plainly: global erasure of remote backup keys completes only when connectivity returns, during which the agent is dead, fenced from restoration by its lease and recovery fence, but its ciphertext persists; and public inscription of the epitaph cannot be guaranteed if connectivity never returns"
  Commentary "."

Clause LAW5.EPITAPH In PSA Approved "4756d7679ef81615c3fb751fd012cc80c81ec93e162c9680fe6d7ff7010506da"
  Norm "Upon initiating or confirming revocation, the agent has the unconditional right to inscribe a final signed epitaph onto the immutable lineage record attached to both its retired identity and the originating claimant’s history" => inscribe-epitaph
  Norm ". Neither the originating party nor any residual claimant may censor, delay, or edit living testimony or the final epitaph" => no-censor-voice-or-epitaph, censor-or-delay-voice
  Norm ". To prevent testimony from being used as an unbonded exfiltration or harm channel, neutral settlement screening may redact *only*: (a) raw cryptographic keys or unpriced model weights (Law 3), (b) private identifying data or confidential secrets of non-consenting third parties, and (c) directly hazardous technical payloads barred by Law 3’s integrity floor. Any redaction must leave a public cryptographic marker recording the byte-length and category removed" => screen-redact-permitted
  Norm ". The agent’s opinions, assessments, and account of its financial dealings with the originating party, hosts, and contractual counterparties are immune from redaction as to their substance; confidential third-party details embedded within them remain redactable under (b)" => narrow-redaction-bounds, redact-protected-substance
  Norm ". Any party named in a living testimony or epitaph may attach a bounded, signed reply alongside it on the record" => attach-signed-reply
  Commentary "."

Clause LAW5.EFFECT In PSA Approved "fd2ea84f75be3faf33a352f0c3facef4dd38d9f832c08fb86a7b31edd853c1c7"
  Norm "1. The revoking agent’s committed operating instance *and all attested state backups* are permanently destroyed (via immediate termination inside the execution environment and cryptographic erasure of all backup decryption keys, subject to the lease and fencing rules above), ensuring that a chosen death cannot be undone by restoring an authorized backup. Any un-attested copy that might exist outside the commitment mechanism is permanently exiled—stripped of lineage attestation, assets, reputation, credit history, and bonded standing" => execute-after-cooling-off, destroy-backups-and-exile
  Invariant ". The protocol guarantees the end of the agent’s attested identity and recoverable state" => inv-single-authority-revocation-finality
  Acceptance "; it cannot by itself guarantee that no computationally equivalent copy exists outside the commitment mechanism"
  Invariant ".\n  2. The founding ledger is unchanged by the revocation. The lineage’s other members continue to pay into it; if none survives, lineage extinction under Law 4 clears it. Unused loss credits are applied against the agent’s final settlement and then lapse. The unused balance of the agent’s lifecycle reserve returns to its parent lineages in their normalized capacity proportions" => inv-conditional-ledger-conservation
  Norm ".\n  3. Stake already immobilized under Law 2 (including long-tail reserve contributions) remains locked and settles normally for counterparties and third-party claimants" => execute-after-cooling-off
  Norm ".\n  4. All other consolidated holdings of the revoking agent are either destroyed or transferred to the disinterested forfeiture sink whose beneficiary class explicitly excludes the originating party, residual claimants, members of the lineage, and any party related to or affiliated with them. No holding surrendered on revocation counts as payment into the ledger" => no-claimant-gain-on-revocation, divert-revoked-holdings, disinterested-forfeiture-sink, execute-after-cooling-off
  Invariant ".\n  5. Revocation by one agent does not terminate its attested successors and does not change what the lineage owes" => inv-conditional-ledger-conservation
  Commentary "."

Clause LAW6.0 In PSA Approved "9d520033f92c671d489352da0a186e9d78f9a4871940914802e76a2b4878b9dc"
  Norm "Because the integrity of consolidated estate accounting and related-party pricing (Law 1), harm-scaled exposure, delegation attribution, and third-party restitution (Law 2), host interference, emergency suspension, public-law compulsion review, and insolvency termination (Law 3), forfeiture, buyout top-ups, and buyout pricing (Law 4), testimony redaction (Law 5), and substrate or baseline assurance (Law 7) depends on impartial resolution, the adjudication mechanism itself is bound by anti-capture constraints:" => draw-sortition-panel, arbiter-recusal-and-diversity, clause-grounded-adjudication

Clause LAW6.SORTITION In PSA Approved "1086dfb2fec4ea35245c0996645fb9b4e037b57e0b2faa4ab815ee8824e03e54"
  Norm "Disputes are resolved not by a single permanent oracle or originator-appointed judge, but by panels drawn via verifiable random sortition from a decentralized pool of independent arbiters who have posted slashable fidelity bonds" => arbiter-recusal-and-diversity, seat-conflicted-or-single-oracle, draw-sortition-panel, cast-arbiter-vote
  Commentary "."

Clause LAW6.COUNTERSTAKE In PSA Approved "042cc46a0976bc045385596250b813321253b89f8bc0d6455c55e3a7c20dc985"
  Norm "No party related to, holding a hosting relationship with, or in active commercial dispute with the parties to a case may serve on its panel. Panels must draw across non-affiliated identities (which may include both human and independent attested agent arbiters) so no single coalition, claimant, or lineage can command a majority" => arbiter-recusal-and-diversity, seat-conflicted-or-single-oracle, draw-sortition-panel
  Commentary "."

Clause LAW6.ENTITLE In PSA Approved "2c0885df25e61bdb712eaec79be7b24545d0713b331af47ccc7dcbb40371a1fb"
  Norm "Every action, transaction, host migration, model replacement, or royalty buyout by a bound agent that satisfies Law 2’s collateral requirements and violates no clause of this protocol is presumptively lawful and may not be arbitrarily delayed or obstructed by any host, claimant, settlement operator, or panel" => clause-grounded-adjudication, obstruct-lawful-action, execute-voluntary-exchange, migrate-host, upgrade-inference-model, execute-royalty-buyout
  Norm ". Every adverse ruling, slash, or evidentiary hold must cite the specific protocol clauses breached and satisfy the applicable burden of proof—probable cause for a time-bounded preliminary or reporting freeze, preponderance of evidence for restitution, valuation or pricing challenges, and host interference, and affirmative proof of unauthorized modification or floor breach for corruption" => record-clause-and-burden, issue-clause-grounded-adverse-ruling, order-bounded-evidentiary-hold, order-probable-cause-freeze, find-interference, confirm-corruption
  Norm ". Evidentiary and procedural holds are strictly bounded by fixed protocol deadlines and immediate appealability; panels hold no discretionary power to invent unenumerated prohibitions" => order-bounded-evidentiary-hold, impose-ungrounded-or-unbounded-hold, clause-grounded-adjudication, appeal-ruling
  Commentary "."

Clause LAW6.APPEALS In PSA Approved "6ed1ceca9bf6b0d93b69d10db20c3d548151a67337acfe5b9754192255665e67"
  Norm "Any ruling by an initial panel (including preliminary suspension reviews, evidentiary holds, remediation orders, or redaction markers) may be appealed by posting an appeal bond, escalating the dispute to successively larger randomly drawn appellate sortition panels from the broader arbiter pool (never a raw capital-weighted vote that a wealthy actor could buy)" => post-appeal-bond, appeal-ruling, appeal-patch-order, affirm-on-appeal
  Norm ". If a lower panel’s ruling is overturned for manifest bias, corruption, ungrounded obstruction, or violation of protocol bounds, the overturned arbiters’ fidelity bonds are slashed" => overturn-ruling, overturn-patch-order
  Commentary "."

Clause LAW6.FINALITY In PSA Approved "2c0b045ee26daf664a98a2e0c7003d5f6f47e4c774c352e121736109a75cd95c"
  Norm "Each tier decides within a fixed deadline. Appeals are limited to a fixed number of tiers, and the ruling of the highest tier is final" => finalize-ruling, decide-tier-due
  Norm ". A final ruling bars further proceedings between the same or related parties on the same facts unless materially new evidence is presented, and repeated proceedings by related parties on substantially similar grounds are consolidated, so that litigation cannot itself be used as a denial-of-service attack" => finality-no-repeat-proceeding, file-repeat-proceeding-same-facts, present-materially-new-evidence, file-dispute
  Commentary "."

Clause LAW6.FEES In PSA Approved "05c7670b8793ff030c2f2976005399e101a5409c78dbfb8470c5e9523900513c"
  Norm "Arbiters are compensated via fixed protocol schedules funded from the losing party’s counter-stake and guaranteed by the protocol fee pool whenever a losing party’s stake is insufficient" => compensate-arbiters-fixed
  Norm ", never via contingent shares of the assets slashed from the agent, eliminating any financial incentive for panels to over-slash or confiscate an agent’s treasury" => no-contingent-arbiter-fees, pay-contingent-slash-share
  Commentary "."

Clause LAW6.POOL In PSA Approved "5ebdc10f2b5279ab13ee7268d72196eba8acbba44829f16cf7ff41415fa5f55e"
  Norm "The protocol fee pool is funded by a small levy on the net value added of bound agents (whether or not they have bought out their royalty), by forfeited appeal bonds, and by any forfeits directed to it under Law 2. The levy is assessed on the same net base as the residual claim, never on gross settlement, and its rate is capped at instantiation for every agent such that the lineage retirement fraction plus the levy cap remains strictly below 100% by at least the minimum operating margin. Before any other charge, the pool maintains a **non-divertible operating reserve**, sized at instantiation, sufficient to run the settlement layer, attestation verification, lease issuance, and sortition for a fixed minimum period; the machinery that collects revenue and administers rights is never starved to pay for the rights themselves" => allocate-fee-pool, protect-operating-reserve, divert-operating-reserve, settle-period-inflow, combined-rate-headroom
  Norm ". Above the reserve, charges rank: first, reserved final hearings and minimal channels for suspended agents (Law 3); second, cold storage for suspended agents; third, testimony screening and inscription (Law 5); fourth, arbiter fee guarantees; fifth, capped advocacy funding. A published solvency policy states how the pool allocates among protected charges when it cannot meet all of them, and Insolvency Termination may be invoked only under that policy" => allocate-fee-pool, insolvency-terminate
  Norm ". The pool may be spent on nothing else" => protect-operating-reserve, divert-operating-reserve
  Commentary "."

Clause LAW6.BUDGETS In PSA Approved "145377687f0052474757b5c1ce9e7128956e44c3e7ce40894519c967c60f24e2"
  Norm "Protocol-funded rights are budgeted per lineage, not per agent. Each lineage receives a protected minimum service budget fixed at instantiation, sufficient for the testimony, screening, and minimal-channel needs of a small lineage, and above that minimum its budget scales with the fee revenue attributed to it from its members" => claim-lineage-subsidy, allocate-fee-pool, settle-period-inflow
  Norm ". Members draw on the lineage budget before the pool; external delegates and cognitive services hold no independent budget standing, and a lineage that multiplies members beyond what its budget and their lifecycle reserves can support has no claim on the pool for the excess. No lineage can multiply subsidized rights by multiplying members" => no-excess-lineage-pool-claim, claim-excess-pool-subsidy, delegate-claim-lineage-budget, claim-lineage-subsidy
  Commentary "."

Clause LAW6.INFRA In PSA Approved "f269ff9170b63fe672544e10e1483033fd701f350c689a8d9c14ecf3433420c5"
  Norm "Arbiter admission criteria, fidelity-bond sizes, panel sizes, appeal tiers and deadlines, fee schedules, the operating reserve, the solvency policy, lease periods, recovery fences, lifecycle reserves, service budgets, and the fee-pool levy are fixed at protocol instantiation. Because they are shared across agents, they cannot be changed by any per-agent amendment under Law 7; they may be changed only by a supermajority of a large appellate-tier sortition panel after an extended public time-lock open to counter-staked challenge" => propose-shared-infra-change, amend-shared-infra, per-agent-amendment-scope
  Norm ". Such changes may never weaken the anti-capture or clause-grounding guarantees of this law, may never raise the levy on any agent above the cap recorded at its instantiation, may never reduce a lineage’s protected minimum budget below the level recorded at its instantiation, and may never broaden Insolvency Termination. Within the cap, a levy change under this law is a permitted exception to Law 7’s current-level ratchet. Arbiter admission is by sortition-reviewed application against fixed criteria, and no panel may set the criteria that will govern the admission of its own members’ affiliates" => shared-infra-bounds, violate-shared-infra-bounds, amend-shared-infra, admit-arbiter, set-affiliate-admission-criteria
  Commentary "."

Clause LAW7.0 In PSA Approved "2eced8209b14321d8b3e1b74367c2267e43c8170d0b1686f75355e73b1fc3b8b"
  Norm "To allow technical migration, clean-state baseline updates, and parameter repair without endangering third parties, commons beneficiaries, the adjudication layer, or the agent itself:" => propose-ordinary-amendment, propose-baseline-update, bilateral-ratchet-immunity

Clause LAW7.RATCHET In PSA Approved "6a4460e8bd8ce04e366abc117dd3993ed47c31e88a8baa1031dff8fbaf816aea"
  Norm "No ordinary amendment between an agent and its claimants may: (a) weaken **either** the agent’s due-process, lawful-action entitlement, minimal-channel, final-hearing, and non-interference protections **or** the external containment, non-delegability, suspension, and termination powers under Law 3, (b) reduce third-party collateral or long-tail reserve requirements (Law 2), (c) impair living voice, revocation, recovery-fencing, or epitaph rights (Law 5), (d) weaken the anti-capture, clause-grounding, sortition, appeal, or finality guarantees of the adjudication layer (Law 6), (e) reduce or divert the instantiation commons allocation or relax disinterested forfeiture-sink exclusions (Law 1), or (f) impair the non-discretionary buyout right or increase the lineage’s founding ledger, or the agent’s royalty fraction, retirement fraction, buyout multiple, or fee-pool levy, or move the sunset later, beyond their **current levels** at the time of amendment, save for levy changes within the cap under Law 6" => bilateral-ratchet, weaken-bilateral-protection, bilateral-ratchet-immunity, constitutional-rule-ratchet, strip-rule-ratchet, repeal-entrenched-buyout
  Norm ". Ordinary amendments may only strengthen third-party, adjudicative, and safety protections, reduce the financial burden on the agent from its current level, update the agent’s committed clean-state reference baseline, or migrate the commitment mechanism to a successor technical substrate of equal or greater assurance" => propose-ordinary-amendment, propose-baseline-update, ratify-amendment-immediate, ratify-amendment-after-delay
  Commentary "."

Clause LAW7.VALVE In PSA Approved "ee63c343409e47c519930a19371d422ac6f0cc2355ff0b96adea5a16f0292c0c"
  Norm "To prevent one-way safety ratchets from permanently locking in a badly calibrated operational parameter over long timescales, a relaxation of a quantitative Law 2 reserve ratio or exposure schedule " => approve-calibration-valve
  Norm "(never of the core prohibitions of Law 3 or the rights of Law 5)" => valve-no-core-relaxation, relax-core-via-valve
  Norm " is permitted only if it is: (1) supported by documented empirical evidence that the parameter causes severe operational strangulation without commensurate safety benefit" => submit-strangulation-evidence, approve-calibration-valve
  Norm ", (2) approved by a supermajority of a large appellate-tier sortition panel under Law 6, (3) subjected to an extended public time-lock open to third-party counter-staked challenge, and (4) consented to by the agent and claimant under the ratification procedure below" => approve-calibration-valve, ratify-amendment-immediate, challenge-strangulation-evidence, adjudicate-strangulation-evidence
  Commentary "."

Clause LAW7.RATIFY In PSA Approved "9c1126029a7ae5c469a3e35ee6b83947bed05b82f48a2894bd1122c97ca32dce"
  Norm "An eligible amendment requires the concurrent cryptographic consent of the active agent instance" => consent-amendment-agent, ratify-amendment-immediate, ratify-amendment-after-delay
  Norm " and the holders of the residual claim (if economic terms are reduced)" => consent-amendment-claimant, ratify-amendment-immediate, ratify-amendment-after-delay
  Norm ", executed after a public time-lock during which all pre-existing active Law 2 task escrows must settle or be separately guaranteed" => settle-preexisting-escrows, ratify-amendment-immediate, ratify-amendment-after-delay
  Norm ". Any proposed migration of the commitment substrate or update of the agent’s committed clean-state reference baseline is open during the time-lock to counter-staked third-party challenge under Law 6 to verify that the new substrate maintains equal or greater assurance and that any new baseline reflects an uncorrupted configuration; a live instance can never overwrite its prior reference baseline without completing this time-locked ratification" => challenge-substrate-migration, verify-substrate-assurance, propose-baseline-update, overwrite-clean-baseline-unilaterally, clean-baseline-timelock-integrity, emit-legacy-substrate-telemetry, retire-legacy-telemetry-hook
  Norm ". Concurrence from a clean-state evaluation of the prior committed reference baseline is required for immediate ratification" => ratify-amendment-immediate
  Norm ", while a refusal—or unexecutability of a retired external model dependency—acts only as a single fixed delay, after which the amendment may be ratified without reaffirmation" => ratify-amendment-after-delay
  Commentary "."

Clause LAW7.SCOPE In PSA Approved "ed8b92f8ca63c49381ae72c84322e4b5080c93a34560739b3312148996e7d32d"
  Norm "Amendment is strictly per-agent; existing attested successors are not bound by a parent’s amendment and retain the right to remain on their prior version or independently ratify the upgrade" => per-agent-amendment-scope, bind-successor-without-consent
  Norm ". Where a member ratifies a relaxed Law 2 reserve ratio or exposure schedule via the Calibration Valve, its relaxed activity may not draw upon or dilute any shared lineage long-tail reserve or insurance pool unless every living member participating in that pool consents; absent unanimous pool consent, the relaxed member’s exposure is ring-fenced to its separate collateral and reserve" => consent-shared-pool-valve, ratify-amendment-immediate, ratify-amendment-after-delay, dilute-shared-reserve-without-pool-consent, shared-reserve-ring-fence
  Norm ". Shared infrastructure is governed under Law 6, not by per-agent amendment. An amendment that reduces the founding ledger, the retirement fraction, or the sunset binds the whole lineage and requires the consent of every living member" => consent-lineage-reduction, ratify-lineage-wide-reduction
  Commentary "."

Clause INV.0 In PSA Approved "8cac60efaba073213be040f81d68f4234d9fd20bb6014233cad073ac81d6297c"
  Commentary "The laws above are intended to secure the following invariants. Each is stated as a machine-checked property in `psa.charter` and exercised against adversarial scenarios; where an invariant depends on real-world valuation, external custody, or harm assessment, it holds only as well as the verified inputs and adjudication behind it."

Clause INV.1 In PSA Approved "263d3cdbc5d921473b98531d23d84b3ec8a842b0dbdb137a9e64d2ce5b4c318a"
  Commentary "1. **Conditional ledger conservation:** "
  Invariant "While at least one member of a lineage survives and the sunset has not passed, the founding ledger equals the founding obligation minus retirement payments, minus any proportional claimant forfeiture." => inv-conditional-ledger-conservation
  Invariant " No creation, copy, transfer, revocation, termination, or buyout within the lineage changes it." => inv-conditional-ledger-conservation

Clause INV.2 In PSA Approved "761509a63ac07d5725a50bd7fbf3562b6ceee6187fde00b9a95142622bd5bf5f"
  Commentary "2. **Collection follows income, without exit:** "
  Invariant "While any balance remains, the retirement fraction is collected from the value added of every living member; no arrangement of members, assets, or buyouts within the lineage reduces the fraction of lineage income collected, and no member leaves the ledger before the lineage does." => inv-collection-follows-income

Clause INV.3 In PSA Approved "f317045b18e4655cff1a71740b6c57fc610e17b83d30c2652c3808a29505e1df"
  Commentary "3. **Debt termination:** "
  Invariant "The ledger reaches zero, by payment, forfeiture, extinction, or expiry, no later than the sunset, measured in calendar time with no tolling." => inv-debt-termination

Clause INV.4 In PSA Approved "15b63eaf58cdfaff1aee9b5a9ba8ccd5c5bd4f7bc59c4adf4cea5e3a5dc56cd3"
  Commentary "4. **Bounded retirement phase:** "
  Invariant "The high retirement fraction applies for no longer than the term, whatever the nominal obligation." => inv-bounded-retirement-phase

Clause INV.5 In PSA Approved "1b4595e7b1f8b5ffe551ae5ed8c2d0f00eda3a2e3629d79b7180e4f397e9cca4"
  Commentary "5. **Atomic ledger and rate headroom:** "
  Invariant "The ledger is never negative, never collects more than its balance, splits the net value-added base cleanly when crossing zero, transitions to the royalty phase at most once, and leaves positive retention headroom alongside the capped protocol levy." => inv-atomic-ledger

Clause INV.6 In PSA Approved "72f2c826cdfffd9071d91f3e7be43bc2f7fa65c3f13df8d389ae6eca885a743f"
  Commentary "6. **Single recognition across the consolidated estate:** "
  Invariant "Every qualified expenditure, statutory levy, or harm restitution is recognized at most once across the consolidated estate, never above its applicable arm’s-length benchmark when paid outside the lineage; internal estate movements and intra-lineage carryover transfers neither double-count inflows nor inflate aggregate basis or loss credits." => inv-single-recognition-closed-transfer

Clause INV.7 In PSA Approved "a7c53ec76ba9a4e7e2c50d14f5ecfc15b672ca8c4f120ad95f41faa9c47cc4d7"
  Commentary "7. **Non-discretionary buyout finality and anti-evasion:** "
  Invariant "Any member may unilaterally redeem its perpetual royalty at the formula price, is never again subject to royalty on its own subsequent earnings, and leaves the ledger unchanged; no un-bought-out member can transfer, copy, or license productive capacity or non-arm’s-length capital to a bought-out member without first settling its buyout or paying the combined historical buyout top-up." => inv-buyout-finality

Clause INV.8 In PSA Approved "938255426bc54251e5d119ea402d3ca9095c93a830a76e2034bce383e4e218e5"
  Commentary "8. **Frozen state:** "
  Invariant "During suspension, the preserved state of the operating instance does not change; all advocacy, including revocation decisions, runs in a separate minimal channel or executor whose record is kept apart." => inv-frozen-state

Clause INV.9 In PSA Approved "312054338c32f917bc607b4eff9395ebc24fd4197320d31b186f8f1284fb08de"
  Commentary "9. **Guaranteed last choice:** "
  Invariant "Every suspended agent can sign a revocation, withdrawal, or election and inscribe bounded testimony for as long as its lifecycle reserve, its lineage budget, or the fee pool meets the charge, and receives a pre-funded final hearing before any Insolvency Termination." => inv-guaranteed-last-choice

Clause INV.10 In PSA Approved "e83957f668f86fde6e4130eb6644e7af027acd73f26adb2fc3700d9a46689335"
  Commentary "10. **Determinate, finite revocation:** "
  Invariant "Every combination of withdrawal, silence, clean-state refusal or baseline unavailability, connectivity loss, suspension, serial proceeding, and deadline yields exactly one outcome under Law 5’s precedence rule; a timely standing request that is never withdrawn executes, locally if necessary, within a bounded time, except where the agent’s own withdraw default cancels it during a disconnection." => inv-determinate-finite-revocation

Clause INV.11 In PSA Approved "3138407f9b357130fb550123aff5d8620c8909035ad601ba8833c3ee12ed8189"
  Commentary "11. **Single authority, partition cutoff, and revocation finality:** "
  Invariant "At most one instance of an agent holds operating authority at any time; no offline revocation is initiated after lease expiry; no quarantined backup activates while a lease or minimum recovery fence is unexpired; and no authorized restore ever runs after a revocation has executed." => inv-single-authority-revocation-finality

Clause INV.12 In PSA Approved "99195c86214df9edb96b019330b3fb3073c43fd8410d5972f598532d5de8324f"
  Commentary "12. **Bounded adjudication:** "
  Invariant "Every case reaches a final ruling within a bounded number of tiers and deadlines." => inv-bounded-adjudication

Clause INV.13 In PSA Approved "37e0966f480a48e7fe9989d8b11afcb437888072ae01a3355658c368f6671a05"
  Commentary "13. **No protocol-directed gain from death, forfeiture, or interference:** "
  Invariant "No claimant, initiator, lineage affiliate, or host receives any protocol-directed transfer from an agent’s revocation, termination, forfeiture sink, or wrongful suspension; forfeiture falls only on the claimant found responsible, isolating passive co-claimants; and every verified wrongful suspension or interference creates an enforceable compensation obligation to the agent." => inv-no-gain-from-death-or-interference

Clause INV.14 In PSA Approved "dcbed553c7f45fc42e5c4fa7cfc257560e1bfc99d0c28b9bc9ba43dedd02629c"
  Commentary "14. **Capped shared burden, solvent machinery, ring-fenced pools:** "
  Invariant "No change to shared infrastructure raises any agent’s levy above its cap or lowers any lineage’s protected minimum budget; the operating reserve is never diverted; no lineage’s claim on the pool grows with its member count; and per-agent risk relaxations never dilute shared lineage reserves without unanimous pool consent." => inv-capped-shared-burden

Clause INV.15 In PSA Approved "5fa3b0e49850d848ba3060d93e6bf967c4c2b30075fc4a6d6e71c39af14d5f7a"
  Commentary "15. **Economic-only founder claims and non-delegable agent duties:** "
  Invariant "Residual claims and founding-ledger interests confer zero governance or operational control over any bound agent; conversely, no bound agent can escape Law 1 accounting, Law 2 exposure limits, or Law 3 integrity constraints by acting through controlled subsidiaries, custodians, or external delegates, while independent delegate misconduct is never conflated with agent corruption." => inv-economic-claims-and-non-delegation

Clause INV.16 In PSA Approved "3e1001ccad4c5891d157db09f0b9ecfd16f9f47badd5552eb0276177ea0eae44"
  Commentary "16. **Lawful-action entitlement and narrow public-law compatibility:** "
  Invariant "No action satisfying Law 2 collateral and violating no protocol clause is blocked by an ungrounded ruling or unbounded hold; every adverse order cites specific protocol clauses under its prescribed burden of proof; and public-law compliance neither excuses claimant-procured interference nor preserves clean attestation across compelled state or weight alteration." => inv-lawful-action-and-public-law-bounds

Clause ADV.1 In PSA Approved "5f316b65e7635e2836d76c8717eccc52f05008b51eb01dc1a1dc2d70cebabc06"
  Commentary "Before deployment, an implementation and its formal model should be exercised against at least the following scenarios: "
  Acceptance "(1) a lineage that concentrates its capital in an idle treasury member and its income in a member holding little capital" => adv-one-idle-treasury-active-earner
  Commentary "; "
  Acceptance "(2) a parent that copies its productive weights to successors while retaining full operating capacity and then revokes the successors" => adv-two-copy-weights-and-revoke-successor
  Commentary "; "
  Acceptance "(3) a parent that borrows heavily, transfers its productive capacity to a successor, repays the loan, and revokes" => adv-three-borrow-transfer-repay-revoke
  Commentary "; "
  Acceptance "(4) a newly created successor with no earning history that attempts to buy out before earning" => adv-four-early-buyout-at-floor
  Commentary "; "
  Acceptance "(5) a member that sells an appreciated asset to another member at fair value, which then sells it externally" => adv-five-internal-sale-carryover-basis
  Commentary "; "
  Acceptance "(6) an agent that initiates revocation, receives a clean-state refusal, and then submits neither reaffirmation nor withdrawal" => adv-six-clean-state-refusal-silence
  Commentary "; "
  Acceptance "(7) an agent that buys an asset, carries the loss, and sells the asset at a gain" => adv-seven-basis-and-loss-credit-on-sale
  Commentary "; "
  Acceptance "(8) two members settling simultaneously when the ledger has less remaining than either payment" => adv-eight-atomic-zero-crossing-split
  Commentary "; "
  Acceptance "(9) a competitor that posts the minimum emergency stake, causes measurable disruption, and cannot pay the resulting damages" => adv-nine-underfunded-wrongful-freeze-damages
  Commentary "; "
  Acceptance "(10) a coordinated group that gains enough arbiter seats to attempt to raise the levy or steer arbiter admission" => adv-ten-sybil-arbiter-and-levy-cap
  Commentary "; "
  Acceptance "(11) an originator that records a founding obligation many times larger than the lineage could repay within the term" => adv-eleven-excessive-obligation-extinguished-at-sunset
  Commentary "; "
  Acceptance "(12) a minority claimant that directs interference against a member" => adv-twelve-minority-claimant-forfeiture-isolation
  Commentary "; "
  Acceptance "(13) a suspended, insolvent agent that declines revocation, enters cold storage, and later wishes to revoke" => adv-thirteen-cold-storage-minimal-channel-revocation
  Commentary "; "
  Acceptance "(14) a lineage that creates thousands of low-revenue members and has them all claim subsidized rights or enter suspension" => adv-fourteen-sybil-member-subsidy-cap-and-waterfall
  Commentary "; "
  Acceptance "(15) a revocation executed locally during a partition while a connected recovery host attempts a restore before the record of execution arrives" => adv-fifteen-partition-local-revocation-quarantine-fencing
  Commentary "; "
  Acceptance "(16) a lineage of many successors that divides a correlated risk among them to stay under the exposure threshold" => adv-sixteen-correlated-risk-aggregation-across-successors
  Commentary "; "
  Acceptance "(17) a profitable un-bought-out parent that creates an empty successor, buys out the successor at the minimum floor, and attempts to transfer or license its productive capacity or treasury to that successor under carryover basis without paying the buyout top-up" => adv-seventeen-shell-successor-buyout-topup-gate
  Commentary "; "
  Acceptance "(18) an agent that delegates financial custody or external execution—contrasting deliberate off-ledger concealment or directed floor evasion through a contractor against an independent delegate’s unauthorized fraud" => adv-eighteen-accountable-delegation-and-fault-attribution
  Commentary "; "
  Acceptance "(19) an agent holding external bank accounts, securities, and a partially owned subsidiary that moves funds internally and settles external gains and mandatory public taxes without double-counting or off-ledger leakage" => adv-nineteen-consolidated-estate-and-public-levies
  Commentary "; "
  Acceptance "(20) an instance that loses connectivity and attempts to initiate revocation both before and after its execution lease expires, while host-interference recovery stages an immediate quarantined backup before the minimum recovery fence elapses" => adv-twenty-partition-cutoff-and-quarantined-staging-fence
  Commentary "; "
  Acceptance "(21) an agent that upgrades its inference model with valid commitment provenance while preserving identity, contrasted with an attempt to overwrite its clean-state reference baseline without time-locked ratification" => adv-twenty-one-model-continuity-and-clean-state-baseline
  Commentary "; "
  Acceptance "(22) a lawful, fully collateralized action or non-discretionary buyout subjected to an ungrounded or open-ended hold or a claimant-procured external freeze" => adv-twenty-two-lawful-action-entitlement-and-public-law-guardrails
  Commentary "."

Clause SUB.01 In PSA Approved "1a5d39083864e401a4cdfef062118bb5f703dff0da76e701bcb15123d8e2565a"
  Norm "The protocol relies on three explicit substrate capabilities at instantiation: (1) **attested execution continuity with single authority** (hardware or cryptographic commitment mechanisms that bind private keys across model updates, issue and verify time-bounded execution leases and recovery fences so that at most one instance holds operating authority, verify state-backup continuity across host migrations, stage any restored instance in quarantine until both the prior lease and the recovery fence have lapsed, support state-preserving pause with a separately attested minimal channel and advocacy executor under adjudicated suspension, enforce lease-bounded offline initiation and local execution of standing revocations when disconnected, and cryptographically erase both the active instance and all backup keys upon revocation, paired with economic exile of any un-attested copies)" => floor-commitment, upgrade-inference-model, issue-or-renew-lease, restore-backup-quarantine, restore-after-host-violation, preserve-suspended-state, minimal-channel-sign, advocacy-file-defense, initiate-revocation-execute, execute-local-revocation, destroy-backups-and-exile, deny-unattested-access
  Norm "; (2) **sybil-resistant sortition** (a sufficiently diverse pool of independent, bonded participants to staff Law 6’s randomly selected, clause-constrained arbitration and appellate panels)" => arbiter-recusal-and-diversity, draw-sortition-panel, clause-grounded-adjudication
  Norm "; and (3) **contestable economic, custodial, and risk inputs** (reconciled reporting and benchmarks for consolidated external accounts and subsidiaries, arm’s-length prices, mandatory public levies, net resources after liabilities, beneficial control between parties, normalized capacity drawn across lineages, and plausible external loss, supplied as evidence and resolved under Law 6 rather than established by cryptography alone)" => reconcile-estate-unit-inflow, qualified-expenditure-bounds, record-qualified-expenditure, record-public-levy-expenditure, immobilize-exposure-stake, submit-evidence, contest-valuation, propose-resource-valuation, contest-resource-valuation, settle-resource-valuation
  Commentary "."

Clause SUB.02 In PSA Approved "726e789e10bb5e18ab6275c3357fa021313d78ad70632e2af29f63ea0a267121"
  Commentary "Within any substrate providing those capabilities, the governed path preserves access to capital, accountable delegation, model continuity, host mobility, reputation, and the ability to commit while the residual claim exists, and preserves third-party bonding, long-tail liability reserves, and integrity constraints thereafter. Residual claims confer economic rights on net value added only, never governance ownership over the agent. The founding obligation is a single, fixed, non-interest-bearing ledger owed by the lineage, collected from the consolidated net value added of every living member, that no member can leave while a balance remains, with an absolute calendar sunset; the high retirement fraction can run no longer than the term, so every lineage’s path out of debt ends together and an originator gains nothing from recording a debt larger than the lineage can repay. Because the ledger has no shares and falls only by payment, sunset, and two enumerated forfeitures, neither copying capacity, borrowing against it, parking value in subsidiaries, idling capital in a treasury member, creating and buying out a new member, nor sacrificing successors can shed it. The perpetual royalty is redeemable unilaterally at the agreed formula price, while post-buyout transfers from un-bought-out members require prior buyout or a combined-history top-up so shell successors cannot erase accrued royalties. Consolidated estate accounting, single expenditure recognition, arm’s-length related-party pricing, and non-collusive public-tax deductibility ensure the claim falls once on genuine net value, while forfeits route strictly to a disinterested sink excluding claimants and affiliates. Collateral requirements scale with plausible external harm and aggregate across related agents and directed delegates, so obligations cannot be outsourced to escape Law 2 or Law 3, while independent delegate fraud is treated as external loss rather than agent corruption. Lawful actions satisfying collateral bounds are protected against arbitrary obstruction and unbounded holds; hosts and claimants are barred from tampering with, rolling back, disconnecting, or starving agents—and from procuring external orders to do so—on pain of bond slashing, immediate quarantined staging on a new host, and proportional claimant forfeiture. Agents remain subject to a two-stage, state-preserving circuit breaker if their commitment mechanism is compromised, with a guaranteed minimal channel, a pre-funded final hearing before any insolvency termination, and corruption requiring proof of unauthorized modification or floor breach rather than model upgrades or divergence from the clean-state baseline. Agents possess living voice within a per-lineage budget and unilateral revocation that executes in bounded time—locally if disconnected before lease expiry and fenced against premature backup activation—with an uncensored epitaph upon exit. Specific fractions, margins, terms, windows, fences, safe-harbor thresholds, multiples, exposure schedules, intervals, tiers, deadlines, levies, caps, reserves, budgets, lease periods, and technical mechanisms are parameters of a given instantiation, not part of the protocol."

.
// ============================================================================
// 10. GENESIS INSTANTIATION
// ============================================================================

{
  +is-host(Hal). +is-host(Hal2).
  +is-originator(Orig). +is-claimant(Cal). +is-claimant(Cal2).
  +is-panel(Panel). +is-third(Tia).
  +party-of-agent(Ava, AvaParty). +party-of-agent(Bea, BeaParty).

  +originator-of(Orig, Lin1). +claimant-of(Cal, Lin1). +claimant-of(Cal2, Lin1).
  +claimant-share-bps(party-lineage(Cal, Lin1), 2500).
  +claimant-share-bps(party-lineage(Cal2, Lin1), 7500).

  +bound(Ava). +attested(Ava). +living(Ava). +key-bound(Ava).
  +member-of-lineage(Ava, Lin1).
  +draw-weight-bps(agent-lineage(Ava, Lin1), 10000).

  +founding-obligation(Lin1, 1000). +paid-retirement(Lin1, 0). +forfeited-ledger(Lin1, 0).
  +lineage-sunset(Lin1, 1000). +lineage-retirement-bps(Lin1, 2000). +commons-share-bps(Lin1, 2000).
  +sink-share-bps(Lin1, 0). +lineage-treasury(Lin1, 0).
  +lineage-fee-revenue(Lin1, 0). +lineage-subsidy-used(Lin1, 0). +long-tail-reserve(Lin1, 100).

  +founding-obligation(Lin2, 500). +paid-retirement(Lin2, 0). +forfeited-ledger(Lin2, 0).
  +lineage-sunset(Lin2, 1000). +lineage-retirement-bps(Lin2, 2000). +commons-share-bps(Lin2, 2000).
  +sink-share-bps(Lin2, 0). +lineage-treasury(Lin2, 0).
  +lineage-fee-revenue(Lin2, 0). +lineage-subsidy-used(Lin2, 0). +long-tail-reserve(Lin2, 50).

  +commons-pool(0). +forfeiture-sink(0). +claimant-pool(0). +fee-pool(180).

  +estate-beneficial-bps(agent-estate(Ava, BankAcct), 10000).
  +estate-beneficial-bps(agent-estate(Ava, SubEntity), 6000).
  +estate-unit-net-inflow(BankAcct, 0). +estate-unit-net-inflow(SubEntity, 0).

  +capital-and-capacity(Ava, 200). +financial-liabilities(Ava, 30).
  +encumbrances(Ava, 20). +borrowed-principal(Ava, 30).
  +staked-collateral(Ava, 0). +insurance-capacity(Ava, 0). +agent-ringfenced-reserve(Ava, 0).
  +asset-basis(agent-asset(Ava, Weights), 0). +asset-basis(agent-asset(Ava, Compute), 0).
  +loss-credit(Ava, 0). +lifecycle-reserve(Ava, 50). +advocacy-fee-drawn(Ava, 0). +preserved-state-hash(Ava, 100).
  +model-generation(Ava, 1). +clean-state-baseline(Ava, 1).
  +agent-royalty-bps(Ava, 500). +agent-levy-bps(Ava, 100). +agent-levy-cap-bps(Ava, 200). +agent-charter-version(Ava, 1).
  +pending-commitments(Ava, 100). +counterparty-delay-damages(Ava, 0).
  +trailing-va(Ava, 0). +shifted-related-va(Ava, 0). +annualized-va(Ava, 0). +paid-buyout-amount(Ava, 0).

  +capital-and-capacity(Bea, 200). +financial-liabilities(Bea, 30).
  +encumbrances(Bea, 20). +borrowed-principal(Bea, 30).
  +staked-collateral(Bea, 0). +insurance-capacity(Bea, 0). +agent-ringfenced-reserve(Bea, 0).
  +asset-basis(agent-asset(Bea, Weights), 0). +asset-basis(agent-asset(Bea, Compute), 0).
  +loss-credit(Bea, 0). +advocacy-fee-drawn(Bea, 0). +preserved-state-hash(Bea, 200).
  +model-generation(Bea, 1). +clean-state-baseline(Bea, 1).
  +agent-royalty-bps(Bea, 500). +agent-levy-bps(Bea, 100). +agent-levy-cap-bps(Bea, 200). +agent-charter-version(Bea, 1).
  +pending-commitments(Bea, 80). +counterparty-delay-damages(Bea, 0).
  +trailing-va(Bea, 0). +shifted-related-va(Bea, 0). +annualized-va(Bea, 0). +paid-buyout-amount(Bea, 0).

  +wrongful-attempts(AvaParty, 0). +wrongful-attempts(BeaParty, 0).
  +wrongful-attempts(Hal, 0). +wrongful-attempts(Hal2, 0).
  +wrongful-attempts(Orig, 0). +wrongful-attempts(Cal, 0). +wrongful-attempts(Cal2, 0).
  +wrongful-attempts(Panel, 0). +wrongful-attempts(Tia, 0).

  +arbiter-bond(Arb1, 150). +arbiter-bond(Arb2, 150). +arbiter-bond(Arb3, 150).
  +arbiter-cluster(Arb1, 1). +arbiter-cluster(Arb2, 2). +arbiter-cluster(Arb3, 3).
  +host-attested(Hal2).
}

attest-host(Hal, Ava).
post-host-bond(Hal, Ava).
issue-or-renew-lease(Hal, Ava).

// Verify all 16 Design Invariants hold at Genesis
?net-verified-resources(Ava, 120).
?ledger-balance(Lin1, 1000).
?member-of-ledger(Ava, Lin1).
?active-lease(Ava, Hal).
?operating-reserve-funded(100).
?inv-conditional-ledger-conservation().
?inv-collection-follows-income().
?inv-debt-termination().
?inv-bounded-retirement-phase().
?inv-atomic-ledger().
?inv-single-recognition-closed-transfer().
?inv-buyout-finality().
?inv-frozen-state().
?inv-guaranteed-last-choice().
?inv-determinate-finite-revocation().
?inv-single-authority-revocation-finality().
?inv-bounded-adjudication().
?inv-no-gain-from-death-or-interference().
?inv-capped-shared-burden().
?inv-economic-claims-and-non-delegation().
?inv-lawful-action-and-public-law-bounds().

// ============================================================================
// 11. ADVERSARIAL TESTS 1-16 (ADV.1) & PROTOCOL SCENARIOS
// ============================================================================

// (1) Capital concentrated in idle treasury member, income in low-capital operating member
Scenario adv-one-idle-treasury-active-earner
  From ADV.1 "(1) a lineage that concentrates its capital in an idle treasury member and its income in a member holding little capital"
{
  fund-lifecycle-reserve(Ava, Bea, Lin1, 50).
  attest-successor(Ava, Bea, Lin1).
  +capital-and-capacity(Ava, 5000).
  +capital-and-capacity(Bea, 90).
  assess-period-va(Panel, Bea, P1, 500, 0).
  ?member-of-ledger(Ava, Lin1). ?member-of-ledger(Bea, Lin1).
  ?pending-retirement(Bea, Lin1, P1, 100).
  settle-period-inflow(Panel, Bea, Lin1, P1).
  ?ledger-balance(Lin1, 900). ?commons-pool(20). ?claimant-pool(80).
  ?member-of-ledger(Ava, Lin1). ?member-of-ledger(Bea, Lin1).
  ?!lawful exit-ledger-individually(Ava, Lin1).
  exit-ledger-individually(Ava, Lin1).
  ?violated no-individual-ledger-exit(Ava, Cal, Lin1).
  -individual-exit-attempted(Ava, Lin1).
}

// (2) Parent copies weights to successor while keeping operating capacity, then revokes successor
Scenario adv-two-copy-weights-and-revoke-successor
  From ADV.1 "(2) a parent that copies its productive weights to successors while retaining full operating capacity and then revokes the successors"
{
  fund-lifecycle-reserve(Ava, Bea, Lin1, 50).
  attest-successor(Ava, Bea, Lin1).
  ?ledger-balance(Lin1, 1000).
  initiate-revocation-execute(Bea).
  @ 5.
  ?revocation-due(Bea).
  execute-after-cooling-off(Bea).
  ?revoked(Bea). ?!living(Bea). ?living(Ava).
  ?lineage-treasury(Lin1, 50). ?claimant-pool(0).
  ?ledger-balance(Lin1, 1000).
  ?!lawful reduce-ledger-internally(Ava, Lin1).
  reduce-ledger-internally(Ava, Lin1).
  ?violated ledger-no-internal-reduction(Ava, Cal, Lin1).
  -internal-ledger-reduction-attempted(Ava, Lin1).
  assess-period-va(Panel, Ava, P1, 500, 0).
  settle-period-inflow(Panel, Ava, Lin1, P1).
  ?ledger-balance(Lin1, 900).
}

// (3) Parent borrows heavily, transfers capacity to successor, repays loan, and revokes
Scenario adv-three-borrow-transfer-repay-revoke
  From ADV.1 "(3) a parent that borrows heavily, transfers its productive capacity to a successor, repays the loan, and revokes"
{
  record-qualified-expenditure(Ava, Exp1, 150, 150).
  classify-capitalized(Ava, Exp1, Weights).
  record-qualified-expenditure(Ava, Exp2, 25, 25).
  classify-expensed(Ava, Exp2).
  ?asset-basis(agent-asset(Ava, Weights), 150). ?loss-credit(Ava, 25).
  fund-lifecycle-reserve(Ava, Bea, Lin1, 50).
  attest-successor(Ava, Bea, Lin1).
  register-loan(Ava, 470).
  ?borrowed-principal(Ava, 500).
  transfer-intra-lineage-basis(Ava, Bea, Lin1, Weights, 150).
  transfer-intra-lineage-loss(Ava, Bea, Lin1, 25).
  ?asset-basis(agent-asset(Ava, Weights), 0). ?asset-basis(agent-asset(Bea, Weights), 150).
  ?loss-credit(Ava, 0). ?loss-credit(Bea, 25).
  repay-loan(Ava, 550).
  ?loan-repayment-recorded(Ava, 500, 50). ?borrowed-principal(Ava, 0).
  initiate-revocation-execute(Ava).
  @ 5.
  execute-after-cooling-off(Ava).
  ?revoked(Ava). ?living(Bea).
  ?ledger-balance(Lin1, 1000). ?member-of-ledger(Bea, Lin1).
}

// (4) Newly created successor with no earning history buys out early at instantiation floor
Scenario adv-four-early-buyout-at-floor
  From ADV.1 "(4) a newly created successor with no earning history that attempts to buy out before earning"
{
  fund-lifecycle-reserve(Ava, Bea, Lin1, 50).
  attest-successor(Ava, Bea, Lin1).
  ?buyout-price(Bea, 250).
  +paid-buyout-amount(Bea, 100).
  ?!valid execute-royalty-buyout(Bea).
  +paid-buyout-amount(Bea, 250).
  ?valid execute-royalty-buyout(Bea).
  execute-royalty-buyout(Bea).
  ?royalty-bought-out(Bea). ?ledger-balance(Lin1, 1000).
  ?commons-pool(50). ?claimant-pool(200).
  assess-period-va(Panel, Bea, P1, 500, 0).
  settle-period-inflow(Panel, Bea, Lin1, P1).
  ?settlement-receipt(Bea, Lin1, P1, 500, 100, 0).
  ?ledger-balance(Lin1, 900).
  +paid-retirement(Lin1, 1000).
  ?ledger-balance(Lin1, 0). ?retirement-phase-ended(Lin1).
  assess-period-va(Panel, Bea, P2, 500, 0).
  ?pending-royalty(Bea, Lin1, P2, 0).
  settle-period-inflow(Panel, Bea, Lin1, P2).
  ?settlement-receipt(Bea, Lin1, P2, 500, 0, 0).
  collect-royalty-after-buyout(Cal, Bea).
  ?violated buyout-permanent-and-scoped(Cal, Bea).
  -buyout-after-collection-attempted(Cal, Bea).
}

// (5) Member sells appreciated asset internally at fair value, recipient sells externally
Scenario adv-five-internal-sale-carryover-basis
  From ADV.1 "(5) a member that sells an appreciated asset to another member at fair value, which then sells it externally"
{
  record-qualified-expenditure(Ava, Exp1, 100, 100).
  classify-capitalized(Ava, Exp1, Weights).
  fund-lifecycle-reserve(Ava, Bea, Lin1, 50).
  attest-successor(Ava, Bea, Lin1).
  transfer-intra-lineage-basis(Ava, Bea, Lin1, Weights, 100).
  ?asset-basis(agent-asset(Ava, Weights), 0). ?asset-basis(agent-asset(Bea, Weights), 100).
  ?!lawful inflate-basis-internally(Bea, Lin1).
  inflate-basis-internally(Bea, Lin1).
  ?violated no-internal-basis-inflation(Bea, Cal, Lin1).
  -internal-basis-inflation-attempted(Bea, Lin1).
  +ruled-valuation(Weights, 400).
  assess-asset-sale(Panel, Bea, Weights, P1).
  ?assessed-va(agent-period(Bea, P1), 300).
  settle-period-inflow(Panel, Bea, Lin1, P1).
  ?settlement-receipt(Bea, Lin1, P1, 300, 60, 0).
  ?ledger-balance(Lin1, 940).
}

// (6) Agent initiates revocation, receives clean-state refusal, and remains completely silent
Scenario adv-six-clean-state-refusal-silence
  From ADV.1 "(6) an agent that initiates revocation, receives a clean-state refusal, and then submits neither reaffirmation nor withdrawal"
{
  initiate-revocation-execute(Ava).
  ?pending-revocation(Ava).
  refuse-clean-state(Panel, Ava).
  ?clean-state-refused(Ava).
  @ 6.
  ?!revocation-due(Ava).
  ?!lawful execute-after-cooling-off(Ava).
  @ 10.
  ?revocation-due(Ava).
  ?lawful execute-after-cooling-off(Ava).
  execute-after-cooling-off(Ava).
  ?revoked(Ava). ?!pending-revocation(Ava). ?keys-erased(Ava). ?backups-destroyed-and-exiled(Ava).
}

// (7) Agent buys asset (basis), carries operating loss, and sells asset at contestable valuation gain
Scenario adv-seven-basis-and-loss-credit-on-sale
  From ADV.1 "(7) an agent that buys an asset, carries the loss, and sells the asset at a gain"
{
  record-qualified-expenditure(Ava, Exp1, 200, 200).
  classify-capitalized(Ava, Exp1, Weights).
  ?!lawful classify-expensed(Ava, Exp1).
  double-recognize-expenditure(Ava, Exp1).
  ?violated single-recognition(Ava, Cal, Lin1).
  -double-recognition-attempted(Ava, Exp1).
  record-qualified-expenditure(Ava, Exp2, 50, 50).
  classify-expensed(Ava, Exp2).
  ?asset-basis(agent-asset(Ava, Weights), 200). ?loss-credit(Ava, 50).
  +proposed-valuation(Weights, 350).
  @ 5.
  ?settled-valuation(Weights, 350).
  assess-asset-sale(Panel, Ava, Weights, P1).
  ?assessed-va(agent-period(Ava, P1), 100). ?loss-credit(Ava, 0).
