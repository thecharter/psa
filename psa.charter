  ratify-amendment-immediate(Ava, Ava, Am2).
  ?agent-royalty-bps(Ava, 300). ?agent-royalty-bps(Bea, 500).
  ?agent-charter-version(Ava, 2). ?agent-charter-version(Bea, 1).

  // 3. Lineage-wide reduction (obligation 1000->800, retirement 2000->1800, sunset 1000->900) requires every living member's consent
  +lineage-reduction-proposed(Am3, Lin1, 800, 1800, 900).
