// Law 7 Bilateral Ratchet Immunity, Calibration Valve & Per-Agent Scope
Scenario law-seven-bilateral-ratchet-and-calibration-valve {
  // 1. Royalty hike (800 > 500 bps) is blocked by bilateral-ratchet-immunity
  propose-ordinary-amendment(Ava, Am1, 800).
  ?hikes-agent-burden(Am1). ?amendment-violates-ratchet(Am1).
  consent-amendment-agent(Ava, Am1).
  settle-preexisting-escrows(Panel, Am1).
  +amendment-clean-state-concurred(Am1).
  @ 10.
  ?!valid ratify-amendment-immediate(Ava, Ava, Am1).
  ratify-amendment-immediate(Ava, Ava, Am1).
  ?royalty-rate-bps(500).

  // 2. Lawful downward burden amendment (300 < 500 bps) with claimant consent & per-agent scope
  +lifecycle-reserve(Bea, 50).
  attest-successor(Ava, Bea, Lin1).
  propose-ordinary-amendment(Ava, Am2, 300).
  ?economic-terms-reduced(Am2). ?!amendment-violates-ratchet(Am2).
  consent-amendment-agent(Ava, Am2).
  consent-amendment-claimant(Cal, Am2, Lin1).
  settle-preexisting-escrows(Panel, Am2).
  +amendment-clean-state-concurred(Am2).
  @ 20.
  ?valid ratify-amendment-immediate(Ava, Ava, Am2).
  ratify-amendment-immediate(Ava, Ava, Am2).
  ?royalty-rate-bps(300). ?agent-charter-version(Ava, 2). ?agent-charter-version(Bea, 1).

  // 3. Lineage-wide founding obligation reduction requires every living member's consent
  +lineage-reduction-proposed(Am3, Lin1, 800).
  consent-lineage-reduction(Ava, Am3).
  ?!valid ratify-lineage-wide-reduction(Cal, Lin1, Am3).
  consent-lineage-reduction(Bea, Am3).
  ?valid ratify-lineage-wide-reduction(Cal, Lin1, Am3).
  ratify-lineage-wide-reduction(Cal, Lin1, Am3).
  ?founding-obligation(Lin1, 800). ?ledger-balance(Lin1, 800).
}



