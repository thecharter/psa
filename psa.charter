  draw-sortition-panel(Panel, Disp1).
  cast-arbiter-vote(Arb1, Disp1). cast-arbiter-vote(Arb2, Disp1).
  ?undetermined approve-calibration-valve(Panel, AmValve, Disp1).
  adjudicate-strangulation-evidence(Panel, AmValve, Disp1) Note "sortition panel resolves conflicted evidence under preponderance".
  ?Established(strangulation-evidence-submitted(AmValve)).
  ?valid approve-calibration-valve(Panel, AmValve, Disp1).
  approve-calibration-valve(Panel, AmValve, Disp1).
  consent-amendment-agent(Ava, AmValve).
  consent-amendment-claimant(Cal, AmValve, Lin1).
  consent-shared-pool-valve(Ava, AmValve).
  settle-preexisting-escrows(Panel, AmValve).
  +amendment-clean-state-concurred(AmValve).
  @ 40.
  ?valid ratify-amendment-immediate(Ava, Ava, AmValve).
  ratify-amendment-immediate(Ava, Ava, AmValve).
  ?reserve-ratio-bps(600). ?ring-fenced-reserve(Ava). ?!ring-fenced-reserve(Bea).
  +proposed-task-loss(Task1, Ava, 50).
  immobilize-exposure-stake(Ava, Lin1, Task1).
  ?long-tail-reserve(Lin1, 100). ?agent-ringfenced-reserve(Ava, 3).

  // 5. Rule-level Amend & reflexive constitutional ratchet: entrenched powers resist two-step repeal while verified substrate hook retires cleanly
  ?!valid strip-rule-ratchet(Panel).
  strip-rule-ratchet(Panel).
  ?!valid repeal-entrenched-buyout(Panel).
  repeal-entrenched-buyout(Panel).
  ?valid emit-legacy-substrate-telemetry(Ava).
  +substrate-migration-proposed(AmValve, 2).
  challenge-substrate-migration(Tia, AmValve).
  ?Refuted(substrate-assurance-verified(AmValve)).
  verify-substrate-assurance(Panel, AmValve).
  ?Established(substrate-assurance-verified(AmValve)).
  ?valid retire-legacy-telemetry-hook(Panel, AmValve).
  retire-legacy-telemetry-hook(Panel, AmValve) Note "retire legacy telemetry hook across LawVersion transition".
  ?!valid emit-legacy-substrate-telemetry(Ava).
}

